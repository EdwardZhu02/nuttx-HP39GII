 {
-  FAR struct mtd_dev_s *mtd;
-  static uint32_t pagebuf[2048 / 4];
-  char rdbuf[64];
-  int fd;
-  int ret;
+  static const char hex[] = "0123456789abcdef";
+  char line[64];
   int i;
+  int k = 0;
 
