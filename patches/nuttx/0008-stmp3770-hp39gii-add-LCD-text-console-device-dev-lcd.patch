+
+/* text framebuffer: 1 byte per pixel, 0x00 = dark/on */
+static uint8_t g_fb[W * H];
+static int g_curx;
+static int g_cury;
+
+/* 把 g_fb 里的一块区域逐行刷到面板（portDispFlushAreaBuf 一次只吃一行
+ * 连续字节）。x/y 都是面板可见区坐标（0..255 / 0..127）。
+ */
+static void lcd_flush_region(uint32_t x0, uint32_t y0,
+                             uint32_t x1, uint32_t y1)
+{
+  uint32_t y;
+
+  for (y = y0; y <= y1; y++)
+    {
+      portDispFlushAreaBuf(x0, y, x1, y, g_fb + y * W + x0);
+    }
+}
+
+void stmp3770_lcdcon_clear(void)
+{
+  memset(g_fb, 0xff, sizeof(g_fb));
+  g_curx = 0;
+  g_cury = 0;
+  lcd_flush_region(0, 0, W - 1, H - 1);
+}
+
+static void lcdcon_scroll(void)
+{
+  memmove(g_fb, g_fb + 8 * W, (H - 8) * W);
+  memset(g_fb + (H - 8) * W, 0xff, 8 * W);
+}
+
+static void lcdcon_newline(void)
+{
+  g_curx = 0;
+  if (++g_cury >= ROWS)
+    {
+      g_cury = ROWS - 1;
+      lcdcon_scroll();
+    }
+}
+
+static void lcdcon_draw_char(int ch)
+{
+  const uint8_t *glyph;
+  int x0 = g_curx * 8;
+  int y0 = g_cury * 8;
+  int r;
+  int c;
+
+  if (ch < 32 || ch > 126)
+    {
+      ch = 32;
+    }
+
+  glyph = g_font[ch - 32];
+  for (r = 0; r < 8; r++)
+    {
+      uint8_t bits = glyph[r];
+      for (c = 0; c < 8; c++)
+        {
+          g_fb[(y0 + r) * W + (x0 + c)] =
+              (bits & (0x80 >> c)) ? 0x00 : 0xff;
+        }
+    }
+
+  lcd_flush_region(x0, y0, x0 + 7, y0 + 7);
+}
+
+void stmp3770_lcdcon_putc(int ch)
+{
+  if (ch == '\n')
+    {
+      lcdcon_newline();
+      return;
+    }
+
+  if (ch == '\r')
+    {
+      g_curx = 0;
+      return;
+    }
+
+  if (ch == 0x08)  /* backspace */
+    {
+      if (g_curx > 0)
+        {
+          g_curx--;
+        }
+      return;
+    }
+
+  lcdcon_draw_char(ch);
+  if (++g_curx >= COLS)
+    {
+      lcdcon_newline();
+    }
+}
+
+void stmp3770_lcdcon_puts(FAR const char *s)
+{
+  while (*s)
+    {
+      stmp3770_lcdcon_putc(*s++);
+    }
+}
+
+/* 字符设备封装：把 /dev/lcdcon 的 write() 接到文本控制台。 */
+
+static ssize_t lcdcon_write(FAR struct file *filep,
+                            FAR const char *buffer, size_t buflen)
+{
+  size_t i;
+
+  for (i = 0; i < buflen; i++)
+    {
+      stmp3770_lcdcon_putc(buffer[i]);
+    }
+
+  return (ssize_t)buflen;
+}
+
+static const struct file_operations g_lcdcon_fops =
+{
+  .write = lcdcon_write,
+};
+
+int stmp3770_lcdcon_initialize(void)
+{
+  stmp3770_lcdcon_clear();
+  return register_driver("/dev/lcdcon", &g_lcdcon_fops, 0666, NULL);
+}
