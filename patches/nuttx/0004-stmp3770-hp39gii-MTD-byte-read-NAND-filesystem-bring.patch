-  portMTDReadPage(6400, (uint8_t *)pagebuf);
+  write(fd, "hello-from-nand\n", 16);
+  close(fd);
 
-  hp39gii_puts("[NAND] page6400:");
-  for (i = 0; i < 32; i++)
