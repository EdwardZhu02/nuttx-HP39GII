+      hp39gii_printf("[FS] mount failed: %d\n", ret);
+      return ret;
+    }
 
-  hp39gii_puts("[NAND] write page 6400 (0x5a)\n");
-  memset(pagebuf, 0x5a, sizeof(pagebuf));
-  portMTDWritePage(6400, (uint8_t *)pagebuf);
+  fd = open("/data/hello.txt", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd < 0)
+    {
