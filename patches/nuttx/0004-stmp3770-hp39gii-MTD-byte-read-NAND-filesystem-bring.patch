From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: edwardzhu02 <explodingtnt@foxmail.com>
Date: Sun, 1 Nov 2026 16:38:37 +0800
Subject: [PATCH] stmp3770/hp39gii: MTD byte-read + NAND filesystem bring-up

- Add byte-oriented read() to the GPMI MTD adapter (SmartFS/LittleFS read
  small sector headers through MTD_READ)
- NAND smoke test now mounts through the MTD device and, when
  CONFIG_FS_SMARTFS is enabled, exercises SmartFS (mount + file write/read)
- defconfig enables CONFIG_STMP3770_NAND
- enlarge the NAND test thread stack (SmartFS scan needs more than 2KB)

Known issue: SmartFS smart_scan() on the 128MB NAND corrupts memory and
data-aborts in stmp3770_kbd_scan (PC 0x26abc). Raw GPMI read/write/erase
and the MTD bread path are verified; the filesystem layer needs further
debugging.
---
 arch/arm/src/stmp3770/stmp3770_mtd.c          | 30 +++++++
 .../stmp3770/hp39gii/configs/nsh/defconfig    |  1 +
 .../arm/stmp3770/hp39gii/src/hp39gii_boot.c   | 89 +++++++++++--------
 3 files changed, 82 insertions(+), 38 deletions(-)

diff --git a/arch/arm/src/stmp3770/stmp3770_mtd.c b/arch/arm/src/stmp3770/stmp3770_mtd.c
index b11960af..44fdde57 100644
--- a/arch/arm/src/stmp3770/stmp3770_mtd.c
+++ b/arch/arm/src/stmp3770/stmp3770_mtd.c
@@ -74,6 +74,35 @@ static ssize_t stmp3770_mtd_bwrite(FAR struct mtd_dev_s *dev,
   return (ssize_t)(nblocks * priv->info.PageSize_B);
 }
 
+static ssize_t stmp3770_mtd_read(FAR struct mtd_dev_s *dev,
+                                    off_t offset, size_t nbytes,
+                                    FAR uint8_t *buffer)
+{
+  FAR struct stmp3770_mtd_dev_s *priv =
+      (FAR struct stmp3770_mtd_dev_s *)dev;
+  static uint32_t pagebuf[2048 / 4];
+  uint32_t pagesize = priv->info.PageSize_B;
+  size_t done = 0;
+
+  while (done < nbytes)
+    {
+      uint32_t page = (uint32_t)((offset + done) / pagesize);
+      uint32_t off  = (uint32_t)((offset + done) % pagesize);
+      size_t chunk  = pagesize - off;
+
+      if (chunk > nbytes - done)
+        {
+          chunk = nbytes - done;
+        }
+
+      portMTDReadPage(page, (uint8_t *)pagebuf);
+      memcpy(buffer + done, (uint8_t *)pagebuf + off, chunk);
+      done += chunk;
+    }
+
+  return (ssize_t)done;
+}
+
 static int stmp3770_mtd_ioctl(FAR struct mtd_dev_s *dev, int cmd,
                               unsigned long arg)
 {
@@ -131,6 +160,7 @@ FAR struct mtd_dev_s *stmp3770_nand_initialize(void)
   priv->mtd.erase  = stmp3770_mtd_erase;
   priv->mtd.bread  = stmp3770_mtd_bread;
   priv->mtd.bwrite = stmp3770_mtd_bwrite;
+  priv->mtd.read   = stmp3770_mtd_read;
   priv->mtd.ioctl  = stmp3770_mtd_ioctl;
 
   priv->mtd.name = "stmp3770-nand";
