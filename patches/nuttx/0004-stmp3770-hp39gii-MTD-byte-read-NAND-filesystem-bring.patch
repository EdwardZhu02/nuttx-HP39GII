   return 0;
@@ -226,7 +239,7 @@ void board_late_initialize(void)
 #ifdef CONFIG_STMP3770_NAND
   {
     int ret = kthread_create("nandtest", SCHED_PRIORITY_DEFAULT - 10,
-                             2048, hp39gii_nand_thread, NULL);
+                             8192, hp39gii_nand_thread, NULL);
     if (ret < 0)
       {
         hp39gii_printf("[NAND] kthread_create failed: %d\n", ret);
