diff --git a/arch/arm/src/stmp3770/Kconfig b/arch/arm/src/stmp3770/Kconfig
index 2be83519..9dab7e9d 100644
--- a/arch/arm/src/stmp3770/Kconfig
+++ b/arch/arm/src/stmp3770/Kconfig
@@ -42,6 +42,13 @@ config STMP3770_LCD_INIT
 		启动时初始化 256x127 单色面板（8080/DBI 8-bit，经 APBH DMA）。
 		本板没有外露串口，面板是唯一的可见输出，所以这是 bring-up 的关键一步。
 
+config STMP3770_NAND
+	bool "GPMI NAND flash driver"
+	default n
+	---help---
+		GPMI + ECC8 (BCH) NAND 控制器驱动（从 ExistOS stmp_gpmi.c 移植）。
+		页 2048 B / 元数据 64 B / 每块 64 页 / 1024 块（128 MB）。
+
 config STMP3770_KBD
 	bool "Keyboard matrix"
 	default n
diff --git a/arch/arm/src/stmp3770/Make.defs b/arch/arm/src/stmp3770/Make.defs
index 31f33ee9..fc5ba2d6 100644
--- a/arch/arm/src/stmp3770/Make.defs
+++ b/arch/arm/src/stmp3770/Make.defs
@@ -29,3 +29,7 @@ endif
 ifeq ($(CONFIG_STMP3770_KBD),y)
 CHIP_CSRCS += stmp3770_kbd.c
 endif
+
+ifeq ($(CONFIG_STMP3770_NAND),y)
+CHIP_CSRCS += stmp3770_gpmi.c
+endif
