+static void GPMI_EnableDMAChannel(bool enable)
+{
+    if(enable){
+        BF_CLRV(APBH_CTRL0, CLKGATE_CHANNEL, 0x10);
+    }else{
+        BF_SETV(APBH_CTRL0, CLKGATE_CHANNEL, 0x10);
+    }
