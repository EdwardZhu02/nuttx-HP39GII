+#include "mtd_up.h"
+
+/* NAND 冒烟测试：初始化 GPMI+ECC8，读 page 0 和 page 1984（System 区），
+ * 打印前 32 字节。放在低优先级线程里，避免 GPMI 的轮询等待饿死 NSH。
+ */
+
+static int hp39gii_nand_thread(int argc, char **argv)
+{
+  static uint32_t pagebuf[2048 / 4];
+  mtdInfo_t info;
+  int i;
+
+  sleep(5);
+
+  hp39gii_puts("[NAND] interface init\n");
+  portMTDInterfaceInit();
+
+  hp39gii_puts("[NAND] device init\n");
+  portMTDDeviceInit(&info);
+
+  hp39gii_printf("[NAND] page=%lu spare=%lu pages/blk=%lu blocks=%lu\n",
+                 info.PageSize_B, info.SpareSizePerPage_B,
+                 info.PagesPerBlock, info.Blocks);
+
+  hp39gii_puts("[NAND] read page 0\n");
+  memset(pagebuf, 0, sizeof(pagebuf));
+  portMTDReadPage(0, (uint8_t *)pagebuf);
+
+  hp39gii_puts("[NAND] page0:");
+  for (i = 0; i < 32; i++)
+    {
+      hp39gii_printf("%02x", ((uint8_t *)pagebuf)[i]);
+    }
+  hp39gii_puts("\n");
+
+  hp39gii_puts("[NAND] read page 1984\n");
+  memset(pagebuf, 0, sizeof(pagebuf));
+  portMTDReadPage(1984, (uint8_t *)pagebuf);
+
+  hp39gii_puts("[NAND] page1984:");
+  for (i = 0; i < 32; i++)
+    {
+      hp39gii_printf("%02x", ((uint8_t *)pagebuf)[i]);
+    }
+  hp39gii_puts("\n");
+
+  /* 写 + 擦 冒烟测试：用块 100（page 6400，远离镜像数据区）。 */
+
+  hp39gii_puts("[NAND] erase block 100\n");
+  portMTDEraseBlock(100);
+
+  hp39gii_puts("[NAND] write page 6400 (0x5a)\n");
+  memset(pagebuf, 0x5a, sizeof(pagebuf));
+  portMTDWritePage(6400, (uint8_t *)pagebuf);
+
+  hp39gii_puts("[NAND] read back page 6400\n");
+  memset(pagebuf, 0, sizeof(pagebuf));
+  portMTDReadPage(6400, (uint8_t *)pagebuf);
+
+  hp39gii_puts("[NAND] page6400:");
+  for (i = 0; i < 32; i++)
+    {
+      hp39gii_printf("%02x", ((uint8_t *)pagebuf)[i]);
+    }
+  hp39gii_puts("\n");
+
+  hp39gii_puts("[NAND] ok\n");
+  return 0;
+}
+
+#endif /* CONFIG_STMP3770_NAND */
