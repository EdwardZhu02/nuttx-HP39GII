diff --git a/boards/arm/stmp3770/hp39gii/src/hp39gii_fillpage.c b/boards/arm/stmp3770/hp39gii/src/hp39gii_fillpage.c
new file mode 100644
index 00000000..67d1f9d2
--- /dev/null
+++ b/boards/arm/stmp3770/hp39gii/src/hp39gii_fillpage.c
@@ -0,0 +1,99 @@
+/****************************************************************************
+ * boards/arm/stmp3770/hp39gii/src/hp39gii_fillpage.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * On-demand paging backend: fill a faulted text page from NAND.
+ *
+ * The paged window is PG_PAGED_VBASE .. PG_PAGED_VEND (3.5 MB, see
+ * stmp3770_memorymap.h).  Page N of the window is backed by record N of a
+ * blob on NAND, so the whole window is 896 contiguous 4 KB records.  Nothing
+ * is written back: the window only ever holds executable text.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stddef.h>
+#include <errno.h>
+#include <debug.h>
+
+#include <nuttx/mtd/mtd.h>
+#include <nuttx/page.h>
+#include <nuttx/sched.h>
+
+#include "chip.h"
+#include "pg_macros.h"
+
+#ifdef CONFIG_LEGACY_PAGING
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* Where the paged blob lives on NAND.  Blocks 5..32 are inside the region the
+ * stock firmware used; keep a nanddump before enabling this on a real unit.
+ */
+
+#define HP39GII_PAGE_BLOB_BLOCK   5
+#define HP39GII_PAGE_BLOB_PAGES   64          /* erase block = 64 x 2 KB */
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static FAR struct mtd_dev_s *g_pagemtd;
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void hp39gii_paging_setmtd(FAR struct mtd_dev_s *mtd)
+{
+  g_pagemtd = mtd;
+}
+
+/****************************************************************************
+ * Name: up_fillpage
+ *
+ * Description:
+ *   Copy one page of the paged text window in from NAND.  Called by the page
+ *   fill worker from task context.
+ *
+ ****************************************************************************/
+
+int up_fillpage(FAR struct tcb_s *tcb, FAR void *vpage)
+{
+  off_t offset;
+  ssize_t nread;
+
+  DEBUGASSERT(tcb != NULL && vpage != NULL);
+  DEBUGASSERT(tcb->xcp.far >= PG_PAGED_VBASE &&
+              tcb->xcp.far < PG_PAGED_VEND);
+
+  if (g_pagemtd == NULL)
+    {
+      _err("no MTD for paging\n");
+      return -ENODEV;
+    }
+
+  offset = ((off_t)HP39GII_PAGE_BLOB_BLOCK * HP39GII_PAGE_BLOB_PAGES * 2048) +
+           (off_t)(tcb->xcp.far - PG_PAGED_VBASE);
+
+  nread = MTD_READ(g_pagemtd, offset, CONFIG_PAGING_PAGESIZE,
+                   (FAR uint8_t *)vpage);
+  if (nread != CONFIG_PAGING_PAGESIZE)
+    {
+      _err("short page read at %ld: %zd\n", (long)offset, nread);
+      return nread < 0 ? (int)nread : -EIO;
+    }
+
+  return OK;
+}
+
+#endif /* CONFIG_LEGACY_PAGING */
diff --git a/boards/arm/stmp3770/hp39gii/src/hp39gii_pagetest.c b/boards/arm/stmp3770/hp39gii/src/hp39gii_pagetest.c
new file mode 100644
index 00000000..cb218388
--- /dev/null
+++ b/boards/arm/stmp3770/hp39gii/src/hp39gii_pagetest.c
@@ -0,0 +1,270 @@
+/****************************************************************************
+ * boards/arm/stmp3770/hp39gii/src/hp39gii_pagetest.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Paging self-test.  Writes CONFIG_PAGING_NVPAGED four-KB records to NAND,
+ * each holding a three-instruction ARM stub that returns its own page index,
+ * then calls every record through the paged virtual window.  There are far
+ * more records than physical frames, so page replacement is exercised too.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+
+#include <nuttx/mtd/mtd.h>
+
+#include "chip.h"
+#include "pg_macros.h"
+
+#ifdef CONFIG_LEGACY_PAGING
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define PGTEST_PGSIZE     CONFIG_PAGING_PAGESIZE
+#define PGTEST_NPAGES     CONFIG_PAGING_NVPAGED
+#define PGTEST_BLOB_BLOCK 5
+#define PGTEST_PAGES_PBLK 64                       /* 64 x 2 KB per block */
+#define PGTEST_RW_PER_PG  (PGTEST_PGSIZE / 2048)
+#define PGTEST_NBLOCKS    \
+  ((PGTEST_NPAGES * PGTEST_PGSIZE) / (PGTEST_PAGES_PBLK * 2048))
+
+/* The page tables live inside the window's address range and are pinned
+ * there (see stmp3770_map_paged()).  Those pages never fault, so the test
+ * must not treat them as code.
+ */
+
+#define PGTEST_PINNED_FIRST ((PGTABLE_BASE_VADDR - PG_PAGED_VBASE) / PGTEST_PGSIZE)
+#define PGTEST_PINNED_LAST  \
+  (((PGTABLE_BASE_VADDR + 0x8000) - PG_PAGED_VBASE) / PGTEST_PGSIZE)
+
+/* ldr r0, [pc, #0] ; bx lr ; .word index
+ *
+ * The literal sits at offset 8, which is what pc reads after the load, so the
+ * stub is position independent and needs no relocations.
+ */
+
+#define PGTEST_STUB_LDR   0xe59f0000u
+#define PGTEST_STUB_BXLR  0xe12fff1eu
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static void pgtest_putc(int ch)
+{
+  extern void up_lowputc(int ch);
+  up_lowputc(ch);
+}
+
+static void pgtest_puts(const char *s)
+{
+  while (*s != '\0')
+    {
+      if (*s == '\n')
+        {
+          pgtest_putc('\r');
+        }
+
+      pgtest_putc(*s++);
+    }
+}
+
+static void pgtest_putnum(uint32_t val)
+{
+  char buf[12];
+  int  i = sizeof(buf) - 1;
+
+  buf[i] = '\0';
+
+  if (val == 0)
+    {
+      pgtest_putc('0');
+      return;
+    }
+
+  while (val > 0 && i > 0)
+    {
+      buf[--i] = '0' + (val % 10);
+      val /= 10;
+    }
+
+  pgtest_puts(&buf[i]);
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void hp39gii_pagetest(FAR struct mtd_dev_s *mtd)
+{
+  static uint8_t buf[PGTEST_PGSIZE] __attribute__((aligned(32)));
+  typedef int (*pagefn_t)(void);
+  pagefn_t fn;
+  int      i;
+  int      bad = 0;
+  int      tested = 0;
+  int      ret;
+  int      val;
+
+  if (mtd == NULL)
+    {
+      return;
+    }
+
+  {
+    uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+    uint32_t  l1e = l1[PG_PAGED_VBASE >> 20];
+    uint32_t *l2 = (uint32_t *)(l1e & 0xfffffc00);
+
+    pgtest_puts("[PGTEST] entry: L1[0]=");
+    pgtest_putnum(l1e);
+    pgtest_puts(" L2[60]=");
+    pgtest_putnum(l2[(PG_PAGED_VBASE & 0x000fffff) >> 12]);
+    pgtest_puts(" heap=");
+    pgtest_putnum((uint32_t)PG_DATA_VBASE);
+    pgtest_puts(" heapend=");
+    pgtest_putnum((uint32_t)(PG_DATA_VBASE + PG_DATA_SIZE));
+    pgtest_puts("\n");
+  }
+
+  pgtest_puts("[PGTEST] blob -> NAND blocks ");
+  pgtest_putnum(PGTEST_BLOB_BLOCK);
+  pgtest_puts("..");
+  pgtest_putnum(PGTEST_BLOB_BLOCK + PGTEST_NBLOCKS - 1);
+  pgtest_puts(", ");
+  pgtest_putnum(PGTEST_NPAGES);
+  pgtest_puts(" pages\n");
+
+  ret = MTD_ERASE(mtd, PGTEST_BLOB_BLOCK, PGTEST_NBLOCKS);
+  if (ret < 0)
+    {
+      pgtest_puts("[PGTEST] erase FAILED ");
+      pgtest_putnum((uint32_t)-ret);
+      pgtest_puts("\n");
+      return;
+    }
+
+  for (i = 0; i < PGTEST_NPAGES; i++)
+    {
+      memset(buf, 0, sizeof(buf));
+      *(uint32_t *)&buf[0]  = PGTEST_STUB_LDR;
+      *(uint32_t *)&buf[4]  = PGTEST_STUB_BXLR;
+      *(uint32_t *)&buf[8]  = (uint32_t)i;
+
+      ret = MTD_BWRITE(mtd, PGTEST_BLOB_BLOCK * PGTEST_PAGES_PBLK +
+                            i * PGTEST_RW_PER_PG,
+                       PGTEST_RW_PER_PG, buf);
+      if (ret != PGTEST_RW_PER_PG)
+        {
+          pgtest_puts("[PGTEST] write FAILED at page ");
+          pgtest_putnum(i);
+          pgtest_puts("\n");
+          return;
+        }
+    }
+
+  /* 读回两页，确认 NAND 上确实是我们的桩 */
+
+  {
+    static uint8_t rb[PGTEST_PGSIZE] __attribute__((aligned(32)));
+    int chk[2] = { 0, PGTEST_NPAGES - 1 };
+    int k;
+
+    for (k = 0; k < 2; k++)
+      {
+        ret = MTD_READ(mtd,
+                       (off_t)PGTEST_BLOB_BLOCK * PGTEST_PAGES_PBLK * 2048 +
+                       (off_t)chk[k] * PGTEST_PGSIZE,
+                       PGTEST_PGSIZE, rb);
+        pgtest_puts("[PGTEST] readback p");
+        pgtest_putnum(chk[k]);
+        pgtest_puts(" ret=");
+        pgtest_putnum((uint32_t)ret);
+        pgtest_puts(" w0=");
+        pgtest_putnum(*(uint32_t *)&rb[0]);
+        pgtest_puts(" w1=");
+        pgtest_putnum(*(uint32_t *)&rb[4]);
+        pgtest_puts(" w2=");
+        pgtest_putnum(*(uint32_t *)&rb[8]);
+        pgtest_puts("\n");
+      }
+  }
+
+  /* 打印 0x3C000 的 L2 表项：写 NAND 之后、第一次调用之前，它应该是 0 */
+
+  {
+    uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+    uint32_t  l1e = l1[PG_PAGED_VBASE >> 20];
+    uint32_t *l2 = (uint32_t *)(l1e & 0xfffffc00);
+    uint32_t  ndx = (PG_PAGED_VBASE & 0x000fffff) >> 12;
+
+    pgtest_puts("[PGTEST] L1[0]=");
+    pgtest_putnum(l1e);
+    pgtest_puts(" L2[");
+    pgtest_putnum(ndx);
+    pgtest_puts("]=");
+    pgtest_putnum(l2[ndx]);
+    pgtest_puts("\n");
+  }
+
+  /* 先用数据访问触发一次缺页，验证填充内容；再取指执行 */
+
+  {
+    volatile uint32_t *w = (volatile uint32_t *)PG_PAGED_VBASE;
+
+    pgtest_puts("[PGTEST] data-probe p0: ");
+    pgtest_putnum(w[0]);
+    pgtest_puts(" ");
+    pgtest_putnum(w[1]);
+    pgtest_puts(" ");
+    pgtest_putnum(w[2]);
+    pgtest_puts("\n");
+  }
+
+  pgtest_puts("[PGTEST] blob written, calling paged entries\n");
+
+  for (i = 0; i < PGTEST_NPAGES; i++)
+    {
+      if (i >= PGTEST_PINNED_FIRST && i < PGTEST_PINNED_LAST)
+        {
+          continue;
+        }
+
+      fn  = (pagefn_t)(uintptr_t)(PG_PAGED_VBASE + i * PGTEST_PGSIZE);
+      val = fn();
+      tested++;
+
+      if (val != i)
+        {
+          if (bad < 4)
+            {
+              pgtest_puts("[PGTEST] page ");
+              pgtest_putnum(i);
+              pgtest_puts(" returned ");
+              pgtest_putnum((uint32_t)val);
+              pgtest_puts("\n");
+            }
+
+          bad++;
+        }
+    }
+
+  pgtest_puts("[PGTEST] done, bad=");
+  pgtest_putnum((uint32_t)bad);
+  pgtest_puts(" of ");
+  pgtest_putnum((uint32_t)tested);
+  pgtest_puts(bad == 0 ? " PASS\n" : " FAIL\n");
+}
+
+#endif /* CONFIG_LEGACY_PAGING */
