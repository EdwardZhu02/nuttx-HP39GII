 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -51,6 +55,73 @@
 
 #ifdef CONFIG_STMP3770_MMU
 
+#ifdef CONFIG_LEGACY_PAGING
+
+/****************************************************************************
+ * Name: stmp3770_map_paged
+ *
+ * Description:
+ *  Build the coarse-page map used for on-demand paging:
+ *
+ *    section 0..3  coarse tables at PGTABLE_L2_COARSE_PBASE (1 KB each)
+ *      pages   0..NLOCKED-1        identity, read/write      (image, bss)
+ *      pages   at 0x78000..        identity, read/write      (the page tables
+ *                                  themselves -- they live inside the paged
+ *                                  window's address range, so pin them; they
+ *                                  can never fault and therefore never get
+ *                                  handed out by up_allocpage())
+ *      rest of the window          left invalid -> translation fault
+ *      data region                 PG_DATA_VBASE -> PG_DATA_PBASE
+ *    section 0x800   peripherals, 1 MB section
+ *
+ ****************************************************************************/
+
+static void stmp3770_map_paged(void)
+{
+  uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+  uint32_t *l2 = (uint32_t *)PGTABLE_L2_COARSE_PBASE;
+  uint32_t  i;
+
+  for (i = 0; i < 4 * 256; i++)
+    {
+      l2[i] = 0;
+    }
+
+  /* Locked region: the image, its bss and the idle stacks */
+
+  for (i = 0; i < CONFIG_PAGING_NLOCKED; i++)
+    {
+      l2[i] = (i << PAGESHIFT) | MMU_L2_DATAFLAGS;
+    }
+
+  /* Pin the page-table pages (L1 is 16 KB, the L2 tables 4 KB) */
+
+  for (i = 0; i < 8; i++)
+    {
+      uint32_t va = PGTABLE_BASE_VADDR + i * PAGESIZE;
+      l2[(va & 0x000fffff) >> PAGESHIFT] = va | MMU_L2_DATAFLAGS;
+    }
+
+  /* Data region (the heap): virtual PG_DATA_VBASE, physical PG_DATA_PBASE */
+
+  for (i = 0; i < CONFIG_PAGING_NDATA; i++)
+    {
+      uint32_t va = PG_DATA_VBASE + i * PAGESIZE;
+
+      l2[((va >> 20) * 256) + ((va & 0x000fffff) >> PAGESHIFT)] =
+          (PG_DATA_PBASE + i * PAGESIZE) | MMU_L2_DATAFLAGS;
+    }
+
+  /* L1: four coarse entries covering 0x000000..0x400000 */
+
+  for (i = 0; i < 4; i++)
+    {
+      l1[i] = (PGTABLE_L2_COARSE_PBASE + i * 1024) | MMU_L1_TEXTFLAGS;
+    }
+}
+
+#endif /* CONFIG_LEGACY_PAGING */
+
 static inline void stmp3770_cp15_ttbr(uint32_t ttbr)
 {
   __asm volatile ("mcr p15, 0, %0, c2, c0, 0" :: "r" (ttbr) : "memory");
@@ -87,8 +158,12 @@ static void stmp3770_mmuinit(void)
       l1[i] = 0;
     }
 
+#ifdef CONFIG_LEGACY_PAGING
+  stmp3770_map_paged();
+#else
   l1[STMP3770_SRAM_BASE >> 20] =
       (STMP3770_SRAM_BASE & 0xfff00000) | MMU_MEMFLAGS;
+#endif
   l1[STMP3770_REGS_BASE >> 20] =
       (STMP3770_REGS_BASE & 0xfff00000) | MMU_IOFLAGS;
 
diff --git a/arch/arm/src/stmp3770/stmp3770_memorymap.h b/arch/arm/src/stmp3770/stmp3770_memorymap.h
index cf94670d..86895d6a 100644
--- a/arch/arm/src/stmp3770/stmp3770_memorymap.h
+++ b/arch/arm/src/stmp3770/stmp3770_memorymap.h
@@ -54,9 +54,40 @@
  */
 
 #define STMP3770_PGTABLE_SIZE   0x00004000
-#define PGTABLE_BASE_PADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
-#define PGTABLE_BASE_VADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
-#define STMP3770_HEAP_VEND      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+
+#ifdef CONFIG_LEGACY_PAGING
+
+/* 按需分页布局（4 KB 页，见 docs/khicas.md）：
+ *
+ * 物理：[0x00000, 0x3C000) 240 KB 常驻     60 页
+ *       [0x3C000, 0x54000)  96 KB 代码页帧  24 页
+ *       [0x54000, 0x78000) 144 KB 数据/堆   36 页
+ *       [0x78000, 0x7C000)  16 KB L1
+ *       [0x7C000, 0x7D000)   4 KB L2 粗表（段 0..3）
+ *
+ * 虚拟：常驻同上，窗口 [0x3C000, 0x3BC000) 3.5 MB，数据区
+ *       [0x3BC000, 0x3E0000)，页表本身仍按 identity 访问。
+ *
+ * 注意：页表的虚拟地址（0x78000）落在窗口范围内。窗口里这几页在启动时
+ * 就被固定映射成 identity，永远不会产生缺页，所以 up_allocpage 不会把
+ * 它们当空闲页用掉。窗口的第 60..65 页因此是保留的。
+ */
+
+#  define PGTABLE_BASE_PADDR       (STMP3770_SRAM_END - 0x00008000)
+#  define PGTABLE_BASE_VADDR       PGTABLE_BASE_PADDR
+#  define PGTABLE_L2_COARSE_OFFSET 0x00004000
+#  define PGTABLE_L2_COARSE_PBASE  (PGTABLE_BASE_PADDR + PGTABLE_L2_COARSE_OFFSET)
+#  define PGTABLE_L2_FINE_OFFSET   0x00004000
+#  define PGTABLE_L2_FINE_PBASE    (PGTABLE_BASE_PADDR + PGTABLE_L2_FINE_OFFSET)
+#  define STMP3770_HEAP_VEND       PGTABLE_BASE_PADDR
+
+#else
+
+#  define PGTABLE_BASE_PADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#  define PGTABLE_BASE_VADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#  define STMP3770_HEAP_VEND      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+
+#endif
 #define NUTTX_START_VADDR       STMP3770_SRAM_BASE
 
