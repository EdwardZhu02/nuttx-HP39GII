+/* 打一个 32 位十六进制值（带标签）到 LCD 控制台。 */
+
+static void nand_hex32(FAR const char *tag, uint32_t v)
+{
+  static const char hex[] = "0123456789abcdef";
+  char b[40];
+  int n = 0;
+  int shift;
+
+  while (*tag != 0)
+    {
+      b[n++] = *tag++;
+    }
+
+  b[n++] = '=';
+
+  for (shift = 28; shift >= 0; shift -= 4)
+    {
+      b[n++] = hex[(v >> shift) & 15];
+    }
+
+  b[n++] = 0x0d;
+  b[n++] = 0x0a;
+  b[n]   = 0;
+
+  stmp3770_lcdcon_puts(b);
+}
