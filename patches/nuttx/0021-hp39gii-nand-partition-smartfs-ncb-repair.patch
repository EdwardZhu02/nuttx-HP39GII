-/* 只读冒烟测试：初始化 GPMI/ECC8，打印 ID 与几何，再读几页。
- * 绝不写 NAND —— 真机上存的是原厂固件，写坏了要整片回刷。 */
+/* 原厂在 0 号块和 4 号块各存了一份 NCB（NAND 控制块），两份内容逐字节
+ * 相同。4 号块那份一旦被抹掉，就从 0 号块复制回去（数据 + 19 字节元数据），
+ * 并读回复核。返回 0=本来就正常，1=已修复，负值=修复失败。
+ */
+
+static int nand_fix_ncb_backup(FAR struct mtd_dev_s *mtd)
+{
+  static uint8_t ncb[HP39GII_NAND_PAGE_SIZE] __attribute__((aligned(32)));
+  static uint8_t rb[HP39GII_NAND_PAGE_SIZE] __attribute__((aligned(32)));
+  static uint8_t meta[16] __attribute__((aligned(32)));
+
+  if (mtd->bread(mtd, (off_t)4 * HP39GII_NAND_PAGES_PBLK, 1, rb) != 1)
+    {
+      return -1;
+    }
+
+  if (rb[0] == 'S' && rb[1] == 'T' && rb[2] == 'M' && rb[3] == 'P')
+    {
+      return 0;
+    }
+
+  if (mtd->bread(mtd, 0, 1, ncb) != 1)
+    {
+      return -2;
+    }
+
+  if (!(ncb[0] == 'S' && ncb[1] == 'T' && ncb[2] == 'M' && ncb[3] == 'P'))
+    {
+      return -3;
+    }
+
+  portMTDReadPage(0, NULL);
+  memcpy(meta, portMTDGetMetaData(), 19);
+
+  if (mtd->erase(mtd, 4, 1) != 1)
+    {
+      return -4;
+    }
+
+  portMTDWritePageMeta(4 * HP39GII_NAND_PAGES_PBLK, ncb, meta);
+  usleep(500);
+
+  if (mtd->bread(mtd, (off_t)4 * HP39GII_NAND_PAGES_PBLK, 1, rb) != 1)
+    {
+      return -5;
+    }
+
+  if (memcmp(ncb, rb, HP39GII_NAND_PAGE_SIZE) != 0)
+    {
+      return -6;
+    }
+
+  portMTDReadPage(4 * HP39GII_NAND_PAGES_PBLK, NULL);
+  if (memcmp(meta, portMTDGetMetaData(), 19) != 0)
+    {
+      return -7;
+    }
+
+  return 1;
+}
