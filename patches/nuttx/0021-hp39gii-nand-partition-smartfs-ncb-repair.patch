--- a/arch/arm/src/stmp3770/stmp3770_mtd.c
+++ b/arch/arm/src/stmp3770/stmp3770_mtd.c
@@ -63,12 +63,25 @@ static ssize_t stmp3770_mtd_bwrite(FAR struct mtd_dev_s *dev,
 {
   FAR struct stmp3770_mtd_dev_s *priv =
       (FAR struct stmp3770_mtd_dev_s *)dev;
+
+  /* GPMI 的写 DMA 直接拿调用者的缓冲区当地址，源地址必须 32 字节对齐
+   * （在 restore 固件里踩过：不对齐时写进去的内容是坏的）。上层
+   * （SmartFS / MTD SMART）传下来的指针不保证对齐，所以每页先拷进
+   * 对齐的静态缓冲区再编程。
+   */
+
+  static uint8_t wbuf[2048] __attribute__((aligned(32)));
   size_t i;
 
+  if (priv->info.PageSize_B > sizeof(wbuf))
+    {
+      return -EINVAL;
+    }
+
   for (i = 0; i < nblocks; i++)
     {
-      portMTDWritePage((uint32_t)(startblock + i),
-                       (uint8_t *)(buffer + i * priv->info.PageSize_B));
+      memcpy(wbuf, buffer + i * priv->info.PageSize_B, priv->info.PageSize_B);
+      portMTDWritePage((uint32_t)(startblock + i), wbuf);
     }
 
   return (ssize_t)nblocks;
@@ -80,7 +93,7 @@ static ssize_t stmp3770_mtd_read(FAR struct mtd_dev_s *dev,
 {
   FAR struct stmp3770_mtd_dev_s *priv =
       (FAR struct stmp3770_mtd_dev_s *)dev;
-  static uint32_t pagebuf[2048 / 4];
+  static uint8_t pagebuf[2048] __attribute__((aligned(32)));
   uint32_t pagesize = priv->info.PageSize_B;
   size_t done = 0;
 
@@ -95,8 +108,8 @@ static ssize_t stmp3770_mtd_read(FAR struct mtd_dev_s *dev,
           chunk = nbytes - done;
         }
 
-      portMTDReadPage(page, (uint8_t *)pagebuf);
-      memcpy(buffer + done, (uint8_t *)pagebuf + off, chunk);
+      portMTDReadPage(page, pagebuf);
+      memcpy(buffer + done, pagebuf + off, chunk);
       done += chunk;
     }
 
