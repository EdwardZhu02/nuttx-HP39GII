+/* 文件系统自检：/mnt/boot.txt 存一个十进制计数，每次启动读出来 +1 再写回
+ * 并读回比对。开机号每次 +1 就说明「写进去的数据确实落到了 NAND 上」，
+ * 而不是只活在缓存里。
+ *
+ * 返回新的计数（> 0），失败返回负的 errno。
+ */
+
+static int nand_fs_test(void)
+{
+  char buf[32];
+  char rb[32];
+  int fd;
+  int n;
+  int len;
+  int val = 0;
+
+  fd = open("/mnt/boot.txt", O_RDONLY);
+  if (fd >= 0)
+    {
+      n = read(fd, buf, sizeof(buf) - 1);
+      close(fd);
+      if (n > 0)
+        {
+          buf[n] = '\0';
+          val = atoi(buf);
+        }
+    }
+
+  val++;
+
+  fd = open("/mnt/boot.txt", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (fd < 0)
+    {
+      return -errno;
+    }
+
+  len = snprintf(buf, sizeof(buf), "%d\n", val);
+  n = write(fd, buf, len);
+  close(fd);
+  if (n != len)
+    {
+      return -5;
+    }
+
+  fd = open("/mnt/boot.txt", O_RDONLY);
+  if (fd < 0)
+    {
+      return -errno;
+    }
+
+  n = read(fd, rb, sizeof(rb) - 1);
+  close(fd);
+
+  if (n != len || memcmp(buf, rb, len) != 0)
+    {
+      return -6;
+    }
+
+  return val;
+}
