diff --git a/arch/arm/src/arm/Make.defs b/arch/arm/src/arm/Make.defs
index 43afb28c..3eab56f5 100644
--- a/arch/arm/src/arm/Make.defs
+++ b/arch/arm/src/arm/Make.defs
@@ -24,7 +24,7 @@
 
 include common/Make.defs
 
-HEAD_ASRC  = arm_head.S
+HEAD_ASRC  = arm_nommuhead.S
 
 CMN_CSRCS += arm_dataabort.c arm_doirq.c arm_initialstate.c
 CMN_CSRCS += arm_prefetchabort.c
diff --git a/arch/arm/src/arm/arm_nommuhead.S b/arch/arm/src/arm/arm_nommuhead.S
index 4dcce0e6..fc5802a7 100644
--- a/arch/arm/src/arm/arm_nommuhead.S
+++ b/arch/arm/src/arm/arm_nommuhead.S
@@ -65,6 +65,15 @@ __start:
 	mov		r0, #(PSR_MODE_SYS | PSR_I_BIT | PSR_F_BIT )
 	msr		cpsr, r0
 
+	/* Disable MMU + D-cache and clear the V bit (high vectors). The BootROM
+	 * may leave them enabled; bare-metal addressing needs them off, exactly
+	 * like ExistOS's reset handler does. */
+
+	mrc		p15, 0, r0, c1, c0
+	bic		r0, r0, #0x2000		/* V bit -> low vectors at 0x0 */
+	bic		r0, r0, #0x5		/* MMU (bit0) + D-cache (bit2) off */
+	mcr		p15, 0, r0, c1, c0, 0
+
 	/* Setup system stack (and get the BSS range) */
 
 	adr		r0, .Lbssinit
@@ -119,6 +128,7 @@ __start:
 	/* Finally branch to the OS entry point */
 
 	mov		lr, #0				/* LR = return address (none) */
+	bl		arm_boot			/* SoC early init (clock, vectors, board) */
 	b		nx_start			/* Branch to nx_start */
 
 	/* Variables:
