+    ey = 24;
+
+    if (indicateBit == -1) {
+        setbit = save_ind_bit;
+    } else {
+        setbit = indicateBit;
+        save_ind_bit = indicateBit;
+    }
+
+    if (batteryBit == -1) {
+        setBat = save_bat;
+    } else {
+        save_bat = batteryBit;
+        setBat = batteryBit;
+    }
+
+    LCDIF_CMD8(0x2A);
+    LCDIF_DAT32(BigEnd16(sx) | BigEnd16(ex) << 16);
+
+    LCDIF_CMD8(0x2B);
+    LCDIF_DAT32(BigEnd16(sy) | BigEnd16(ey) << 16);
+
+    LCDIF_CMD8(0x2C);
+
+    for (int y = sy; y < ey; y++) {
+        for (int x = sx; x < ex; x++) {
+
+            switch (x) {
+            case 84: // Battery Box
+                LCDIF_DAT8(0);
+                break;
+            case 76: // Battery 1st Indication
+                LCDIF_DAT8((setBat >> 0) & 1 ? 0 : 0xFF);
+                break;
+            case 75: // Battery 3rd Indication
+                LCDIF_DAT8((setBat >> 2) & 1 ? 0 : 0xFF);
+                break;
+            case 77: // Battery 2rd Indication
+                LCDIF_DAT8((setBat >> 1) & 1 ? 0 : 0xFF);
+                break;
+            case 78: // Battery 4th Indication
+                LCDIF_DAT8((setBat >> 3) & 1 ? 0 : 0xFF);
+                break;
+            case 10: // A..Z
+                LCDIF_DAT8((setbit >> 2) & 1 ? 0 : 0xFF);
+                break;
+            case 28: // TX
+                LCDIF_DAT8((setbit >> 5) & 1 ? 0 : 0xFF);
+                break;
+            case 37: // Left
+                LCDIF_DAT8((setbit >> 0) & 1 ? 0 : 0xFF);
+                break;
+            case 44: // a..z
+                LCDIF_DAT8((setbit >> 3) & 1 ? 0 : 0xFF);
+                break;
+            case 50: // RX
+                LCDIF_DAT8((setbit >> 6) & 1 ? 0 : 0xFF);
+                break;
+            case 64: // Right
+                LCDIF_DAT8((setbit >> 1) & 1 ? 0 : 0xFF);
+                break;
+            case 82: // Busy
+                LCDIF_DAT8((setbit >> 4) & 1 ? 0 : 0xFF);
+                break;
+
+            default:
+                LCDIF_DAT8(0xFF);
+            }
+        }
+    }
+}
+
+void portDispReadBackVRAM(uint32_t x_start, uint32_t y_start, uint32_t x_end, uint32_t y_end, uint8_t *buf) {
+    uint32_t xstart = x_start;
+    uint32_t xend = x_end;
+    uint32_t ystart = (y_start + SCREEN_START_Y);
+    uint32_t yend = (y_end + SCREEN_START_Y);
+
+    if ((xstart > xend) || (ystart > yend)) {
+        return;
+    }
+    uint32_t p = 0;
+    for (uint32_t line_i = ystart; line_i <= yend; line_i++) {
+
+        LCDIF_CMD8(0x2A);
+        LCDIF_DAT32(BigEnd16(xstart / 3) | (BigEnd16(xend / 3) << 16));
+        LCDIF_CMD8(0x2B);
+        LCDIF_DAT32(BigEnd16(line_i) | (BigEnd16(line_i) << 16));
+        LCDIF_CMD8(0x2E);
+        LCDIF_ReadDAT(lineBuffer, ((xend / 3) - (xstart / 3) + 1) * 3);
+
+        memcpy(&buf[p], &lineBuffer[xstart % 3], xend - xstart + 1);
+        p += xend - xstart + 1;
+    }
+}
+uint32_t dummy;
+void portDispFlushAreaBuf(uint32_t x_start, uint32_t y_start, uint32_t x_end, uint32_t y_end, uint8_t *buf) {
+
+    uint32_t xstart = x_start;
+    uint32_t xend = x_end;
+    uint32_t ystart = (y_start + SCREEN_START_Y);
+    uint32_t yend = (y_end + SCREEN_START_Y);
+
+    if ((xstart > xend) || (ystart > yend)) {
+        return;
+    }
+
+    if (
+        (x_start > SCREEN_WIDTH + 1) ||
+        (x_end > SCREEN_WIDTH + 1) ||
+        (y_start > SCREEN_END_Y + 0) ||
+        (y_end > SCREEN_END_Y + 0)
+
+    ) {
+        return;
+    }
+
+    LCDIF_CMD8(0x2A);
+    LCDIF_DAT32(BigEnd16(xstart / 3) | (BigEnd16(xend / 3) << 16));
+
+    uint32_t p = 0;
+    lineBuffer[sizeof(lineBuffer) - 1] = 0x5A;
+    for (uint32_t line_i = ystart; line_i <= yend; line_i++) {
+
+        LCDIF_CMD8(0x2B);
+        LCDIF_DAT32(BigEnd16(line_i) | ((BigEnd16(line_i) << 16)));
+
+        if (xstart % 3) {
+            LCDIF_CMD8(0x2E);
+            LCDIF_ReadDAT(lineBuffer, 3);
+        }
+        memcpy(&lineBuffer[xstart % 3], &buf[p], xend - xstart + 1);
+        p += xend - xstart + 1;
+
+        LCDIF_CMD8(0x2C);
+
+        LCDIF_WriteDAT(lineBuffer, xend - xstart + 1);
+    }
+    if (lineBuffer[sizeof(lineBuffer) - 1] != 0x5A) {
+        INFO("LineBuffer Error.\n");
+    }
+    // INFO("ed\n");
+}
+
+void DisplayPrepareBatchIn(uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1) {
+    LCDIF_CMD8(0x2A);
+    LCDIF_DAT32(BigEnd16(x0 / 3) | (BigEnd16(x1 / 3) << 16));
+    LCDIF_CMD8(0x2B);
+    LCDIF_DAT32(BigEnd16(y0) | (BigEnd16(y1) << 16));
+}
+
+void DisplayBatchIn(uint8_t *dat, uint32_t len) {
+    LCDIF_CMD8(0x2C);
+    LCDIF_WriteDAT(dat, len);
+}
+
+void portDispSetContrast(uint8_t contrast) {
+    LCDIF_CMD8(0x25);
+    LCDIF_DAT8(contrast & 0x7F);
+}
+
+void portDispDeviceInit() {
+    /* APBH 必须先上电，否则后面所有 DMA 都是“静默失败” */
+
+    LCDIF_APBHPowerUp();
+
+    LCDIF_DMAChainsInit();
+
+    /* 先复位通道、再放行；原来的顺序是先使能后复位，等于什么都没做 */
+
+    LCDIF_ResetDMAChannel();
+    LCDIF_EnableDMAChannel(true);
+
+    LCDIF_SetTiming();
+
+    /* 尚未挂 LCDIF 的 ISR，先不开这两个中断源，走轮询（portDISP_ISR 未注册）。
+     * 开着但没 handler 时，中断会打到 irq_dispatch 的空 handler 上，打断 NSH 初始化。
+     */
+    // portEnableIRQ(HW_IRQ_LCDIF_DMA, true);
+    // portEnableIRQ(HW_IRQ_LCDIF_ERROR, true);
+    BF_CS1(APBH_CTRL1, CH0_CMDCMPLT_IRQ_EN, 1);
+    ;
+
+    BF_CLR(LCDIF_CTRL1, MODE86);
+    BF_CLR(LCDIF_CTRL1, LCD_CS_CTRL);
+
+    BF_SET(LCDIF_CTRL1, OVERFLOW_IRQ_EN);
+    BF_SET(LCDIF_CTRL1, UNDERFLOW_IRQ_EN);
+
+    BF_SET(LCDIF_CTRL1, BUSY_ENABLE);
+
+    BF_CS1(LCDIF_CTRL1, BYTE_PACKING_FORMAT, 0xF);
+    BF_CS1(LCDIF_CTRL1, READ_MODE_NUM_PACKED_SUBWORDS, 4);
+    BF_CS1(LCDIF_CTRL1, FIRST_READ_DUMMY, 1);
+
+    BF_CLR(LCDIF_CTRL1, RESET);
+    portDelayus(120000);
+    BF_SET(LCDIF_CTRL1, RESET);
+
+    opaFinish = true;
+
+    LCDIF_CMD8(0xD7); // Auto Load Set
+    LCDIF_DAT8(0x9F);
+    LCDIF_CMD8(0xE0); // EE Read/write mode
+    LCDIF_DAT8(0x00); // Set read mode
+
+    portDelayus(100000);
+
+    LCDIF_CMD8(0xE3); // Read active
+
+    portDelayus(100000);
+
+    LCDIF_CMD8(0xE1); // Cancel control
+
+    LCDIF_CMD8(0x11); // sleep out
+
+    portDelayus(500000);
+
+    LCDIF_CMD8(0x28); // Display off
+
+    LCDIF_CMD8(0xC0); // Set Vop by initial Module
+    LCDIF_DAT8(0x01);
+    LCDIF_DAT8(0x01);
+
+    // LCDIF_CMD8(0xF0); // Set Frame Rate
+    // LCDIF_DAT32(0x0D0D0D0D);
+
+    LCDIF_CMD8(0xC3); // Bias select
+    LCDIF_DAT8(0x02);
+
+    LCDIF_CMD8(0xC4); // Setting Booster times
+    LCDIF_DAT8(0x07);
+
+    LCDIF_CMD8(0xC5); // Booster Efficiency selection
+    LCDIF_DAT8(0x02);
+
+    LCDIF_CMD8(0xD0); // Analog circuit setting
+    LCDIF_DAT8(0x1D);
+
+    LCDIF_CMD8(0xB5); // N-Line
+    LCDIF_DAT8(0x8C);
+    LCDIF_DAT8(0x00);
+
+    LCDIF_CMD8(0x38); // Idle mode off
+
+    LCDIF_CMD8(0x3A); // pix format
+    LCDIF_DAT8(7);
+
+    LCDIF_CMD8(0x36); // Memory Access Control
+    LCDIF_DAT8(0x48);
+
+    LCDIF_CMD8(0xB0); // Set Duty
+    LCDIF_DAT8(0x87);
+
+    LCDIF_CMD8(0xB4); // Partial Saving Power Mode Selection
+    LCDIF_DAT8(0xA0);
+
+    LCDIF_CMD8(0x29); // Display on
+
+    if (DISPLAY_INVERSE)
+        LCDIF_CMD8(0x21); // Display inversion on
+
+    uint8_t ID[3];
+
+    LCDIF_CMD8(0xDA);
+    LCDIF_ReadDAT(&ID[0], 1);
+
+    LCDIF_CMD8(0xDB);
+    LCDIF_ReadDAT(&ID[1], 1);
+
+    LCDIF_CMD8(0xDC);
+    LCDIF_ReadDAT(&ID[2], 1);
+
+    for (int i = 0; i < 3; i++) {
+        printf("LCD ID[%d]:%02x\n", i, ID[i]);
+    }
+
+    extern uint32_t g_lcd_contrast;
+    portDispSetContrast(g_lcd_contrast);
+
+    /* portDispClean() 会整屏刷一次并等 DMA 完成，在 EmuGII 下会挂住。
+     * 面板 ID 已经读出来了，说明通路是通的；清屏留给帧写入调试。
+     */
+    // portDispClean();
+}
+
+/* 移植补丁：ExistOS 里该变量定义在 display_up.c（初值 62），这里补定义 */
+uint32_t g_lcd_contrast = 62;
diff --git a/arch/arm/src/stmp3770/stmp3770_lowputc.c b/arch/arm/src/stmp3770/stmp3770_lowputc.c
new file mode 100644
index 00000000..7b8a603f
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_lowputc.c
@@ -0,0 +1,90 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_lowputc.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * 早期字符输出（debug UART）。
+ *
+ * Phase-0 实测确认该口是 **PL011 寄存器面**：
+ *   CR@0x30      = 0x00000101  (UARTEN|TXE)
+ *   FR@0x18      = 0x00000090  (TXFE|RXFE)
+ *   PeriphID0@0xFE0 = 0x11     ← PL011 标志值
+ *
+ * 注意：HP 39gII 没有外露的串口引脚，这个口只能在夹具引出或用于
+ * 内部自检。板上的第一可见输出仍然是 LCD。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+
+#include <nuttx/arch.h>
+#include <arch/board/board.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+#ifdef CONFIG_STMP3770_UARTDBG_SERIAL
+
+void stmp3770_lowsetup(void)
+{
+  /* 关掉 UART 再配置 */
+
+  putreg32(0, STMP3770_UARTDBG_CR);
+
+  /* 8N1, FIFO 使能 */
+
+  putreg32((1 << 4) | (1 << 5) | (1 << 6), STMP3770_UARTDBG_LCRH);
+
+  /* 波特率分频。UART 参考时钟频率尚未实测，
+   * 这里按 24 MHz 估算 IBRD/FBRD；若输出为乱码，先怀疑此值。
+   */
+
+#ifdef CONFIG_STMP3770_UARTDBG_BAUD
+  {
+    uint32_t baud = CONFIG_STMP3770_UARTDBG_BAUD;
+    uint32_t div  = (24000000 + (baud / 2)) / baud;
+
+    putreg32((div >> 6) & 0xffff, STMP3770_UARTDBG_IBRD);
+    putreg32(div & 0x3f, STMP3770_UARTDBG_FBRD);
+  }
+#endif
+
+  /* 清全部中断 */
+
+  putreg32(0x7ff, STMP3770_UARTDBG_ICR);
+
+  /* 使能 UART、发送、接收 */
+
+  putreg32(UARTDBG_CR_UARTEN | UARTDBG_CR_TXE | UARTDBG_CR_RXE,
+           STMP3770_UARTDBG_CR);
+}
+
+void up_lowputc(int ch)
+{
+  while ((getreg32(STMP3770_UARTDBG_FR) & UARTDBG_FR_TXFE) == 0);
+
+  putreg32((uint32_t)(ch & 0xff), STMP3770_UARTDBG_DR);
+}
+
+#else /* !CONFIG_STMP3770_UARTDBG_SERIAL */
+
+void stmp3770_lowsetup(void)
+{
+}
+
+void up_lowputc(int ch)
+{
+}
+
+#endif /* CONFIG_STMP3770_UARTDBG_SERIAL */
+
+#ifndef CONFIG_UART0_SERIAL_CONSOLE
+/* PL011 驱动自带 up_putc（HAVE_PL011_CONSOLE），启用控制台时不要重复定义 */
+
+void up_putc(int ch)
+{
+  up_lowputc(ch);
+}
+#endif
diff --git a/arch/arm/src/stmp3770/stmp3770_memorymap.h b/arch/arm/src/stmp3770/stmp3770_memorymap.h
new file mode 100644
index 00000000..cf94670d
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_memorymap.h
@@ -0,0 +1,240 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_memorymap.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HP 39gII / STMP3770 外设基址表。
+ *
+ * 本文件的地址与位定义**全部来自 2026-11-01 真机 Phase-0 实测**
+ * （见 reports/HP39gII-port-report.md §2.4），不是从数据手册抄的，
+ * 因为 STMP3770 没有公开手册，只能以实测为准。实测过的项标 [M]。
+ *
+ ****************************************************************************/
+
+#ifndef __ARCH_ARM_SRC_STMP3770_STMP3770_MEMORYMAP_H
+#define __ARCH_ARM_SRC_STMP3770_STMP3770_MEMORYMAP_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* 片上 SRAM —— 全部可用内存，512 KB，物理基址 0
+ *
+ * [M] 地址译码只解 19 位：读 0x0080_0000 与 0x0010_0000 都返回物理 0 的内容
+ *     （探测固件自己向量表的第 0 个字），且 0x4000_0000 触发同步外部总线异常。
+ *     这两条同时证明板上没有外部 DRAM。
+ */
+
+#define STMP3770_SRAM_BASE      0x00000000
+#define STMP3770_SRAM_SIZE      (512 * 1024)
+#define STMP3770_SRAM_END       (STMP3770_SRAM_BASE + STMP3770_SRAM_SIZE)
+
+/* 外设区基址 */
+
+#define STMP3770_REGS_BASE      0x80000000
+
+/* arm_head.S 需要：内核映像的起始物理地址。
+ * 本板 RAM 只有一块 512KB@0x0，不走 ROM 页表，故直接取 SRAM 基址。
+ */
+
+#define NUTTX_START_PADDR       STMP3770_SRAM_BASE
+
+/* bring-up 阶段不用 MMU，但 arm_head.S / arm_vectors.S 仍会引用页表基址。
+ * 指向 SRAM 基址即可（不会被真正使用）。
+ */
+
+/* 页表必须避开镜像本身。镜像由 BootStream 载入到 0x0，
+ * 所以把 16KB 页表放在 SRAM 顶端，堆在它下面结束。
+ */
+
+#define STMP3770_PGTABLE_SIZE   0x00004000
+#define PGTABLE_BASE_PADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#define PGTABLE_BASE_VADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#define STMP3770_HEAP_VEND      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#define NUTTX_START_VADDR       STMP3770_SRAM_BASE
+
+/* 中断控制器 ICOLL
+ *
+ * [M] STAT 在 0x30（空闲时读 0x3F，VECTOR_NUMBER 位于 bits[7:0]）；
+ *     0x70 未实现，读回 0。
+ *     这一条是 Phase-0 特意验证的：Linux 侧曾有 0x30 / 0x70 两种说法。
+ */
+
+#define STMP3770_ICOLL_BASE     (STMP3770_REGS_BASE + 0x00000000)
+#define STMP3770_ICOLL_VECTOR   (STMP3770_ICOLL_BASE + 0x0000)
+#define STMP3770_ICOLL_LEVELACK (STMP3770_ICOLL_BASE + 0x0010)
+#define STMP3770_ICOLL_CTRL     (STMP3770_ICOLL_BASE + 0x0020)
+#define STMP3770_ICOLL_STAT     (STMP3770_ICOLL_BASE + 0x0030)  /* [M] */
+#define STMP3770_ICOLL_STAT_70  (STMP3770_ICOLL_BASE + 0x0070)  /* [M] 恒 0 */
+#define STMP3770_ICOLL_VBASE    (STMP3770_ICOLL_BASE + 0x0160)
+#define STMP3770_ICOLL_PRIORITY(n) \
+        (STMP3770_ICOLL_BASE + 0x0060 + (((n) >> 2) * 0x10))
+
+#define ICOLL_STAT_VECTOR_MASK  0x000000ff  /* bits[7:0] 为当前向量号 */
+#define ICOLL_STAT_IDLE         0x0000003f  /* [M] 空闲值 0x3F */
+
+/* APBH DMA（NAND 与 LCD 共用） */
+
+#define STMP3770_APBH_BASE      (STMP3770_REGS_BASE + 0x00004000)
+#define STMP3770_APBH_CTRL0     (STMP3770_APBH_BASE + 0x0000)
+#define STMP3770_APBH_CTRL1     (STMP3770_APBH_BASE + 0x0010)
+
+/* PINCTRL：引脚复用 */
+
+#define STMP3770_PINCTRL_BASE   (STMP3770_REGS_BASE + 0x00018000)  /* [M] 读回 0x1C000000 */
+#define STMP3770_PINCTRL_CTRL0  (STMP3770_PINCTRL_BASE + 0x0000)
+#define STMP3770_PINCTRL_MUXSEL(n) \
+        (STMP3770_PINCTRL_BASE + 0x0100 + (((n) >> 4) * 0x10) + \
+         (((n) & 0xf) * 4))
+
+/* DIGCTL：芯片 ID、微秒计数器（portDelayus 的基础） */
+
+#define STMP3770_DIGCTL_BASE    (STMP3770_REGS_BASE + 0x0001C000)
+#define STMP3770_DIGCTL_CHIPID  (STMP3770_DIGCTL_BASE + 0x00000310)  /* [M] */
+#define STMP3770_DIGCTL_USEC    (STMP3770_DIGCTL_BASE + 0x000000c0)  /* [corr] regsdigctl.h: 0xC0 */
+
+#define DIGCTL_CHIPID_PRODUCT(v) (((v) >> 16) & 0xffff)
+#define DIGCTL_CHIPID_REVISION(v) ((v) & 0xffff)
+
+/* [M] CHIPID = 0x37B00002 -> PRODUCT_CODE 0x37B0, REVISION 0x0002 */
+
+#define STMP3770_PRODUCT_CODE   0x37b0
+
+/* EMI：外部存储接口 —— 用来判 DRAM 是否存在 */
+
+#define STMP3770_EMI_BASE       (STMP3770_REGS_BASE + 0x00020000)
+#define STMP3770_EMI_CTRL       (STMP3770_EMI_BASE + 0x0000)    /* [M] 读回 0 */
+#define STMP3770_EMI_STAT       (STMP3770_EMI_BASE + 0x0010)    /* [M] 读回 0 */
+
+#define EMI_STAT_DRAM_PRESENT   (1 << 31)  /* [M] = 0 */
+#define EMI_STAT_NOR_PRESENT    (1 << 30)
+#define EMI_STAT_LARGE_DRAM     (1 << 29)
+#define EMI_STAT_DRAM_HALTED    (1 << 1)
+
+/* CLKCTRL：时钟与复位 */
+
+#define STMP3770_CLKCTRL_BASE   (STMP3770_REGS_BASE + 0x00040000)  /* [M] CTRL0=0x00050000 */
+#define STMP3770_CLKCTRL_CTRL0  (STMP3770_CLKCTRL_BASE + 0x0000)
+#define STMP3770_CLKCTRL_CPU    (STMP3770_CLKCTRL_BASE + 0x0030)
+
+/* TIMROT：旋转定时器，用作系统节拍
+ *
+ * [M] VERSION = 0x01010000（MAJOR=1 MINOR=1 STEP=0），与 i.MX23/28 一致，
+ *     因此 mxs 系的 timer 逻辑可直接套用。
+ *     通道步长 0x20（TIMCTRL3 = 0x8006_8080 可正常读）。
+ */
+
+#define STMP3770_TIMROT_BASE    (STMP3770_REGS_BASE + 0x00068000)
+#define STMP3770_TIMROT_ROTCTRL (STMP3770_TIMROT_BASE + 0x0000)
+#define STMP3770_TIMROT_ROTCOUNT (STMP3770_TIMROT_BASE + 0x0010)  /* [M] */
+
+/* 通道步长 = 0x20（STMP3770 特有，i.MX23/28 是 0x40）
+ *
+ * 依据：ExistOS regstimrot.h 为 0x20；且 Phase-0 实测 VERSION 位于 0xA0，
+ * 只有 0x20 步长时第 3 通道才结束于 0x9F、VERSION 落在 0xA0。
+ * 若用 i.MX 的 0x40 步长，TIMCTRL3 会占到 0xE0，与实测矛盾。
+ * ⇒ mainline drivers/clocksource/mxs_timer.c 的偏移**不能**直接照搬。
+ */
+
+#define STMP3770_TIMROT_TIMCTRLn(n) \
+        (STMP3770_TIMROT_BASE + 0x0020 + ((n) * 0x20))            /* [M] */
+#define STMP3770_TIMROT_TIMCOUNTn(n) \
+        (STMP3770_TIMROT_BASE + 0x0030 + ((n) * 0x20))
+#define STMP3770_TIMROT_VERSION (STMP3770_TIMROT_BASE + 0x00a0)   /* [M] 0x01010000 */
+
+/* ROTCTRL 位定义
+ *
+ * 复位值 = SFTRST | CLKGATE | PRESENT，这两位不清掉整个 TIMROT 不计数。
+ * 这一条曾经让系统完全没有节拍（clock_systime_ticks() 恒为 0）。
+ */
+
+#define TIMROT_ROTCTRL_SFTRST   (1u << 31)
+#define TIMROT_ROTCTRL_CLKGATE  (1u << 30)
+
+/* TIMCTRLn 位定义（与 regstimrot.h 一致） */
+
+#define TIMROT_TIMCTRL_IRQ        (1 << 15)
+#define TIMROT_TIMCTRL_IRQ_EN     (1 << 14)
+#define TIMROT_TIMCTRL_POLARITY   (1 << 8)
+#define TIMROT_TIMCTRL_UPDATE     (1 << 7)
+#define TIMROT_TIMCTRL_RELOAD     (1 << 6)
+#define TIMROT_TIMCTRL_PRESCALE_SHIFT 4
+#define TIMROT_TIMCTRL_SELECT_SHIFT   0
+
+/* [M] VERSION = 0x01010000 ⇒ TIMROT v1 ⇒ 32 kHz XTAL 选择值为 0x8
+ * （v2 是 0xb/0xf，见 mainline mxs_timer.c）
+ */
+
+#define TIMROT_V1_SELECT_32KHZ_XTAL 0x8
+#define TIMROT_CLK_32KHZ            32768
+
+/* AUART（应用串口）—— i.MX 风格寄存器面
+ *
+ * [M] VERSION = 0x02000000；STAT@0x70；DATA@0x60。
+ */
+
+#define STMP3770_UARTAPP_BASE   (STMP3770_REGS_BASE + 0x0006c000)
+#define STMP3770_UARTAPP_CTRL0  (STMP3770_UARTAPP_BASE + 0x0000)
+#define STMP3770_UARTAPP_CTRL1  (STMP3770_UARTAPP_BASE + 0x0010)
+#define STMP3770_UARTAPP_CTRL2  (STMP3770_UARTAPP_BASE + 0x0020)
+#define STMP3770_UARTAPP_STAT   (STMP3770_UARTAPP_BASE + 0x0070)  /* [M] */
+#define STMP3770_UARTAPP_DATA   (STMP3770_UARTAPP_BASE + 0x0060)  /* [M] */
+#define STMP3770_UARTAPP_VERSION (STMP3770_UARTAPP_BASE + 0x0090) /* [M] */
+
+/* debug UART（调试串口）—— 确认是 PL011 寄存器面
+ *
+ * [M] CR@0x30 = 0x00000101 (UARTEN|TXE)
+ * [M] FR@0x18 = 0x00000090 (TXFE|RXFE)
+ * [M] PeriphID0@0xFE0 = 0x00000011  <- PL011 标志值
+ *
+ * 结论：可以直接复用 NuttX 的 PL011 串口驱动逻辑，不需要自研 AUART。
+ * 注意：39gII 没有外露的串口引脚，这个口只能用于内部调试。
+ */
+
+#define STMP3770_UARTDBG_BASE   (STMP3770_REGS_BASE + 0x00070000)
+#define STMP3770_UARTDBG_DR     (STMP3770_UARTDBG_BASE + 0x000)
+#define STMP3770_UARTDBG_FR     (STMP3770_UARTDBG_BASE + 0x018)  /* [M] */
+#define STMP3770_UARTDBG_IBRD   (STMP3770_UARTDBG_BASE + 0x024)
+#define STMP3770_UARTDBG_FBRD   (STMP3770_UARTDBG_BASE + 0x028)
+#define STMP3770_UARTDBG_LCRH   (STMP3770_UARTDBG_BASE + 0x02c)
+#define STMP3770_UARTDBG_CR     (STMP3770_UARTDBG_BASE + 0x030)  /* [M] */
+#define STMP3770_UARTDBG_IMSC   (STMP3770_UARTDBG_BASE + 0x038)
+#define STMP3770_UARTDBG_ICR    (STMP3770_UARTDBG_BASE + 0x044)
+#define STMP3770_UARTDBG_PERIPHID0 (STMP3770_UARTDBG_BASE + 0xfe0) /* [M] 0x11 */
+
+#define UARTDBG_CR_UARTEN       (1 << 0)
+#define UARTDBG_CR_TXE          (1 << 8)
+#define UARTDBG_CR_RXE          (1 << 9)
+#define UARTDBG_FR_TXFE         (1 << 7)
+#define UARTDBG_FR_RXFE         (1 << 4)
+
+/* DRI：模块存在（[M] DRI_PRESENT(bit31)=1），但板上没接存储器 */
+
+#define STMP3770_DRI_BASE       (STMP3770_REGS_BASE + 0x00074000)
+#define STMP3770_DRI_CTRL       (STMP3770_DRI_BASE + 0x0000)  /* [M] 0xC0010000 */
+#define STMP3770_DRI_STAT       (STMP3770_DRI_BASE + 0x0020)  /* [M] 0x80000000 */
+
+/* GPMI：NAND 控制器 */
+
+#define STMP3770_GPMI_BASE      (STMP3770_REGS_BASE + 0x0000c000)
+#define STMP3770_BCH_BASE       (STMP3770_REGS_BASE + 0x0000a000)
+
+/* LCDIF：显示控制器 */
+
+#define STMP3770_LCDIF_BASE     (STMP3770_REGS_BASE + 0x00030000)
+
+/* RTC */
+
+#define STMP3770_RTC_BASE       (STMP3770_REGS_BASE + 0x0005c000)
+
+/* USB device */
+
+#define STMP3770_USB_BASE       (STMP3770_REGS_BASE + 0x00080000)
+
+#endif /* __ARCH_ARM_SRC_STMP3770_STMP3770_MEMORYMAP_H */
diff --git a/arch/arm/src/stmp3770/stmp3770_timerisr.c b/arch/arm/src/stmp3770/stmp3770_timerisr.c
new file mode 100644
index 00000000..9d29322a
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_timerisr.c
@@ -0,0 +1,156 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_timerisr.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * TIMROT 系统节拍。
+ *
+ * 关键差异（真机 + 头文件双重确认）：
+ *   STMP3770 的 TIMROT 通道步长是 0x20，不是 i.MX23/28 的 0x40。
+ *   证据：ExistOS regstimrot.h 为 0x20；Phase-0 实测 VERSION 在 0xA0，
+ *   只有 0x20 步长时通道 3 才收在 0x9F。因此 mainline mxs_timer.c
+ *   的寄存器偏移不能照抄。
+ *
+ * VERSION 实测 0x01010000 ⇒ TIMROT v1 ⇒ 32 kHz XTAL 的 SELECT 值为 0x8
+ * （v2 是 0xb / 0xf）。
+ *
+ * 复位状态陷阱（曾经让整个系统没有节拍）：
+ *   ROTCTRL 复位值 = SFTRST(bit31) | CLKGATE(bit30) | PRESENT。
+ *   **不清这两位，TIMROT 的计数器根本不走**，通道永远不产生 IRQ，
+ *   表现为 clock_systime_ticks() 恒为 0：sleep()/usleep() 不返回、
+ *   所有带超时的等待永不超时、时间片轮转失效。
+ *   硬件规定的解除顺序是：写 SFTRST=1 → 轮询 CLKGATE 读到 1 →
+ *   清 SFTRST → 轮询 CLKGATE 读到 0。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <time.h>
+
+#include <nuttx/debug.h>
+#include <nuttx/arch.h>
+#include <arch/board/board.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+/* 每个寄存器都有 RW / SET / CLR / TOG 四个别名，偏移差 0x04 */
+
+#define TIMROT_OFF_SET  0x04
+#define TIMROT_OFF_CLR  0x08
+#define TIMROT_OFF_TOG  0x0c
+
+/* CLKGATE 轮询上限：真机与模拟器都在几十次以内完成，
+ * 给一个上界避免在异常芯片上死等（宁可没节拍也不能挂死启动）。 */
+
+#define TIMROT_POLL_LIMIT  100000
+
+static inline void timrot_setreg(uint32_t addr, uint32_t bits)
+{
+  putreg32(bits, addr + TIMROT_OFF_SET);
+}
+
+static inline void timrot_clrreg(uint32_t addr, uint32_t bits)
+{
+  putreg32(bits, addr + TIMROT_OFF_CLR);
+}
+
+static int stmp3770_timerisr(int irq, uint32_t *regs, void *arg)
+{
+  /* 清中断：TIMCTRL.IRQ 是写 1 清零的（CLR 别名） */
+
+  timrot_clrreg(STMP3770_TIMROT_TIMCTRLn(0), TIMROT_TIMCTRL_IRQ);
+
+  nxsched_process_timer();
+  return 0;
+}
+
+void up_timer_initialize(void)
+{
+  uint32_t count;
+  uint32_t timctrl;
+  int i;
+
+  /* 1. 解除复位并打开时钟。
+   *
+   *    顺序按 STMP 的 SFTRST/CLKGATE 握手：先置 SFTRST，等硬件把
+   *    CLKGATE 也拉高（表示模块已处于复位态），再同时清掉两位。
+   */
+
+  timrot_setreg(STMP3770_TIMROT_ROTCTRL, TIMROT_ROTCTRL_SFTRST);
+
+  for (i = 0; i < TIMROT_POLL_LIMIT; i++)
+    {
+      if ((getreg32(STMP3770_TIMROT_ROTCTRL) & TIMROT_ROTCTRL_CLKGATE) != 0)
+        {
+          break;
+        }
+    }
+
+  /* 一次性清 SFTRST + CLKGATE，顺带把旋转解码器的两个输入源
+   * 置为 TIMCLK_NEVER(0)，免得它在后台吃掉计数。
+   */
+
+  timrot_clrreg(STMP3770_TIMROT_ROTCTRL,
+                TIMROT_ROTCTRL_SFTRST | TIMROT_ROTCTRL_CLKGATE);
+  putreg32(0, STMP3770_TIMROT_ROTCTRL);   /* SELECT_A/B = 0, 不用旋转编码器 */
+
+  for (i = 0; i < TIMROT_POLL_LIMIT; i++)
+    {
+      if ((getreg32(STMP3770_TIMROT_ROTCTRL) & TIMROT_ROTCTRL_CLKGATE) == 0)
+        {
+          break;
+        }
+    }
+
+  if (i == TIMROT_POLL_LIMIT)
+    {
+      uerr("TIMROT CLKGATE stuck set, no system tick\n");
+      return;
+    }
+
+  /* 2. 通道 0 先停掉，避免配置过程中产生半截中断 */
+
+  putreg32(0, STMP3770_TIMROT_TIMCTRLn(0));
+
+  /* 3. 计数初值：32 kHz / (1000000 / CONFIG_USEC_PER_TICK)
+   *
+   *    100 Hz + 32.768 kHz 除不尽，327 给 100.2 Hz；
+   *    对 39gII 这种没有 RTC 校准需求的场合足够。
+   */
+
+  count = (uint32_t)(((uint64_t)TIMROT_CLK_32KHZ * CONFIG_USEC_PER_TICK) /
+                     1000000ULL);
+  if (count == 0)
+    {
+      count = 1;
+    }
+  else if (count > 0xffff)
+    {
+      count = 0xffff;
+    }
+
+  putreg32(count, STMP3770_TIMROT_TIMCOUNTn(0));
+
+  /* 4. 先清掉可能残留的 IRQ 标志，再装通道配置。
+   *
+   *    SELECT=0x8(32 kHz XTAL) | RELOAD(周期) | IRQ_EN。
+   *    不写 UPDATE：RELOAD 已经足够，UPDATE 只用于立即重载计数。
+   */
+
+  timrot_clrreg(STMP3770_TIMROT_TIMCTRLn(0), TIMROT_TIMCTRL_IRQ);
+
+  timctrl = ((uint32_t)TIMROT_V1_SELECT_32KHZ_XTAL
+               << TIMROT_TIMCTRL_SELECT_SHIFT) |
+            TIMROT_TIMCTRL_RELOAD |
+            TIMROT_TIMCTRL_IRQ_EN;
+
+  putreg32(timctrl, STMP3770_TIMROT_TIMCTRLn(0));
+
+  /* 5. 挂中断 */
+
+  irq_attach(STMP3770_IRQ_TIMER0, (xcpt_t)stmp3770_timerisr, NULL);
+  up_enable_irq(STMP3770_IRQ_TIMER0);
+}
