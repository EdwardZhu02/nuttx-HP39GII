+
+include $(TOPDIR)/.config
+include $(TOPDIR)/tools/Config.mk
+include $(TOPDIR)/arch/arm/src/arm/Toolchain.defs
+
+ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script
+
+ARCHCCVERSION = ${shell $(CC) -v 2>&1 | sed -n '/^gcc version/p' | sed -e 's/^gcc version \([0-9\.]\)/\1/g' -e 's/[-\ ].*//g' -e '1q'}
+ARCHCCMAJOR = ${shell echo $(ARCHCCVERSION) | cut -d'.' -f1}
+
+ifeq ($(ARCHCCMAJOR),2)
+  OLDGCC = y
+else ifeq ($(ARCHCCMAJOR),3)
+  OLDGCC = y
+else
+  OLDGCC = n
+endif
+
+ifeq ($(OLDGCC),n)
+  ARCHCPUFLAGS = -mtune=arm9tdmi -march=armv5te -mfloat-abi=soft
+else
+  ARCHCPUFLAGS = -mapcs-32 -mtune=arm9tdmi -march=armv5te -msoft-float
+endif
+
+CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
+CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
+CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
+AFLAGS := $(CFLAGS) -D__ASSEMBLY__
+
+NXFLATLDFLAGS1 = -r -d -warn-common
+NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-gotoff.ld -no-check-sections
+LDNXFLATFLAGS = -e main -s 2048
diff --git a/boards/arm/stmp3770/hp39gii/scripts/ld.script b/boards/arm/stmp3770/hp39gii/scripts/ld.script
new file mode 100644
index 00000000..568e01bf
--- /dev/null
+++ b/boards/arm/stmp3770/hp39gii/scripts/ld.script
@@ -0,0 +1,88 @@
+/****************************************************************************
+ * boards/arm/stmp3770/hp39gii/scripts/ld.script
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HP 39gII 链接脚本。
+ *
+ * 内存事实（2026-11-01 真机实测）：
+ *   - 唯一可用 RAM 是 512 KB 片内 SRAM，物理基址 0x0000_0000
+ *   - 没有外部 DRAM；0x4000_0000 访问会触发同步外部总线异常
+ *   - 地址译码只解 19 位，0x0080_0000 和 0x0010_0000 都别名到物理 0
+ *
+ * 约束：BootStream 由 SDP 载入后从 0x0000 开始执行，因此 **.vectors 必须排在最前**，
+ * 这与 ExistOS 的 _init 位于 0x0 是同一个约束，不能改。
+ ****************************************************************************/
+
+MEMORY
+{
+  sram (rwx) : ORIGIN = 0x00000000, LENGTH = 512K
+}
+
+OUTPUT_ARCH(arm)
+ENTRY(_stext)
+
+SECTIONS
+{
+    .text : {
+        _stext = ABSOLUTE(.);
+        KEEP(*(.vectors))
+        *(.text .text.*)
+        *(.fixup)
+        *(.gnu.warning)
+        *(.gnu.linkonce.t.*)
+        *(.glue_7)
+        *(.glue_7t)
+        *(.got)
+        *(.gcc_except_table)
+        *(.gnu.linkonce.r.*)
+        _etext = ABSOLUTE(.);
+    } > sram
+
+    .init_section : {
+        _sinit = ABSOLUTE(.);
+        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
+        KEEP(*(.init_array .ctors))
+        _einit = ABSOLUTE(.);
+    } > sram
+
+    .ARM.exidx : {
+        __exidx_start = ABSOLUTE(.);
+        *(.ARM.exidx*)
+        __exidx_end = ABSOLUTE(.);
+    } > sram
+
+    .rodata : {
+        _srodata = ABSOLUTE(.);
+        *(.rodata .rodata.*)
+        *(.data.rel.ro .data.rel.ro.*)
+        *(.gnu.linkonce.r.*)
+        _erodata = ABSOLUTE(.);
+    } > sram
+
+    .data : {
+        _sdata = ABSOLUTE(.);
+        *(.data .data.*)
+        *(.gnu.linkonce.d.*)
+        CONSTRUCTORS
+        _edata = ABSOLUTE(.);
+    } > sram
+
+    .bss : {
+        _sbss = ABSOLUTE(.);
+        *(.bss .bss.*)
+        *(.gnu.linkonce.b.*)
+        *(COMMON)
+        . = ALIGN(4);
+        _ebss = ABSOLUTE(.);
+    } > sram
+
+    /* 栈放在 SRAM 顶端向下生长 */
+    /* 顶端 16KB 留给一级页表（PGTABLE_SIZE），不能被堆占用 */
+    _eram = ORIGIN(sram) + LENGTH(sram) - 0x4000;
+
+    /DISCARD/ : {
+        *(.comment)
+        *(.note*)
+    }
+}
