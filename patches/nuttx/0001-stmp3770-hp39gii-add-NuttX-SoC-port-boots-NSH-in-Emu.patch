diff --git a/boards/arm/stmp3770/hp39gii/src/hp39gii_boot.c b/boards/arm/stmp3770/hp39gii/src/hp39gii_boot.c
new file mode 100644
index 00000000..4f339cd4
--- /dev/null
+++ b/boards/arm/stmp3770/hp39gii/src/hp39gii_boot.c
@@ -0,0 +1,173 @@
+/****************************************************************************
+ * boards/arm/stmp3770/hp39gii/src/hp39gii_boot.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * 板级初始化。
+ *
+ * bring-up 顺序按「先看得见，再能交互」排：
+ *   1. LCD 出一个可辨识的画面   ← 第一个可见里程碑（本板没有外露串口）
+ *   2. 键盘矩阵
+ *   3. NAND + 文件系统
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdarg.h>
+#include <stdio.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/board.h>
+#include <nuttx/kthread.h>
+#include <nuttx/sched.h>
+#include <nuttx/serial/uart_pl011.h>
+#include <arch/board/board.h>
+
+#include <unistd.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+#ifdef CONFIG_STMP3770_KBD
+void hp39gii_kbd_initialize(void);
+#endif
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* 内核线程没有 stdout，printf 会被静默丢弃；早期调试统一走轮询的
+ * debug UART（up_lowputc），这条路不依赖驱动、不依赖中断、不依赖调度。
+ */
+
+static void hp39gii_puts(FAR const char *s)
+{
+  while (*s != '\0')
+    {
+      up_lowputc(*s++);
+    }
+}
+
+static void hp39gii_printf(FAR const char *fmt, ...)
+{
+  char buf[96];
+  va_list ap;
+
+  va_start(ap, fmt);
+  vsnprintf(buf, sizeof(buf), fmt, ap);
+  va_end(ap);
+
+  hp39gii_puts(buf);
+}
+
+/****************************************************************************
+ * LCD bring-up
+ ****************************************************************************/
+
+/* 从 ExistOS 移植的 LCD 驱动（arch/arm/src/stmp3770/stmp3770_lcd.c） */
+
+void portDispInterfaceInit(void);
+void portDispDeviceInit(void);
+void portDispClean(void);
+void portDispFlushAreaBuf(uint32_t x_start, uint32_t y_start,
+                          uint32_t x_end, uint32_t y_end, uint8_t *buf);
+
+static void hp39gii_lcdtest(void)
+{
+  static uint8_t bars[256];
+  int i;
+
+  /* bring-up 图案：清屏 + 三条实心横条。
+   * 横条位置取屏幕的 1/8、1/2、7/8 附近，肉眼一眼能看出上下方向对不对。
+   */
+
+  portDispClean();
+
+  for (i = 0; i < (int)sizeof(bars); i++)
+    {
+      bars[i] = 0xff;
+    }
+
+  portDispFlushAreaBuf(0, 14, 255, 28, bars);
+  portDispFlushAreaBuf(0, 56, 255, 70, bars);
+  portDispFlushAreaBuf(0, 98, 255, 112, bars);
+}
+
+#ifdef CONFIG_STMP3770_LCD_INIT
+
+/* 面板 bring-up 放在独立内核线程里跑，不放在 os_bringup 的关键路径上：
+ *
+ *   - 面板从 reset 到 display-on 需要约 820 ms 的长延时，
+ *     塞在启动路径里会把整个系统拖住，出错时也没有可观测的中间状态；
+ *   - 线程优先级低于 NSH，先让 shell 起来（本板的 debug UART 只有夹具上
+ *     能引出，shell 是主要调试通道），再回头初始化面板；
+ *   - 万一 LCD 通路卡住，被卡住的只是一个线程，系统仍然可用。
+ */
+
+static int hp39gii_lcd_thread(int argc, char **argv)
+{
+  sleep(2);
+
+  hp39gii_puts("[LCD] interface init\n");
+  portDispInterfaceInit();
+
+  hp39gii_puts("[LCD] device init\n");
+  portDispDeviceInit();
+
+  hp39gii_puts("[LCD] frame test\n");
+  hp39gii_lcdtest();
+
+  hp39gii_puts("[LCD] ready\n");
+  return 0;
+}
+
+#endif /* CONFIG_STMP3770_LCD_INIT */
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void stmp3770_boardinitialize(void)
+{
+  /* 早期板级初始化（时钟、引脚复用等）目前由 arch 层在 arm_boot() 里完成。
+   * LCD 与键盘都要等控制台和调度器就绪，放到 board_late_initialize()。
+   */
+}
+
+void board_late_initialize(void)
+{
+#ifdef CONFIG_STMP3770_LCD_INIT
+  int ret;
+
+  ret = kthread_create("lcdinit", SCHED_PRIORITY_DEFAULT + 5,
+                       2048, hp39gii_lcd_thread, NULL);
+  if (ret < 0)
+    {
+      hp39gii_printf("[LCD] kthread_create failed: %d\n", ret);
+    }
+#endif
+
+#ifdef CONFIG_STMP3770_KBD
+  /* 键盘放在最后：它要往控制台注入字符，等 shell 起来才有意义 */
+
+  hp39gii_kbd_initialize();
+#endif
+}
+
+/****************************************************************************
+ * Console
+ ****************************************************************************/
+
+void arm_serialinit(void)
+{
+  /* 先标记控制台并配置 UART 硬件：pl011_earlyserialinit() 会把
+   * CONSOLE_DEV.isconsole 置位，uart_register() 据此初始化 ECHO/ICANON/
+   * ICRNL 等终端标志。漏掉这一步会走到 raw 读路径——不回显、不拼行，
+   * NSH 读得到字符却不响应。之后再注册 /dev/console 与 /dev/ttyS0。
+   */
+
+  pl011_earlyserialinit();
+  pl011_serialinit();
+}
diff --git a/boards/arm/stmp3770/hp39gii/src/hp39gii_kbd.c b/boards/arm/stmp3770/hp39gii/src/hp39gii_kbd.c
new file mode 100644
index 00000000..d6179db5
--- /dev/null
+++ b/boards/arm/stmp3770/hp39gii/src/hp39gii_kbd.c
@@ -0,0 +1,327 @@
+/****************************************************************************
+ * boards/arm/stmp3770/hp39gii/src/hp39gii_kbd.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HP 39gII 键盘：扫描 + 去抖 + 键值翻译。
+ *
+ * 为什么要有这一层：本板没有外露串口，debug UART 只在夹具上能引出，
+ * 键盘是唯一的真实输入设备。硬件扫描在 arch/arm/src/stmp3770/stmp3770_kbd.c，
+ * 这里负责去抖、键码到 ASCII 的翻译，以及两种投递方式：
+ *
+ *   CONFIG_STMP3770_KBD_ECHO   —— 把翻译结果直接打到 debug UART。
+ *                                 真机 bring-up 阶段用来确认每个键都对应到
+ *                                 正确的字符；不依赖任何驱动栈。
+ *   CONFIG_STMP3770_KBD_CONSOLE —— 把字符塞进控制台的接收缓冲，让 NSH
+ *                                 变成可交互的（详见文件末尾的说明，暂未默认开启）。
+ *
+ * ALPHA 字母表来自真机键帽丝印，不是猜的 —— 把 EmuGII 的前面板渲染图放大后
+ * 逐键读出的红色小字，并与 EmuGII fp_buttons[] 表交叉核对一致：
+ *
+ *   Vars=a Math=b a b/c=c x,t,θ,n=d
+ *   SIN=e COS=f TAN=g LN=h LOG=i
+ *   x²=j  xʸ=k  ( =l  ) =m  ÷=n
+ *   , =o  7=p   8=q   9=r   ×=s
+ *   4 =t  5=u   6=v   −=w
+ *   1 =x  2=y   3=z
+ *
+ * ALPHA 与 SHIFT 都是一次性生效（按一次只作用于下一个键），与真机一致；
+ * SHIFT+ALPHA 出大写。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/irq.h>
+#include <nuttx/kthread.h>
+#include <nuttx/sched.h>
+
+#include <unistd.h>
+
+#include <arch/board/board.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+#ifdef CONFIG_STMP3770_KBD
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define KBD_NROWS 11
+#define KBD_NCOLS 5
+#define KBD_NKEYS (KBD_NROWS * KBD_NCOLS)
+
+/* 键码 = (row << 3) | col，与 ExistOS / 真机一致 */
+
+#define KBD_KEY(r, c) (((r) << 3) | (c))
+
+#define KBD_SCAN_PERIOD_MS 20
+#define KBD_DEBOUNCE       2   /* 连续 N 次相同才认可 */
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* ALPHA 模式下每个键的字母；0 表示该键在丝印上没有字母 */
+
+static const char g_alpha_map[128] =
+{
+  [KBD_KEY(3, 0)] = 'a',   /* Vars      */
+  [KBD_KEY(4, 1)] = 'b',   /* Math      */
+  [KBD_KEY(3, 2)] = 'c',   /* a b/c     */
+  [KBD_KEY(2, 3)] = 'd',   /* x,t,θ,n   */
+  [KBD_KEY(4, 0)] = 'e',   /* SIN       */
+  [KBD_KEY(5, 1)] = 'f',   /* COS       */
+  [KBD_KEY(4, 2)] = 'g',   /* TAN       */
+  [KBD_KEY(4, 3)] = 'h',   /* LN        */
+  [KBD_KEY(4, 4)] = 'i',   /* LOG       */
+  [KBD_KEY(5, 0)] = 'j',   /* x²        */
+  [KBD_KEY(6, 1)] = 'k',   /* xʸ        */
+  [KBD_KEY(5, 2)] = 'l',   /* (         */
+  [KBD_KEY(5, 3)] = 'm',   /* )         */
+  [KBD_KEY(5, 4)] = 'n',   /* ÷         */
+  [KBD_KEY(6, 0)] = 'o',   /* ,         */
+  [KBD_KEY(7, 1)] = 'p',   /* 7         */
+  [KBD_KEY(6, 2)] = 'q',   /* 8         */
+  [KBD_KEY(6, 3)] = 'r',   /* 9         */
+  [KBD_KEY(6, 4)] = 's',   /* ×         */
+  [KBD_KEY(8, 1)] = 't',   /* 4         */
+  [KBD_KEY(7, 2)] = 'u',   /* 5         */
+  [KBD_KEY(7, 3)] = 'v',   /* 6         */
+  [KBD_KEY(7, 4)] = 'w',   /* −         */
+  [KBD_KEY(9, 1)] = 'x',   /* 1         */
+  [KBD_KEY(8, 2)] = 'y',   /* 2         */
+  [KBD_KEY(8, 3)] = 'z',   /* 3         */
+};
+
+/* 非 ALPHA 模式下的 ASCII；0 表示不是字符键（功能键、修饰键等） */
+
+static const uint8_t g_ascii_map[128] =
+{
+  [KBD_KEY(9, 0)] = '0',
+  [KBD_KEY(9, 1)] = '1',
+  [KBD_KEY(8, 2)] = '2',
+  [KBD_KEY(8, 3)] = '3',
+  [KBD_KEY(8, 1)] = '4',
+  [KBD_KEY(7, 2)] = '5',
+  [KBD_KEY(7, 3)] = '6',
+  [KBD_KEY(7, 1)] = '7',
+  [KBD_KEY(6, 2)] = '8',
+  [KBD_KEY(6, 3)] = '9',
+  [KBD_KEY(9, 2)] = '.',
+  [KBD_KEY(6, 0)] = ',',
+  [KBD_KEY(8, 4)] = '+',
+  [KBD_KEY(7, 4)] = '-',
+  [KBD_KEY(6, 4)] = '*',
+  [KBD_KEY(5, 4)] = '/',
+  [KBD_KEY(5, 2)] = '(',
+  [KBD_KEY(5, 3)] = ')',
+  [KBD_KEY(9, 3)] = '-',   /* (-) */
+  [KBD_KEY(9, 4)] = '\r',  /* ENTER */
+  [KBD_KEY(3, 3)] = 0x08,  /* ← 退格 */
+};
+
+static uint8_t g_raw[KBD_NKEYS];
+static uint8_t g_stable[KBD_NKEYS];
+static uint8_t g_count[KBD_NKEYS];
+
+static bool g_alpha;
+static bool g_shift;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* Deliver one translated character.
+ *
+ * Two independent sinks:
+ *
+ *   CONFIG_STMP3770_KBD_ECHO     -- bring-up self-check: write the character
+ *                                   straight to the debug UART (up_putc,
+ *                                   polled, no driver stack) to verify
+ *                                   "scan -> keycode -> ASCII" per key.
+ *   CONFIG_STMP3770_KBD_CONSOLE  -- the real goal: inject the character into
+ *                                   the console receive buffer so NSH becomes
+ *                                   interactive.
+ *
+ * Both may be on at once: ECHO is a side-band observation channel, CONSOLE
+ * is the actual delivery path.
+ */
+
+#ifdef CONFIG_STMP3770_KBD_CONSOLE
+#  include <nuttx/serial/serial.h>
+
+extern FAR struct uart_dev_s *pl011_console_device(void);
+#endif
+
+static void kbd_deliver(int ch)
+{
+#ifdef CONFIG_STMP3770_KBD_ECHO
+  up_putc(ch);
+#endif
+
+#ifdef CONFIG_STMP3770_KBD_CONSOLE
+  {
+    FAR struct uart_dev_s *dev = pl011_console_device();
+    irqstate_t flags;
+    sbuf_size_t next;
+
+    if (dev == NULL)
+      {
+        return;
+      }
+
+    flags = enter_critical_section();
+
+    /* Advance head the same way uart_recvchars() does (do not assume the
+     * buffer size is a power of two).
+     */
+
+    next = (dev->recv.head + 1 < dev->recv.size) ?
+           dev->recv.head + 1 : 0;
+    if (next != dev->recv.tail)
+      {
+        dev->recv.buffer[dev->recv.head] = (char)ch;
+        dev->recv.head = next;
+        uart_datareceived(dev);
+      }
+
+    leave_critical_section(flags);
+  }
+#endif
+
+  (void)ch;
+}
+
+static void kbd_emit(int keycode)
+{
+  /* ALPHA / SHIFT 是一次性修饰键 */
+
+  if (keycode == KBD_KEY(7, 0))
+    {
+      g_alpha = true;
+      return;
+    }
+
+  if (keycode == KBD_KEY(8, 0))
+    {
+      g_shift = true;
+      return;
+    }
+
+  if (g_alpha)
+    {
+      char c = g_alpha_map[keycode];
+
+      g_alpha = false;
+
+      if (c != 0)
+        {
+          kbd_deliver(g_shift ? (c - 'a' + 'A') : c);
+          g_shift = false;
+          return;
+        }
+
+      g_shift = false;
+    }
+
+  g_shift = false;
+
+  if (g_ascii_map[keycode] != 0)
+    {
+      kbd_deliver(g_ascii_map[keycode]);
+    }
+
+  /* 方向键在这里先不处理：终端转义序列要等控制台通路打通之后再接 */
+
+  switch (keycode)
+    {
+      case KBD_KEY(0, 4):   /* UP    */
+      case KBD_KEY(3, 4):   /* DOWN  */
+      case KBD_KEY(1, 4):   /* RIGHT */
+      case KBD_KEY(2, 4):   /* LEFT  */
+#ifdef CONFIG_STMP3770_KBD_ECHO
+        /* Direction keys carry no escape sequence yet; emit a placeholder
+         * marker so each can still be verified key-by-key.
+         */
+
+        up_putc('<');
+        up_putc('a' + (keycode & 3));
+        up_putc('>');
+#endif
+        break;
+
+      default:
+        break;
+    }
+}
+
+static int hp39gii_kbd_thread(int argc, char **argv)
+{
+  uint8_t matrix[KBD_NKEYS];
+  int i;
+
+  memset(g_stable, 0, sizeof(g_stable));
+  memset(g_count, 0, sizeof(g_count));
+
+  for (;;)
+    {
+      memset(matrix, 0, sizeof(matrix));
+      stmp3770_kbd_scan(matrix);
+
+      for (i = 0; i < KBD_NKEYS; i++)
+        {
+          if (matrix[i] != g_raw[i])
+            {
+              g_raw[i]   = matrix[i];
+              g_count[i] = 0;
+              continue;
+            }
+
+          if (g_raw[i] == g_stable[i])
+            {
+              continue;
+            }
+
+          if (++g_count[i] < KBD_DEBOUNCE)
+            {
+              continue;
+            }
+
+          g_count[i] = 0;
+          g_stable[i] = g_raw[i];
+
+          if (g_stable[i])
+            {
+              /* 矩阵下标是 row*5+col，键码是 row*8+col */
+
+              kbd_emit(KBD_KEY(i / KBD_NCOLS, i % KBD_NCOLS));
+            }
+        }
+
+      usleep(KBD_SCAN_PERIOD_MS * 1000);
+    }
+
+  return 0;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void hp39gii_kbd_initialize(void)
+{
+  stmp3770_kbd_initialize();
+
+  kthread_create("kbd", SCHED_PRIORITY_DEFAULT - 10, 2048,
+                 hp39gii_kbd_thread, NULL);
+}
+
+#endif /* CONFIG_STMP3770_KBD */
