+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * 堆布局：hp39gII 只有一块连续的 512 KB SRAM，堆就是
+ * 「空闲栈顶 ... SRAM 末尾」这一段，没有第二个内存区。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <stdint.h>
+#include <assert.h>
+#include <nuttx/debug.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/board.h>
+#include <nuttx/kmalloc.h>
+#include <arch/board/board.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770_memorymap.h"
+
+
+void up_allocate_heap(void **heap_start, size_t *heap_size)
+{
+  board_autoled_on(LED_HEAPALLOCATE);
+
+  *heap_start = (void *)(uintptr_t)g_idle_topstack;
+  *heap_size  = (size_t)(STMP3770_HEAP_VEND - (uintptr_t)g_idle_topstack);
+
+  DEBUGASSERT(*heap_size > 0);
+}
diff --git a/arch/arm/src/stmp3770/stmp3770_boot.c b/arch/arm/src/stmp3770/stmp3770_boot.c
new file mode 100644
index 00000000..5e255e31
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_boot.c
@@ -0,0 +1,117 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_boot.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * arm_boot(): NuttX 在 ARM926EJS 上的启动入口，由 arm/arm_head.S 调用。
+ *
+ * 设计决定：bring-up 阶段**不打开 MMU**。
+ *
+ *   理由：本 SoC 只有一块 512 KB SRAM（物理 0x0000_0000）和外设区
+ *   （0x8000_0000），没有任何需要重映射的窗口。物理地址直通即可工作，
+ *   少一层页表就少一个故障面。等系统能跑起来再考虑开 MMU 做保护/缓存。
+ *
+ *   风险：不开 MMU 就没有 D-cache，性能会差很多；且部分 NuttX 配置
+ *   （CONFIG_BUILD_KERNEL / CONFIG_ARCH_ADDRENV）依赖 MMU，不能启用。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+
+#include "chip.h"
+#include "arm_internal.h"
+#include "arm.h"
+#include "stmp3770.h"
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/* 外设区映射
+ *
+ * arm_head.S 只映射了 RAM（_stext.._ebss），0x8000_0000 之外一概没映射。
+ * 一旦访问 CLKCTRL/UART/LCDIF 就会 data abort（实测 DFAR=0x80040000）。
+ * 这里补一条 1MB section，覆盖 0x8000_0000-0x800F_FFFF（全部寄存器都在其中）。
+ */
+
+static void stmp3770_setupmappings(void)
+{
+  uint32_t *pgtable = (uint32_t *)PGTABLE_BASE_VADDR;
+  uint32_t  index   = STMP3770_REGS_BASE >> 20;
+
+  pgtable[index] = (STMP3770_REGS_BASE & 0xfff00000) | MMU_IOFLAGS;
+
+  /* 改了页表必须冲 TLB + 清理 D-cache，否则 CPU 仍用旧映射 */
+
+  __asm volatile ("mcr p15, 0, %0, c8, c7, 0" :: "r" (0) : "memory");
+  __asm volatile ("mcr p15, 0, %0, c7, c10, 4" :: "r" (0) : "memory");
+}
+
+extern uint8_t _vector_start[];
+extern uint8_t _vector_end[];
+
+/* 把向量表搬到 0x0000_0000 并清 CP15 CR.V
+ *
+ * 背景：EmuGII 的 CPU 复位后 V=1（高向量 0xFFFF_0000），而 NuttX 的
+ * arm_head 并没有把向量块复制到 0 地址——它的向量表链接在镜像里（_vector_start），
+ * 需要移植代码显式搬运。实测：不清 V 位时任何异常都会跳到未映射的
+ * 0xFFFF_0008/0xFFFF_000C，表现为预取异常风暴。
+ */
+
+static void stmp3770_copyvectors(void)
+{
+  uint32_t *dst = (uint32_t *)0x00000000;
+  uint32_t *src = (uint32_t *)_vector_start;
+  uint32_t  n   = (uint32_t)(_vector_end - _vector_start) / 4;
+  uint32_t  ctrl;
+  uint32_t  i;
+
+  for (i = 0; i < n; i++)
+    {
+      dst[i] = src[i];
+    }
+
+  __asm volatile ("mrc p15, 0, %0, c1, c0, 0" : "=r" (ctrl));
+  ctrl &= ~(1u << 13);
+  __asm volatile ("mcr p15, 0, %0, c1, c0, 0" :: "r" (ctrl));
+  __asm volatile ("mcr p15, 0, %0, c8, c7, 0" :: "r" (0) : "memory");
+  __asm volatile ("mcr p15, 0, %0, c7, c5, 4" :: "r" (0) : "memory");
+}
+
+void arm_boot(void)
+{
+  /* 先把外设区映射出来，之后才能碰任何寄存器 */
+
+  stmp3770_setupmappings();
+
+  /* 时钟：保守配置，不动 PLL（BootROM 留下的状态够用） */
+
+  stmp3770_clockconfig();
+
+  /* 底层初始化（debug UART） */
+
+  stmp3770_lowsetup();
+
+  /* 早期探针：直接往 UART 打几个字符，用于区分「串口没配好」和「系统崩了」 */
+
+  {
+    extern void up_lowputc(int ch);
+    static const char p[] = "[NUTTX-UART-OK]";
+    int i;
+    for (i = 0; p[i]; i++)
+      {
+        up_lowputc(p[i]);
+      }
+    up_lowputc(13);
+    up_lowputc(10);
+  }
+
+  /* 板级初始化（LCD、按键、电源等） */
+
+  stmp3770_boardinitialize();
+
+  /* 最后一步：向量就位，之后才能安全地开中断/陷异常 */
+
+  stmp3770_copyvectors();
+}
diff --git a/arch/arm/src/stmp3770/stmp3770_clkctrl.c b/arch/arm/src/stmp3770/stmp3770_clkctrl.c
new file mode 100644
index 00000000..10cb6ae8
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_clkctrl.c
@@ -0,0 +1,36 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_clkctrl.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * 时钟与复位。
+ *
+ * 当前是**保守实现**：不编程 PLL，只把 BootROM 留下的时钟状态读出来确认可用。
+ *
+ * 这样做的原因：PLL 配置需要准确的参考晶振频率和分频表，而 STMP3770 没有
+ * 公开手册。ExistOS 的 OSLoader/drivers/stmp_clkctrl.c 是唯一可参照的实现，
+ * 但它的常数是为「跑满速」调的，直接抄过来有把 CPU 超频/降频到不可用的风险。
+ *
+ * Phase-0 实测：CLKCTRL CTRL0 @0x8004_0000 = 0x0005_0000。
+ * 这个值说明 BootROM 已经把主时钟开起来了，bring-up 阶段可以先接受它。
+ *
+ * TODO: 从 ExistOS 提取 CPU/HCLK 的分频表，实现 stmp3770_setfreq()。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <nuttx/debug.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+void stmp3770_clockconfig(void)
+{
+  uint32_t ctrl0 = getreg32(STMP3770_CLKCTRL_CTRL0);
+
+  /* 不改硬件，只记录：若后续出现时序相关异常，这里是第一现场 */
+
+  uinfo("STMP3770 CLKCTRL CTRL0 = 0x%08" PRIx32 "\n", ctrl0);
+}
diff --git a/arch/arm/src/stmp3770/stmp3770_decodeirq.c b/arch/arm/src/stmp3770/stmp3770_decodeirq.c
new file mode 100644
index 00000000..ba57853b
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_decodeirq.c
@@ -0,0 +1,94 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_decodeirq.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * IRQ 分发 + 中断级上下文切换。
+ *
+ * 三处与「教科书写法」不同，都是被 ICOLL 的硬件时序和 NuttX 的返回约定
+ * 逼出来的：
+ *
+ * 1) 取向量用 HW_ICOLL_VECTOR，不用 HW_ICOLL_STAT。
+ *    在 CTRL.ARM_RSE_MODE 下，读 VECTOR 由硬件完成 enter_service
+ *    （清 vector_pending、占住该优先级），这是 ICOLL 规定的握手。
+ *    只读 STAT 不清 pending，nIRQ 会一直拉住 —— 中断风暴。
+ *    VECTOR 返回 VBASE + vector*pitch；VBASE=0、pitch=4，故向量号 = 值 >> 2。
+ *
+ * 2) 必须返回「返回时要恢复的那套寄存器上下文」，不能返回 NULL。
+ *    arm_vectorirq 的返回路径是 `mov sp, r0` 之后从 sp 弹栈；
+ *    早先这里 return NULL，于是 sp=0，从 0 号地址（向量表）里当栈帧读，
+ *    一跳就飞 —— 表现为内核在第一次中断后立刻 Undefined Instruction。
+ *    发生上下文切换时要返回新任务的 xcp.regs，见 arm_doirq.c 的同款逻辑。
+ *
+ * 3) LEVELACK 放在 irq_dispatch() **之后**。
+ *    ICOLL 是电平控制器：先释放电平再清源，控制器会立刻重新选出
+ *    同一个仍然挂起的源，同一个 ISR 被调用两次 —— 时钟节拍就会走双倍。
+ *    所以顺序是：读 VECTOR(占位) → 处理(ISR 清源) → LEVELACK(放电平)。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <assert.h>
+
+#include <nuttx/debug.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "arm_internal.h"
+#include "sched/sched.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+uint32_t *arm_decodeirq(uint32_t *regs)
+{
+#ifdef CONFIG_SUPPRESS_INTERRUPTS
+  err("ERROR: Unexpected IRQ\n");
+  PANIC();
+  return NULL;
+#else
+  struct tcb_s *tcb = this_task();
+  uint32_t vector;
+  int irq;
+
+  DEBUGASSERT(!up_interrupt_context());
+
+  /* 读 VECTOR：硬件在此刻完成 acknowledge（enter_service） */
+
+  vector = getreg32(STMP3770_ICOLL_VECTOR);
+  irq    = (int)((vector >> 2) & 0x3f);
+
+  if (irq >= NR_IRQS)
+    {
+      /* 没有有效源：直接把四个电平都放了，避免卡死 */
+
+      putreg32(0xf, STMP3770_ICOLL_LEVELACK);
+      return regs;
+    }
+
+  up_set_interrupt_context(true);
+  tcb->xcp.regs = regs;
+
+  irq_dispatch(irq, regs);
+  tcb = this_task();
+
+  /* 检查是否发生了上下文切换 */
+
+  if (regs != tcb->xcp.regs)
+    {
+      struct tcb_s **running_task = &g_running_tasks[this_cpu()];
+
+      nxsched_switch_context(*running_task, tcb);
+      *running_task = tcb;
+      regs = tcb->xcp.regs;
+    }
+
+  up_set_interrupt_context(false);
+
+  /* 源已经由 ISR 清掉，现在释放优先级电平 */
+
+  arm_ack_irq(irq);
+
+  return regs;
+#endif
+}
diff --git a/arch/arm/src/stmp3770/stmp3770_irq.c b/arch/arm/src/stmp3770/stmp3770_irq.c
new file mode 100644
index 00000000..4519cf13
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_irq.c
@@ -0,0 +1,193 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_irq.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * ICOLL 中断控制器驱动。
+ *
+ * ICOLL 不是 ARM 标准的 GIC/VIC：
+ *
+ *   - 64 个源，4 个一组打包进 HW_ICOLL_PRIORITY(n)，每源 8 位
+ *     （bit[1:0] 优先级、bit[2] 使能、bit[7:3] 保留）。
+ *   - HW_ICOLL_STAT[5:0] 是当前选中的源号；空闲时真机为 0x3F。
+ *   - HW_ICOLL_VECTOR 返回向量表地址 = VBASE + vector * pitch。
+ *   - 控制器内部有一个多周期仲裁状态机（不是组合逻辑），
+ *     选出一个向量后置 vector_pending，才把 nIRQ 拉低。
+ *
+ * 两个曾经让中断完全不通的坑，都在 CTRL 寄存器：
+ *
+ *   1) 复位值 CTRL = 0xC0030000，即 SFTRST 与 CLKGATE 都是**置位**的，
+ *      模块处在复位+时钟关闭状态。必须显式清掉这两位。
+ *   2) nIRQ 的最终输出使能是 **bit16**（IRQ_FINAL_ENABLE），
+ *      bit17 是 FIQ。曾经误写成 bit1（i.MX23 的位号），结果只打开了 FIQ，
+ *      IRQ 一次都没送进 CPU —— 表现为 clock_systime_ticks() 恒为 0、
+ *      所有超时永不生效、sleep() 不返回，但系统看起来还能跑（全靠轮询）。
+ *
+ * 服务结束的握手用 ARM_RSE_MODE：读 HW_ICOLL_VECTOR 即自动
+ * enter_service（清 vector_pending、占用该优先级），
+ * 处理完源之后写 HW_ICOLL_LEVELACK 的对应位释放该优先级。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <assert.h>
+
+#include <nuttx/debug.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* CTRL 位定义（STMP3770 实际位号，与 i.MX23/28 不同） */
+
+#define ICOLL_CTRL_SFTRST           (1u << 31)
+#define ICOLL_CTRL_CLKGATE          (1u << 30)
+#define ICOLL_CTRL_ARM_RSE_MODE     (1u << 18)
+#define ICOLL_CTRL_FIQ_FINAL_ENABLE (1u << 17)
+#define ICOLL_CTRL_IRQ_FINAL_ENABLE (1u << 16)
+
+/* 寄存器 SET/CLR/TOG 别名偏移 */
+
+#define ICOLL_OFF_SET 0x04
+#define ICOLL_OFF_CLR 0x08
+
+/* 每源优先级字段的有效宽度 */
+
+#define ICOLL_PRIO_MASK 0x0f
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void up_irqinitialize(void)
+{
+  uint32_t reg;
+  int irq;
+
+  /* 1. 退出复位、打开时钟。
+   *
+   *    复位值里 SFTRST/CLKGATE 都为 1，模块是死的；
+   *    用 CLR 别名清掉，避免整寄存器写入带来的副作用。
+   */
+
+  putreg32(ICOLL_CTRL_SFTRST | ICOLL_CTRL_CLKGATE,
+           STMP3770_ICOLL_CTRL + ICOLL_OFF_CLR);
+
+  /* 2. 向量表基址 0（我们不使用硬件向量跳转，只读向量号），
+   *    pitch 保持复位值 4。
+   */
+
+  putreg32(0, STMP3770_ICOLL_VBASE);
+
+  /* 3. 屏蔽全部源、优先级归零 */
+
+  for (irq = 0; irq < NR_IRQS; irq++)
+    {
+      uint32_t addr  = STMP3770_ICOLL_PRIORITY(irq);
+      uint32_t shift = ICOLL_PRIO_SHIFT(irq);
+      uint32_t value = getreg32(addr);
+
+      value &= ~((uint32_t)ICOLL_PRIO_MASK << shift);
+      putreg32(value, addr);
+    }
+
+  putreg32(0, STMP3770_ICOLL_LEVELACK);
+
+#ifndef CONFIG_SUPPRESS_INTERRUPTS
+  /* 4. 打开 nIRQ 输出，并进入 ARM_RSE 模式
+   *    （读 HW_ICOLL_VECTOR 即自动 acknowledge 当前向量）
+   */
+
+  reg  = getreg32(STMP3770_ICOLL_CTRL);
+  reg |= ICOLL_CTRL_IRQ_FINAL_ENABLE | ICOLL_CTRL_ARM_RSE_MODE;
+  putreg32(reg, STMP3770_ICOLL_CTRL);
+
+  up_irq_enable();
+#endif
+}
+
+void up_disable_irq(int irq)
+{
+  uint32_t addr;
+  uint32_t shift;
+  uint32_t reg;
+
+  DEBUGASSERT((unsigned)irq < NR_IRQS);
+
+  addr  = STMP3770_ICOLL_PRIORITY(irq);
+  shift = ICOLL_PRIO_SHIFT(irq);
+
+  reg  = getreg32(addr);
+  reg &= ~(ICOLL_PRIO_ENABLE << shift);
+  putreg32(reg, addr);
+}
+
+void up_enable_irq(int irq)
+{
+  uint32_t addr;
+  uint32_t shift;
+  uint32_t reg;
+
+  DEBUGASSERT((unsigned)irq < NR_IRQS);
+
+  addr  = STMP3770_ICOLL_PRIORITY(irq);
+  shift = ICOLL_PRIO_SHIFT(irq);
+
+  reg  = getreg32(addr);
+  reg &= ~((uint32_t)ICOLL_PRIO_MASK << shift);
+  reg |= (ICOLL_PRIO_ENABLE << shift);
+  putreg32(reg, addr);
+}
+
+/****************************************************************************
+ * Name: arm_ack_irq
+ *
+ * Description:
+ *   释放某个源占用的优先级电平。
+ *
+ *   调用时机很重要：必须在源本身被清除**之后**调用。
+ *   如果在清源之前释放，控制器立刻会重新选出同一个仍然挂起的源，
+ *   变成中断风暴。因此这个函数由 arm_decodeirq() 在 irq_dispatch()
+ *   返回之后调用，而不是像多数 port 那样在分发之前。
+ ****************************************************************************/
+
+void arm_ack_irq(int irq)
+{
+  uint32_t addr;
+  uint32_t shift;
+  uint32_t level;
+
+  DEBUGASSERT((unsigned)irq < NR_IRQS);
+
+  addr  = STMP3770_ICOLL_PRIORITY(irq);
+  shift = ICOLL_PRIO_SHIFT(irq);
+  level = (getreg32(addr) >> shift) & 0x3;
+
+  putreg32(1u << level, STMP3770_ICOLL_LEVELACK);
+}
+
+int up_prioritize_irq(int irq, int priority)
+{
+  uint32_t addr;
+  uint32_t shift;
+  uint32_t reg;
+
+  DEBUGASSERT((unsigned)irq < NR_IRQS && priority >= 0 && priority <= 3);
+
+  addr  = STMP3770_ICOLL_PRIORITY(irq);
+  shift = ICOLL_PRIO_SHIFT(irq);
+
+  reg  = getreg32(addr);
+  reg &= ~(0x3 << shift);
+  reg |= ((uint32_t)priority << shift);
+  putreg32(reg, addr);
+
+  return OK;
+}
diff --git a/arch/arm/src/stmp3770/stmp3770_kbd.c b/arch/arm/src/stmp3770/stmp3770_kbd.c
new file mode 100644
index 00000000..13f19144
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_kbd.c
@@ -0,0 +1,221 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_kbd.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HP 39gII 键盘矩阵扫描。
+ *
+ * 硬件结构（从 ExistOS OSLoader/drivers/input/stmp_gpio.c 逐条核对，
+ * 并与 EmuGII 的 stmp3770_pinctrl.c 电气模型一致）：
+ *
+ *   - 11 行 × 5 列，行由 GPIO 推挽输出拉低，列由 GPIO 输入读回（低有效）。
+ *   - 键码 = (row << 3) | col，row 0..10，col 0..4。
+ *   - 行线不连续，跨了三个 GPIO bank；第 5 行在 bank1、第 8 行在 bank0，
+ *     其余 8 行都在 bank2。这就是 ExistOS 里那串 case 的由来。
+ *   - 第 10 行只有 ON/C 一个键，它不是被驱动的行线，
+ *     而是一根独立的输入（bank0 pin14，按下为高）。
+ *
+ * 扫描一次 = 逐个把一行拉低，然后读 5 根列线。约 50 次 GPIO 访问，
+ * 在 24 MHz 上不到 10 µs，20 ms 周期扫描的开销可以忽略。
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#include <nuttx/debug.h>
+
+#include "arm_internal.h"
+#include "chip.h"
+#include "stmp3770.h"
+
+#ifdef CONFIG_STMP3770_KBD
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* 行线：(bank, pin)。行 5 与行 8 不在 bank2，见文件头说明。 */
+
+#define KBD_NROWS 10
+#define KBD_NCOLS 5
+
+static const uint8_t g_row_bank[KBD_NROWS] =
+{
+  2, 2, 2, 2, 2, 1, 2, 2, 0, 2
+};
+
+static const uint8_t g_row_pin[KBD_NROWS] =
+{
+  6, 5, 4, 2, 3, 24, 8, 7, 20, 14
+};
+
+/* 列线全部在 bank 1 */
+
+static const uint8_t g_col_pin[KBD_NCOLS] = { 23, 25, 27, 26, 22 };
+
+/* ON/C 是独立输入：bank0 pin14，按下为高 */
+
+#define KBD_ON_BANK 0
+#define KBD_ON_PIN  14
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+/* 每行的 DOUT/DOE 地址与位掩码，初始化时一次算好，扫描时不用再查表 */
+
+static uintptr_t g_row_dout[KBD_NROWS];
+static uintptr_t g_row_doe[KBD_NROWS];
+static uint32_t  g_row_mask[KBD_NROWS];
+
+static uintptr_t g_col_din[KBD_NCOLS];
+static uint32_t  g_col_mask[KBD_NCOLS];
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/* PINCTRL 每个 bank 一组寄存器，组间距 0x10。
+ * 注意 DIN 在 DOE 之前：DOUT=0x400、DIN=0x500、DOE=0x600。
+ */
+
+#define PINCTRL_DOUT(bank) (STMP3770_PINCTRL_BASE + 0x400 + (uintptr_t)(bank) * 0x10)
+#define PINCTRL_DIN(bank)  (STMP3770_PINCTRL_BASE + 0x500 + (uintptr_t)(bank) * 0x10)
+#define PINCTRL_DOE(bank)  (STMP3770_PINCTRL_BASE + 0x600 + (uintptr_t)(bank) * 0x10)
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void stmp3770_kbd_initialize(void)
+{
+  uint32_t reg;
+  int i;
+
+  /* 1. 把所有键位引脚切到 GPIO 功能（MUXSEL = 3）。
+   *
+   *    ExistOS 是逐个 BF_CS1(PINCTRL_MUXSELx, PINxx, 3) 写的，
+   *    这里按同样的引脚逐个设置，保持与真机一致。
+   */
+
+  /* bank1 pin22..27 —— 5 根列线 + 第 5 行 */
+
+  reg  = getreg32(STMP3770_PINCTRL_BASE + 0x130);          /* MUXSEL3 */
+  reg &= ~((3u << 12) | (3u << 14) | (3u << 16) | (3u << 18) |
+           (3u << 20) | (3u << 22));                     /* pin22..27 */
+  reg |=  ((3u << 12) | (3u << 14) | (3u << 16) | (3u << 18) |
+           (3u << 20) | (3u << 22));
+  putreg32(reg, STMP3770_PINCTRL_BASE + 0x130);
+
+  /* bank2 pin02..08 与 pin14 —— 8 根行线 + 1 根 */
+
+  reg  = getreg32(STMP3770_PINCTRL_BASE + 0x140);          /* MUXSEL4 */
+  reg |= ((3u << 4) | (3u << 6) | (3u << 8) | (3u << 10) |
+          (3u << 12) | (3u << 14) | (3u << 16) | (3u << 28));
+  putreg32(reg, STMP3770_PINCTRL_BASE + 0x140);
+
+  /* bank0 pin14（ON/C）与 pin20（第 8 行） */
+
+  reg  = getreg32(STMP3770_PINCTRL_BASE + 0x100);          /* MUXSEL0 */
+  reg |= (3u << 28);                                       /* pin14 */
+  putreg32(reg, STMP3770_PINCTRL_BASE + 0x100);
+
+  reg  = getreg32(STMP3770_PINCTRL_BASE + 0x110);          /* MUXSEL1 */
+  reg |= (3u << 8);                                        /* pin20 */
+  putreg32(reg, STMP3770_PINCTRL_BASE + 0x110);
+
+  /* 2. 列线配成输入：DOUT=1、DOE=0（内部上拉，靠按键拉低） */
+
+  for (i = 0; i < KBD_NCOLS; i++)
+    {
+      uintptr_t dout = PINCTRL_DOUT(1);
+      uintptr_t doe  = PINCTRL_DOE(1);
+
+      g_col_din[i]  = PINCTRL_DIN(1);
+      g_col_mask[i] = 1u << g_col_pin[i];
+
+      reg = getreg32(dout);
+      reg |= g_col_mask[i];
+      putreg32(reg, dout);
+
+      reg = getreg32(doe);
+      reg &= ~g_col_mask[i];
+      putreg32(reg, doe);
+    }
+
+  /* 3. 行线配成输出，初值全部**输出高**（未选中） */
+
+  for (i = 0; i < KBD_NROWS; i++)
+    {
+      g_row_dout[i] = PINCTRL_DOUT(g_row_bank[i]);
+      g_row_doe[i]  = PINCTRL_DOE(g_row_bank[i]);
+      g_row_mask[i] = 1u << g_row_pin[i];
+
+      reg = getreg32(g_row_dout[i]);
+      reg |= g_row_mask[i];
+      putreg32(reg, g_row_dout[i]);
+
+      reg = getreg32(g_row_doe[i]);
+      reg |= g_row_mask[i];
+      putreg32(reg, g_row_doe[i]);
+    }
+
+  /* 4. ON/C 配成输入 */
+
+  reg = getreg32(PINCTRL_DOUT(KBD_ON_BANK));
+  reg |= (1u << KBD_ON_PIN);
+  putreg32(reg, PINCTRL_DOUT(KBD_ON_BANK));
+
+  reg = getreg32(PINCTRL_DOE(KBD_ON_BANK));
+  reg &= ~(1u << KBD_ON_PIN);
+  putreg32(reg, PINCTRL_DOE(KBD_ON_BANK));
+}
+
+/****************************************************************************
+ * Name: stmp3770_kbd_scan
+ *
+ * Description:
+ *   扫一遍矩阵，把结果写进调用者给的 11×5 位图。
+ *   matrix[row * 5 + col] = 1 表示按下。
+ *
+ *   行是低有效的：把一行拉低，如果该行某个键按下，对应列会被拉低。
+ ****************************************************************************/
+
+void stmp3770_kbd_scan(uint8_t *matrix)
+{
+  uint32_t reg;
+  int row;
+  int col;
+
+  for (row = 0; row < KBD_NROWS; row++)
+    {
+      /* 选中该行：DOUT 清零（拉低） */
+
+      reg = getreg32(g_row_dout[row]);
+      reg &= ~g_row_mask[row];
+      putreg32(reg, g_row_dout[row]);
+
+      /* 读 5 根列线，低有效 */
+
+      for (col = 0; col < KBD_NCOLS; col++)
+        {
+          matrix[row * KBD_NCOLS + col] =
+            (getreg32(g_col_din[col]) & g_col_mask[col]) ? 0 : 1;
+        }
+
+      /* 恢复高电平，避免多行同时被拉低造成误判 */
+
+      reg = getreg32(g_row_dout[row]);
+      reg |= g_row_mask[row];
+      putreg32(reg, g_row_dout[row]);
+    }
+
+  /* 第 10 行只有 ON/C，独立输入、高有效 */
+
+  matrix[10 * KBD_NCOLS + 0] =
+    (getreg32(PINCTRL_DIN(KBD_ON_BANK)) >> KBD_ON_PIN) & 1;
+}
+
+#endif /* CONFIG_STMP3770_KBD */
