+             BF_RD(LCDIF_CTRL1, OVERFLOW_IRQ),
+             BF_RD(LCDIF_CTRL1, UNDERFLOW_IRQ));
+        BF_CLR(LCDIF_CTRL1, OVERFLOW_IRQ);
+        BF_CLR(LCDIF_CTRL1, UNDERFLOW_IRQ);
