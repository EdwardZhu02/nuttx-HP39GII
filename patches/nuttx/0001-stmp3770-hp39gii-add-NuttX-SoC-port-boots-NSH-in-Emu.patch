+/* APBH 上电与通道放行
+ *
+ * APBH 复位后 CTRL0 = SFTRST | CLKGATE，并且每个通道还各自被
+ * CLKGATE_CHANNEL / RESET_CHANNEL / FREEZE_CHANNEL 三位按住。
+ * 这三位（连同全局的 SFTRST/CLKGATE）只要有一位没清，通道就**根本不会执行**，
+ * 而 CHn_DEBUG2 又恰好读 0，于是 LCDIF_checkDMAFin() 立刻返回“已完成”：
+ * 现象是每条命令都“成功”，实际上一个字节都没送出去 —— 面板永远是空白，
+ * 而且没有任何报错。这是移植过程中最隐蔽的一个坑。
+ */
+
+static void LCDIF_APBHPowerUp(void) {
+    int i;
+
+    /* STMP 的 SFTRST/CLKGATE 握手：置 SFTRST，等硬件把 CLKGATE 也拉高，
+     * 再一起清掉。上界保护，避免异常芯片上死等。 */
+
+    BF_SET(APBH_CTRL0, SFTRST);
+
+    for (i = 0; i < 100000; i++) {
+        if (BF_RD(APBH_CTRL0, CLKGATE)) break;
+    }
+
+    BF_CLR(APBH_CTRL0, SFTRST);
+    BF_CLR(APBH_CTRL0, CLKGATE);
+
+    /* 放行通道 0：先解除时钟门控，再解除复位与冻结 */
+
+    BF_CLRV(APBH_CTRL0, CLKGATE_CHANNEL, 0x1);
+    BF_CLRV(APBH_CTRL0, FREEZE_CHANNEL, 0x1);
+    BF_CLRV(APBH_CTRL0, RESET_CHANNEL, 0x1);
+}
+
+static void LCDIF_EnableDMAChannel(bool enable) {
