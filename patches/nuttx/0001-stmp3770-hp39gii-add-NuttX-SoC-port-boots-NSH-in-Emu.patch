diff --git a/arch/arm/include/stmp3770/irq.h b/arch/arm/include/stmp3770/irq.h
new file mode 100644
index 00000000..199727e3
--- /dev/null
+++ b/arch/arm/include/stmp3770/irq.h
@@ -0,0 +1,96 @@
+/****************************************************************************
+ * arch/arm/include/stmp3770/irq.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * STMP3770 / HP 39gII 中断号。
+ *
+ * 本文件只通过 nuttx/irq.h 间接包含，不要直接 include。
+ *
+ * 编号以 EmuGII 的 STMP3770 机型定义（Chapter 5 Interrupt Collector）为准，
+ * 与 ExistOS 的 hw_irq.h、以及 Phase-0 在真机上读到的 ICOLL 行为一致。
+ *
+ * 两个曾经的错误，记在这里以免重犯：
+ *
+ *   - 早先把 0 号源写成“保留”，其实它就是 **DBGUART**，也就是控制台。
+ *     CONFIG_UART0_IRQ=0 是对的，不是巧合。
+ *   - NR_IRQS 曾写成 65，多出的 64 号并不存在：
+ *     ICOLL 只有 0..63。而 PRIORITY(64) 的地址算出来是 0x160，
+ *     正好是 **VBASE** 寄存器 —— 打开/关闭中断时会顺手把向量表基址写坏。
+ ****************************************************************************/
+
+#ifndef __ARCH_ARM_INCLUDE_STMP3770_IRQ_H
+#define __ARCH_ARM_INCLUDE_STMP3770_IRQ_H
+
+#define STMP3770_IRQ_DBGUART         0   /* 调试串口 / 控制台 */
+#define STMP3770_IRQ_JTAG            1
+#define STMP3770_IRQ_SSP2_ERROR      2
+#define STMP3770_IRQ_VDD5V           3
+#define STMP3770_IRQ_HEADPHONE       4
+#define STMP3770_IRQ_DAC_DMA         5
+#define STMP3770_IRQ_DAC_ERROR       6
+#define STMP3770_IRQ_ADC_DMA         7
+#define STMP3770_IRQ_ADC_ERROR       8
+#define STMP3770_IRQ_SPDIF_DMA       9
+#define STMP3770_IRQ_SPDIF_ERROR     10
+#define STMP3770_IRQ_USB             11
+#define STMP3770_IRQ_USB_WAKEUP      12
+#define STMP3770_IRQ_GPMI_DMA        13
+#define STMP3770_IRQ_SSP1_DMA        14
+#define STMP3770_IRQ_SSP1_ERROR      15
+#define STMP3770_IRQ_GPIO0           16
+#define STMP3770_IRQ_GPIO1           17
+#define STMP3770_IRQ_GPIO2           18
+#define STMP3770_IRQ_SAIF1_DMA       19
+#define STMP3770_IRQ_SSP2_DMA        20
+#define STMP3770_IRQ_ECC8            21
+#define STMP3770_IRQ_RTC_ALARM       22
+#define STMP3770_IRQ_UART_TX_DMA     23
+#define STMP3770_IRQ_UART_ERROR      24
+#define STMP3770_IRQ_UART_RX_DMA     25
+#define STMP3770_IRQ_I2C_DMA         26
+#define STMP3770_IRQ_I2C_ERROR       27
+#define STMP3770_IRQ_TIMER0          28
+#define STMP3770_IRQ_TIMER1          29
+#define STMP3770_IRQ_TIMER2          30
+#define STMP3770_IRQ_TIMER3          31
+#define STMP3770_IRQ_BATT_BRNOUT     32
+#define STMP3770_IRQ_VDDD_BRNOUT     33
+#define STMP3770_IRQ_VDDIO_BRNOUT    34
+#define STMP3770_IRQ_VDD18_BRNOUT    35
+#define STMP3770_IRQ_TOUCH           36
+#define STMP3770_IRQ_LRADC_CH0       37
+#define STMP3770_IRQ_LRADC_CH1       38
+#define STMP3770_IRQ_LRADC_CH2       39
+#define STMP3770_IRQ_LRADC_CH3       40
+#define STMP3770_IRQ_LRADC_CH4       41
+#define STMP3770_IRQ_LRADC_CH5       42
+#define STMP3770_IRQ_LRADC_CH6       43
+#define STMP3770_IRQ_LRADC_CH7       44
+#define STMP3770_IRQ_LCDIF_DMA       45
+#define STMP3770_IRQ_LCDIF_ERROR     46
+#define STMP3770_IRQ_DIGCTL_TRAP     47
+#define STMP3770_IRQ_RTC_1MSEC       48
+#define STMP3770_IRQ_DRI_DMA         49
+#define STMP3770_IRQ_DRI_ERROR       50
+#define STMP3770_IRQ_GPMI_ERROR      51
+#define STMP3770_IRQ_IRDA            52
+#define STMP3770_IRQ_DCP_VMI         53
+#define STMP3770_IRQ_DCP             54
+
+/* 55..63 在 EmuGII 里没有建模，命名沿用 ExistOS，仅供占位 */
+
+#define STMP3770_IRQ_BCH             56
+#define STMP3770_IRQ_PXP             57
+#define STMP3770_IRQ_UARTAPP2_TX_DMA 58
+#define STMP3770_IRQ_UARTAPP2        59
+#define STMP3770_IRQ_UARTAPP2_RX_DMA 60
+#define STMP3770_IRQ_VDAC_DETECT     61
+#define STMP3770_IRQ_SYDMA           62
+#define STMP3770_IRQ_SY              63
+
+/* ICOLL 只有 64 个源：0..63 */
+
+#define NR_IRQS                      64
+
+#endif /* __ARCH_ARM_INCLUDE_STMP3770_IRQ_H */
diff --git a/arch/arm/src/stmp3770/Kconfig b/arch/arm/src/stmp3770/Kconfig
new file mode 100644
index 00000000..2be83519
--- /dev/null
+++ b/arch/arm/src/stmp3770/Kconfig
@@ -0,0 +1,69 @@
+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+# 注意：ARCH_CHIP_STMP3770 由 arch/arm/Kconfig 的 chip choice 声明，
+# 这里不能再声明一次（会造成 Kconfig 递归依赖）。
+#
+
+comment "STMP3770 Configuration Options"
+
+if ARCH_CHIP_STMP3770
+
+config STMP3770_UARTDBG_SERIAL
+	bool "Debug UART (PL011) as console"
+	default n
+	---help---
+		debug UART 位于 0x8007_0000，Phase-0 实测确认为 PL011 寄存器面
+		（CR=0x0101 / FR=0x0090 / PeriphID0=0x11）。
+		注意：39gII 没有外露串口引脚，该口只能用于内部调试或经夹具引出。
+
+config STMP3770_UARTDBG_BAUD
+	int "Debug UART baud"
+	default 115200
+	depends on STMP3770_UARTDBG_SERIAL
+
+config STMP3770_TIMER_FREQ
+	int "TIMROT input clock (Hz)"
+	default 32768
+	---help---
+		TIMROT 通道的时钟源频率。Phase-0 实测 VERSION=0x01010000
+		对应 TIMROT v1，32kHz XTAL 的 SELECT 值为 0x8。
+
+config STMP3770_LCD
+	bool "LCDIF display"
+	default n
+
+config STMP3770_LCD_INIT
+	bool "Initialise the panel at boot"
+	default n
+	depends on STMP3770_LCD
+	---help---
+		启动时初始化 256x127 单色面板（8080/DBI 8-bit，经 APBH DMA）。
+		本板没有外露串口，面板是唯一的可见输出，所以这是 bring-up 的关键一步。
+
+config STMP3770_KBD
+	bool "Keyboard matrix"
+	default n
+	---help---
+		HP 39gII 的 11x5 键盘矩阵（GPIO 扫描）。行线跨 bank0/1/2，
+		键码 = (row << 3) | col，与 ExistOS 一致。
+
+config STMP3770_KBD_ECHO
+	bool "Echo translated keys to the debug UART"
+	default y
+	depends on STMP3770_KBD
+	---help---
+		把每个按键翻译出的字符直接写到 debug UART（轮询，不依赖驱动栈）。
+		bring-up 阶段用来逐键核对「扫描 → 键码 → 字符」是否正确。
+
+config STMP3770_KBD_CONSOLE
+	bool "Feed translated keys into the console"
+	default n
+	depends on STMP3770_KBD
+	---help---
+		把字符注入控制台的接收缓冲，目标是把 NSH 变成可交互界面。
+		目前实测字符确实进入了 recv 缓冲、recvsem 也有等待者，
+		但 NSH 既不回显也不解析，原因未定位，因此默认关闭。
+
+endif # ARCH_CHIP_STMP3770
diff --git a/arch/arm/src/stmp3770/Make.defs b/arch/arm/src/stmp3770/Make.defs
new file mode 100644
index 00000000..31f33ee9
--- /dev/null
+++ b/arch/arm/src/stmp3770/Make.defs
@@ -0,0 +1,31 @@
+############################################################################
+# arch/arm/src/stmp3770/Make.defs
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+# HP 39gII / STMP3770 (ARM926EJ-S, ARMv5TE)
+############################################################################
+
+include arm/Make.defs
+
+CFLAGS += -Wno-array-bounds
+
+# 移植自 ExistOS 的 Freescale 寄存器头在 hw/ 子目录
+CFLAGS += -I$(TOPDIR)/arch/arm/src/stmp3770/hw
+
+CHIP_ASRCS  =
+
+CHIP_CSRCS  = stmp3770_boot.c stmp3770_irq.c stmp3770_decodeirq.c
+CHIP_CSRCS += stmp3770_lowputc.c stmp3770_clkctrl.c stmp3770_allocateheap.c
+
+ifneq ($(CONFIG_SCHED_TICKLESS),y)
+CHIP_CSRCS += stmp3770_timerisr.c
+endif
+
+ifeq ($(CONFIG_STMP3770_LCD),y)
+CHIP_CSRCS += stmp3770_lcd.c
+endif
+
+ifeq ($(CONFIG_STMP3770_KBD),y)
+CHIP_CSRCS += stmp3770_kbd.c
+endif
diff --git a/arch/arm/src/stmp3770/STATUS.md b/arch/arm/src/stmp3770/STATUS.md
new file mode 100644
index 00000000..4de23199
--- /dev/null
+++ b/arch/arm/src/stmp3770/STATUS.md
@@ -0,0 +1,114 @@
+# STMP3770 NuttX port — 进度快照
+
+更新时间：2026-11-01（第二轮）
+
+## 当前状态：NSH + 中断 + 节拍 + 面板显示 全部打通
+
+```
+$ qemu-system-arm -M stmp3770 -display none -serial file:/tmp/s.log -bios nuttx.bin
+[NUTTX-UART-OK]
+
+NuttShell (NSH)
+nsh> [LCD] interface init
+[LCD] device init
+LCD ID[0]:00
+LCD ID[1]:80
+LCD ID[2]:00
+[LCD] frame test
+[LCD] ready
+```
+
+```
+text 148096  data 884  bss 4436  ≈ 150 KB (29% of 512 KB)
+入口 0x0    nuttx.sb 可经 SDP 载入
+```
+
+面板上三条实心横条由 NuttX 自己画出，已用 `screendump` 截图确认。
+
+## 第二轮修掉的 6 个 bug
+
+这一轮的关键发现是：**这套 port 此前从来没有收到过一个中断**，
+所有"能跑"的部分全靠轮询和阻塞等待。修好中断之后，
+串口、时钟节拍、休眠、超时才第一次真正成立。
+
+| # | 现象 | 根因 | 修法 |
+|---|---|---|---|
+| 1 | 板级目录解析到 `TOPDIR/src`，`board.h` 找不到 | `ARCH_BOARD_HP39GII` 从未在 `boards/Kconfig` 注册，kconfig 退回到 `ARCH_BOARD_CUSTOM`（名字为空） | 在 `boards/Kconfig` 里补 `config ARCH_BOARD_HP39GII` + `default "hp39gii" if ...` + `source` 块；`arch/arm/Kconfig` 补 `default "stmp3770" if ARCH_CHIP_STMP3770` |
+| 2 | **一次中断都收不到**（`-d int` 里只有 SVC） | `ICOLL_CTRL_IRQ_FINAL_EN` 写成了 `(1<<1)`——那是 **FIQ** 使能。更糟的是 `up_irqinitialize()` 直接 `putreg32()` 覆盖整个 CTRL，把复位值里已置位的 bit16（IRQ_FINAL_ENABLE）和 SFTRST/CLKGATE 一起冲掉了 | IRQ 最终输出是 **bit16**、FIQ 是 bit17、ARM_RSE 是 bit18；先用 CLR 别名清 SFTRST/CLKGATE，再读-改-写置 bit16\|bit18 |
+| 3 | 修好 #2 后第一次中断就 Undefined Instruction | `arm_decodeirq()` 返回了 NULL。`arm_vectorirq` 的返回路径是 `mov sp, r0` 再从 sp 弹栈，于是 sp=0，把 0 号地址（向量表）当栈帧读，一跳就飞 | 返回值必须是"要恢复的上下文"：没有切换就返回入参 regs，发生切换就返回新任务的 `xcp.regs`（照 `arm/arm_doirq.c` 的写法） |
+| 4 | `clock_systime_ticks()` 恒为 0，`sleep()`/`usleep()` 永不返回，所有超时失效 | TIMROT 的 `ROTCTRL` 复位值是 `SFTRST\|CLKGATE`，`up_timer_initialize()` 从不清这两位，**计数器根本不动** | 按 STMP 握手清：置 SFTRST → 轮询 CLKGATE=1 → 清 SFTRST+CLKGATE → 轮询 CLKGATE=0；并清掉旋转解码器输入源 |
+| 5 | LCD 面板 ID 读出来是 `da/00/00`（真实值应为 `00/80/00`），画帧"成功"但屏幕全白 | **APBH 通道从未执行**。APBH `CTRL0` 复位值 = `SFTRST\|CLKGATE`，通道 0 还被 `CLKGATE_CHANNEL`/`RESET_CHANNEL`/`FREEZE_CHANNEL` 三位按住。而 `CHn_DEBUG2` 恰好读 0，于是 `LCDIF_checkDMAFin()` 立刻判"已完成"——每条命令都静默失败 | 新增 `LCDIF_APBHPowerUp()`：清 SFTRST/CLKGATE，再放过通道 0 的三位；并把 `portDispDeviceInit()` 里"先使能后复位"的顺序改成"先复位后使能" |
+| 6 | `NR_IRQS=65`，但 ICOLL 只有 0..63 | `PRIORITY(64)` 算出来是 `0x60 + 16*0x10 = 0x160`，正好是 **VBASE** 寄存器；开关中断会顺手把向量表基址写坏 | `NR_IRQS=64`，删掉不存在的 64 号；中断号表按 EmuGII 的 Chapter 5 定义重排（0 号是 DBGUART，即控制台，所以 `CONFIG_UART0_IRQ=0` 是对的） |
+
+另外两个非 bug 但值得记的改动：
+
+- LCD 初始化从 `board_late_initialize()` 的直接调用改成独立内核线程
+  （优先级低于 NSH，先起 shell 再初始化面板；面板 reset 到 display-on 有 820 ms 长延时，
+  塞在启动路径里会把整个系统拖住）。
+- 内核线程没有 stdout，`printf` 会被静默丢弃；早期调试统一用 `up_lowputc()`（轮询 debug UART）。
+
+## 验证手段（这一轮靠它们定位）
+
+```bash
+# 有没有中断
+qemu ... -d int -D /tmp/int.log
+grep -c "Taking exception 5 \[IRQ\]" /tmp/int.log
+
+# 卡在哪
+qemu ... -monitor unix:/tmp/mon.sock,server,nowait
+echo "info registers" | socat - UNIX-CONNECT:/tmp/mon.sock
+
+# 面板到底画出来没有（screendump 在 -display none 下不刷新，
+# 必须挂一个显示后端，例如 -vnc 127.0.0.1:9，否则拿到的是首帧）
+qemu ... -vnc 127.0.0.1:9 -monitor unix:/tmp/mon.sock,server,nowait
+# (qemu) screendump /tmp/lcd.ppm
+```
+
+`-display none` 的坑值得单独说：EmuGII 的 `-M stmp3770` 会把整台计算器画到显示表面上，
+但**没有 DisplayChangeListener 时表面不会刷新**，`screendump` 拿到的是首帧，
+看起来永远是一块空白面板。加上 `-vnc 127.0.0.1:9` 之后才拍到真实画面。
+
+## 键盘驱动（2026-11-01 第三轮）
+
+键盘矩阵已落地：
+
+- `arch/arm/src/stmp3770/stmp3770_kbd.c`：11x5 GPIO 扫描 + ON/C 独立输入。
+  行/列引脚与 EmuGII `stmp3770_pinctrl.c`（`hp39gii_key_rows`/`col_pins`）逐条核对一致；
+  键码 `(row<<3)|col` 与 ExistOS/真机一致。
+- `boards/arm/stmp3770/hp39gii/src/hp39gii_kbd.c`：去抖 + 键码->ASCII（ALPHA/SHIFT
+  一次性修饰键，字母表来自真机键帽丝印）+ 投递。
+
+两种投递方式（现在可同时开启，不再互斥；`kbd_put` 已重构为 `kbd_deliver`）：
+
+| 配置 | 行为 | 状态 |
+|---|---|---|
+| `STMP3770_KBD_ECHO` | 字符直接写到 debug UART（`up_putc`，轮询，不经驱动栈） | 可验证 |
+| `STMP3770_KBD_CONSOLE` | 字符注入控制台接收缓冲，让 NSH 可交互 | 已通 |
+
+**「控制台注入不响应」根因已找到并修复**：QEMU 逐层 trace 定位到
+`dev->isconsole == 0`、`tc_lflag/tc_iflag == 0`，即 `uart_register()` 从没初始化
+ECHO/ICANON/ICRNL，`uart_readv` 因此走 raw 路径（不回显、不拼行）。
+根因：板级 `arm_serialinit()` 只调了 `pl011_serialinit()`（注册），漏了
+`pl011_earlyserialinit()`（置 `isconsole=true` + 配置 UART 硬件）。
+修法：`arm_serialinit()` 先 `pl011_earlyserialinit()` 再 `pl011_serialinit()`。
+修好后注入 `hello\r` 实测 NSH 正确回显并解析：`hello` / `nsh: hello: command not found`。
+
+## 下一步
+
+1. ~~键盘矩阵~~ ✅ 扫描/翻译/ECHO 验证 + 控制台注入回显/解析全部打通
+2. LCDIF 的 ISR（`STMP3770_IRQ_LCDIF_DMA` 源 45），把帧写入的轮询判完成换成信号量
+3. 面板像素对齐：现在横条内部有细碎噪点，怀疑是每行只写 256 字节、面板实际 258 列
+4. GPMI + ECC8 NAND（最难）
+5. 真机验证：`nuttx.sb` 经 SDP 载入（真机无外露串口，需要先有面板输出——现在已经有了）
+
+## 环境备忘
+
+- `qemu-system-arm -M stmp3770 -bios <bin>` + `-d int` + `-monitor` 是本项目唯一可行的调试手段
+- 改 EmuGII 的模型源码后必须 `cp src/... ThirdParty/qemu/...` 再 `ninja`，
+  直接改 `ThirdParty/` 会在下次 overlay 时被覆盖
+- `kconfig-conf --olddefconfig` 在本树里会因 `boards/dummy/Kconfig` 递归自包含而失败，
+  改 `.config` 后用 `make` 直接重建即可
+- `clean_context` 会删掉 `include/nuttx/config.h` 和 `include/arch/board` 等符号链接；
+  若 `arch/arm/src/board` 指向错误路径，检查 `.config` 里的 `CONFIG_ARCH_BOARD` / `CONFIG_ARCH_CHIP` 字符串
+- 板级 `src/Makefile` 的 CSRCS 仍是硬编码的
+- 改了头文件依赖后要 `touch` 源文件强制重编
diff --git a/arch/arm/src/stmp3770/board_up.h b/arch/arm/src/stmp3770/board_up.h
new file mode 100644
index 00000000..0381e262
--- /dev/null
+++ b/arch/arm/src/stmp3770/board_up.h
@@ -0,0 +1,82 @@
+/* 兼容垫片：为原样移植的 ExistOS LCD 驱动提供最小依赖 */
+#ifndef __STMP3770_COMPAT_BOARD_UP_H
+#define __STMP3770_COMPAT_BOARD_UP_H
+
+#include <nuttx/config.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <nuttx/irq.h>
+#include <nuttx/arch.h>
+
+#include "hw/regs.h"
+#include "hw/regsdigctl.h"
+
+static inline void portDelayus(uint32_t us)
+{
+  uint32_t start = HW_DIGCTL_MICROSECONDS_RD();
+  while ((HW_DIGCTL_MICROSECONDS_RD() - start) < us)
+    {
+    }
+}
+
+static inline void portEnableIRQ(unsigned int irq, bool en)
+{
+  if (en)
+    {
+      up_enable_irq((int)irq);
+    }
+  else
+    {
+      up_disable_irq((int)irq);
+    }
+}
+
+
+/* 移植自 ExistOS drivers/stmp_board.c */
+
+static inline uint64_t nsToCycles(uint64_t nstime, uint64_t period,
+                                  uint64_t min)
+{
+  uint64_t k = (nstime + period - 1) / period;
+  return (k > min) ? k : min;
+}
+
+/* 移植自 ExistOS HAL/board_up.c，超时参数单位是「轮次」而非 tick */
+
+static inline bool driverWaitTrueF(bool (*f)(void), uint32_t timeout)
+{
+  while ((*f)() == false)
+    {
+      portDelayus(1);
+      if (timeout >= 1)
+        {
+          timeout -= 1;
+        }
+      else
+        {
+          return true;
+        }
+    }
+
+  return false;
+}
+
+static inline bool driverWaitFalseF(bool (*f)(void), uint32_t timeout)
+{
+  while ((*f)() == true)
+    {
+      portDelayus(1);
+      if (timeout >= 1)
+        {
+          timeout -= 1;
+        }
+      else
+        {
+          return true;
+        }
+    }
+
+  return false;
+}
+
+#endif
