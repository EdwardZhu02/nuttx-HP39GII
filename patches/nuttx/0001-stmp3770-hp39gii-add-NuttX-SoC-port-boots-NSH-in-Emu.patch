diff --git a/arch/arm/src/stmp3770/stmp3770.h b/arch/arm/src/stmp3770/stmp3770.h
new file mode 100644
index 00000000..6221b92f
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770.h
@@ -0,0 +1,40 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770.h
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * STMP3770 内部头：ICOLL 位定义。中断号在 arch/arm/include/stmp3770/irq.h。
+ ****************************************************************************/
+
+#ifndef __ARCH_ARM_SRC_STMP3770_STMP3770_H
+#define __ARCH_ARM_SRC_STMP3770_STMP3770_H
+
+#include <nuttx/config.h>
+#include <arch/chip/irq.h>
+
+#include "chip.h"
+#include "stmp3770_memorymap.h"
+
+/* ICOLL PRIORITY 寄存器内每个中断占 8 位：
+ *   bit[1:0] 优先级, bit[2] ENABLE, bit[3] FIQ
+ * 布局与 i.MX23/28 一致；Phase-0 §8#10 列为待核项，
+ * 首次 bring-up 若中断无响应，优先怀疑这里。
+ */
+
+#define ICOLL_PRIO_SHIFT(n)      (((n) & 3) * 8)
+#define ICOLL_PRIO_ENABLE        (1 << 2)
+#define ICOLL_PRIO_FIQ           (1 << 3)
+
+#define ICOLL_CTRL_FIQ_FINAL_EN  (1 << 0)
+#define ICOLL_CTRL_IRQ_FINAL_EN  (1 << 1)
+
+/* 板级初始化钩子（由 arch/arm/src/stmp3770/stmp3770_boot.c 调用） */
+
+void stmp3770_boardinitialize(void);
+
+#ifdef CONFIG_STMP3770_KBD
+void stmp3770_kbd_initialize(void);
+void stmp3770_kbd_scan(FAR uint8_t *matrix);
+#endif
+
+#endif /* __ARCH_ARM_SRC_STMP3770_STMP3770_H */
diff --git a/arch/arm/src/stmp3770/stmp3770_allocateheap.c b/arch/arm/src/stmp3770/stmp3770_allocateheap.c
