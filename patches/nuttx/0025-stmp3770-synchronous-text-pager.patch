diff --git a/arch/arm/src/stmp3770/Kconfig b/arch/arm/src/stmp3770/Kconfig
index 92827850..5929d9b3 100644
--- a/arch/arm/src/stmp3770/Kconfig
+++ b/arch/arm/src/stmp3770/Kconfig
@@ -64,6 +64,31 @@ config STMP3770_MMU
 		CONFIG_ARM_DCACHE_DISABLE set until the DMA paths have been checked
 		for cache maintenance.
 
+config STMP3770_PAGING
+	bool "On-demand paging of code from NAND"
+	default n
+	depends on STMP3770_MMU
+	---help---
+		Map 3.5 MB of virtual address space as a coarse-page window backed by
+		a blob on NAND.  The first access to a page takes a translation fault
+		and stmp3770_pagefault() maps a frame and reads the page in, right in
+		the abort handler (the NAND driver polls, so no interrupts and no task
+		switch are needed).
+
+		This is deliberately not NuttX CONFIG_LEGACY_PAGING: that framework
+		blocks the faulting task and switches to a worker from inside the
+		abort handler, which this port does not survive.
+
+config STMP3770_PAGETEST
+	bool "Paging self-test at boot"
+	default n
+	depends on STMP3770_PAGING
+	---help---
+		Write 896 four-KB records to NAND blocks 5..32 and call every one of
+		them through the paged window.  This erases those blocks on every
+		boot, which is fine on a scratch unit and destructive on a stock one
+		-- keep a nanddump first.
+
 config STMP3770_KBD
 	bool "Keyboard matrix"
 	default n
