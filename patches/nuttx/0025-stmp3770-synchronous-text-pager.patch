--- a/arch/arm/src/common/arm_internal.h
+++ b/arch/arm/src/common/arm_internal.h
@@ -371,15 +371,15 @@ uint32_t *arm_undefinedinsn(uint32_t *regs);
 #ifdef CONFIG_LEGACY_PAGING
 void arm_pginitialize(void);
 uint32_t *arm_va2pte(uintptr_t vaddr);
-void arm_dataabort(uint32_t *regs, uint32_t far, uint32_t fsr);
