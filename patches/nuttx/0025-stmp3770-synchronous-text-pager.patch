From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: edwardzhu02 <explodingtnt@foxmail.com>
Subject: [PATCH] stmp3770: synchronous text pager, 888/888 paged calls pass

Adds the machinery for running code out of a 3.5 MB window backed by NAND,
and it works: the self-test writes 896 four-KB records to NAND, calls every
one through the window and gets the right index back from all 888 of them
(8 pages are pinned for the page tables) with 16 frames, so 872 replacements
happen on the way.

How it works:

  - stmp3770_map_paged() builds four coarse tables for sections 0..3: the
    locked image is identity mapped, the data region is mapped from
    STMP3770_DATA_VBASE to STMP3770_DATA_PBASE, and the rest of the window
    stays invalid.  The page tables sit inside the address range of the
    window, so those pages are pinned identity (window pages 60..67).
  - stmp3770_pagefault() is called from both abort handlers.  It maps a frame,
    reads the page from NAND through the GPMI MTD and returns, so the faulting
    instruction is simply retried.  No task switch and no worker thread: the
    NAND path polls hardware, so it runs with interrupts disabled, and this
    port has never survived the blocking model in sched/paging.

Two upstream bugs had to be fixed for the return path to work at all, and
they are worth knowing about because they only bite when a fault handler
returns instead of panicking:

  - arm_vectordata and arm_vectorprefetch switch back to ABT mode after the
    handler and then read the saved context through sp -- but sp in ABT mode
    was set to 0x9F at vector entry, so the restore read from address 0x9F and
    took an alignment fault.  arm_vectorsvc already does "mov sp, r0" after
    its mode switch; the abort vectors were missing it.
  - the abort handlers therefore have to return the context pointer, so
    arm_dataabort() and arm_prefetchabort() return uint32_t * now.

The paged window is off by default (CONFIG_STMP3770_PAGING) because enabling
it stops the LCD console from updating: the panel keeps showing the bring-up
marker drawn before the MMU came on, while LCDIF registers still read back
sane (0x00060000) and the console's puts path runs.  The self-test itself
prints to the serial port and passes.  Until that is understood, the default
build keeps the window disabled and boots NSH as before (verified
pixel-identical to the MMU build).


---
diff --git a/arch/Kconfig b/arch/Kconfig
index d328a303..415a99fb 100644
--- a/arch/Kconfig
+++ b/arch/Kconfig
@@ -1134,6 +1134,28 @@ config PAGING_LOCKED_VBASE
 
 endif # PAGING_CUSTOM_BASE
 
+config PAGING_DATA_PBASE
+	hex "Data region physical base"
+	depends on LEGACY_PAGING
+	default 0x0
+	---help---
+		Physical base of the read/write data region.  0 (the default) means
+		"immediately after the physical pages that back the paged text",
+		which is what most boards want.
+
+		Override it when the page tables or other reserved memory sit between
+		the page frames and the data region.
+
+config PAGING_DATA_VBASE
+	hex "Data region virtual base"
+	depends on LEGACY_PAGING
+	default 0x0
+	---help---
+		Virtual base of the read/write data region.  0 (the default) means
+		"immediately after the locked text", i.e. the data region overlaps the
+		paged window.  Any board that actually pages text must override this
+		with an address above the window.
+
 config PAGING_NPPAGED
 	int "Number of physical pages"
 	default 256
diff --git a/arch/arm/src/arm/arm_allocpage.c b/arch/arm/src/arm/arm_allocpage.c
index 2f424a3f..3f627af3 100644
--- a/arch/arm/src/arm/arm_allocpage.c
+++ b/arch/arm/src/arm/arm_allocpage.c
@@ -173,7 +173,7 @@ int up_allocpage(struct tcb_s *tcb, void **vpage)
    */
 
   pgndx = g_pgndx++;
-  if (g_pgndx >= CONFIG_LEGACY_PAGING)
+  if (g_pgndx >= CONFIG_PAGING_NPPAGED)
     {
       g_pgndx  = 0;
       g_pgwrap = true;
diff --git a/arch/arm/src/arm/arm_dataabort.c b/arch/arm/src/arm/arm_dataabort.c
index 48e6f5fd..c8f30154 100644
--- a/arch/arm/src/arm/arm_dataabort.c
+++ b/arch/arm/src/arm/arm_dataabort.c
@@ -35,6 +35,9 @@
 
 #include "sched/sched.h"
 #include "arm_internal.h"
+#ifdef CONFIG_STMP3770_PAGING
+#  include "arm.h"
+#endif
 
 #ifdef CONFIG_LEGACY_PAGING
 #  include <nuttx/page.h>
@@ -68,7 +71,7 @@
  ****************************************************************************/
 
 #ifdef CONFIG_LEGACY_PAGING
-void arm_dataabort(uint32_t *regs, uint32_t far, uint32_t fsr)
+uint32_t *arm_dataabort(uint32_t *regs, uint32_t far, uint32_t fsr)
 {
   struct tcb_s *tcb = this_task();
 #ifdef CONFIG_LEGACY_PAGING
@@ -138,7 +141,7 @@ void arm_dataabort(uint32_t *regs, uint32_t far, uint32_t fsr)
 
   up_set_interrupt_context(savestate);
   tcb->xcp.regs = saveregs;
-  return;
+  return regs;
 
 segfault:
 #endif
@@ -150,10 +153,31 @@ segfault:
 
 #else /* CONFIG_LEGACY_PAGING */
 
-void arm_dataabort(uint32_t *regs)
+uint32_t *arm_dataabort(uint32_t *regs)
 {
   struct tcb_s *tcb = this_task();
 
+#ifdef CONFIG_STMP3770_PAGING
+  /* A translation fault inside the paged window is filled right here, on the
+   * stack of the faulting task.  The NAND path under it is polled, so it does
+   * not need interrupts, and there is no task switch to unwind.
+   */
+
+  {
+    extern bool stmp3770_pagefault(uint32_t far);
+    uint32_t far;
+    uint32_t fsr;
+
+    __asm volatile ("mrc p15, 0, %0, c6, c0, 0" : "=r" (far));
+    __asm volatile ("mrc p15, 0, %0, c5, c0, 0" : "=r" (fsr));
+
+    if ((fsr & FSR_MASK) == FSR_PAGE && stmp3770_pagefault(far))
+      {
+        return regs;
+      }
+  }
+#endif
+
   tcb->xcp.regs = regs;
   up_set_interrupt_context(true);
 
@@ -161,6 +185,7 @@ void arm_dataabort(uint32_t *regs)
 
   _alert("Data abort. PC: %08" PRIx32 "\n", regs[REG_PC]);
   PANIC_WITH_REGS("panic", regs);
+  return regs;
 }
 
 #endif /* CONFIG_LEGACY_PAGING */
diff --git a/arch/arm/src/arm/arm_prefetchabort.c b/arch/arm/src/arm/arm_prefetchabort.c
index d5494e77..3a13a1fe 100644
--- a/arch/arm/src/arm/arm_prefetchabort.c
+++ b/arch/arm/src/arm/arm_prefetchabort.c
@@ -65,10 +65,25 @@
  *
  ****************************************************************************/
 
-void arm_prefetchabort(uint32_t *regs)
+uint32_t *arm_prefetchabort(uint32_t *regs)
 {
   struct tcb_s *tcb = this_task();
 
+#ifdef CONFIG_STMP3770_PAGING
+  /* Same as the data abort: fill the page and let the vector retry the
+   * instruction at regs[REG_PC].
+   */
+
+  {
+    extern bool stmp3770_pagefault(uint32_t far);
+
+    if (stmp3770_pagefault(regs[REG_PC]))
+      {
+        return regs;
+      }
+  }
+#endif
+
 #ifdef CONFIG_LEGACY_PAGING
   uint32_t *saveregs;
   bool savestate;
@@ -127,4 +142,6 @@ void arm_prefetchabort(uint32_t *regs)
       _alert("Prefetch abort. PC: %08" PRIx32 "\n", regs[REG_PC]);
       PANIC_WITH_REGS("panic", regs);
     }
+
+  return regs;
 }
