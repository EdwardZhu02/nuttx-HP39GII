diff --git a/arch/arm/src/stmp3770/stmp3770_allocateheap.c b/arch/arm/src/stmp3770/stmp3770_allocateheap.c
index b8ca9115..e15d5508 100644
--- a/arch/arm/src/stmp3770/stmp3770_allocateheap.c
+++ b/arch/arm/src/stmp3770/stmp3770_allocateheap.c
@@ -25,12 +25,20 @@
 
 
 
+
 void up_allocate_heap(void **heap_start, size_t *heap_size)
 {
   board_autoled_on(LED_HEAPALLOCATE);
 
+#ifdef CONFIG_STMP3770_PAGING
+  /* 分页布局下堆是独立的数据区（虚拟地址与物理地址不同） */
+
+  *heap_start = (void *)(uintptr_t)STMP3770_DATA_VBASE;
+  *heap_size  = (size_t)(STMP3770_DATA_NPAGES * 4096);
+#else
   *heap_start = (void *)(uintptr_t)g_idle_topstack;
   *heap_size  = (size_t)(STMP3770_HEAP_VEND - (uintptr_t)g_idle_topstack);
+#endif
 
   DEBUGASSERT(*heap_size > 0);
 }
diff --git a/arch/arm/src/stmp3770/stmp3770_boot.c b/arch/arm/src/stmp3770/stmp3770_boot.c
index 8066b874..70630bf2 100644
--- a/arch/arm/src/stmp3770/stmp3770_boot.c
+++ b/arch/arm/src/stmp3770/stmp3770_boot.c
@@ -23,6 +23,7 @@
 #include "arm_internal.h"
 #include "arm.h"
 #include "stmp3770.h"
+#include "arm_internal.h"
 
 /****************************************************************************
  * Public Functions
@@ -51,6 +52,71 @@
 
 #ifdef CONFIG_STMP3770_MMU
 
+#ifdef CONFIG_STMP3770_PAGING
+
+/****************************************************************************
+ * Name: stmp3770_map_paged
+ *
+ * Description:
+ *  Coarse-page map for on-demand paging.  Section 0..3 get L2 tables; the
+ *  locked image and the data region are mapped here, the rest of the window
+ *  is left invalid so an access takes a translation fault that
+ *  stmp3770_pagefault() fills synchronously.
+ *
+ *  The page tables themselves live at 0x78000, inside the address range of
+ *  the window, so those pages are pinned identity here.  They can therefore
+ *  never fault, which also keeps the frame allocator away from them.
+ *
+ ****************************************************************************/
+
+static void stmp3770_map_paged(void)
+{
+  uint32_t  l1flags = PMD_TYPE_COARSE | PMD_BIT4;
+  uint32_t  l2flags = PTE_TYPE_SMALL | PTE_SMALL_AP_UNO_SRW |
+                      PTE_CACHEABLE | PTE_BUFFERABLE;
+  uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+  uint32_t *l2 = (uint32_t *)PGTABLE_L2_COARSE_PBASE;
+  uint32_t  i;
+
+  for (i = 0; i < 4 * 256; i++)
+    {
+      l2[i] = 0;
+    }
+
+  /* Locked region: image, bss, idle stacks */
+
+  for (i = 0; i < STMP3770_LOCKED_NPAGES; i++)
+    {
+      l2[i] = (i << 12) | l2flags;
+    }
+
+  /* Page tables: pinned where they are */
+
+  for (i = 0; i < 8; i++)
+    {
+      uint32_t va = STMP3770_PGTABLE_VBASE + i * 4096;
+
+      l2[(va & 0x000fffff) >> 12] = va | l2flags;
+    }
+
+  /* Data region: virtual STMP3770_DATA_VBASE -> physical STMP3770_DATA_PBASE */
+
+  for (i = 0; i < STMP3770_DATA_NPAGES; i++)
+    {
+      uint32_t va = STMP3770_DATA_VBASE + i * 4096;
+
+      l2[((va >> 20) * 256) + ((va & 0x000fffff) >> 12)] =
+          (STMP3770_DATA_PBASE + i * 4096) | l2flags;
+    }
+
+  for (i = 0; i < 4; i++)
+    {
+      l1[i] = (PGTABLE_L2_COARSE_PBASE + i * 1024) | l1flags;
+    }
+}
+
+#endif /* CONFIG_STMP3770_PAGING */
+
 static inline void stmp3770_cp15_ttbr(uint32_t ttbr)
 {
   __asm volatile ("mcr p15, 0, %0, c2, c0, 0" :: "r" (ttbr) : "memory");
@@ -87,8 +153,12 @@ static void stmp3770_mmuinit(void)
       l1[i] = 0;
     }
 
+#ifdef CONFIG_STMP3770_PAGING
+  stmp3770_map_paged();
+#else
   l1[STMP3770_SRAM_BASE >> 20] =
       (STMP3770_SRAM_BASE & 0xfff00000) | MMU_MEMFLAGS;
+#endif
   l1[STMP3770_REGS_BASE >> 20] =
       (STMP3770_REGS_BASE & 0xfff00000) | MMU_IOFLAGS;
 
diff --git a/arch/arm/src/stmp3770/stmp3770_memorymap.h b/arch/arm/src/stmp3770/stmp3770_memorymap.h
index cf94670d..316a6380 100644
--- a/arch/arm/src/stmp3770/stmp3770_memorymap.h
+++ b/arch/arm/src/stmp3770/stmp3770_memorymap.h
@@ -54,9 +54,49 @@
  */
 
 #define STMP3770_PGTABLE_SIZE   0x00004000
-#define PGTABLE_BASE_PADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
-#define PGTABLE_BASE_VADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
-#define STMP3770_HEAP_VEND      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+
+#ifdef CONFIG_STMP3770_PAGING
+
+/* 按需分页布局（4 KB 页，见 docs/khicas.md）。
+ *
+ * 物理：[0x00000, 0x3C000) 240 KB 常驻镜像   60 页
+ *       [0x3C000, 0x4C000)  64 KB 代码帧     16 页
+ *       [0x4C000, 0x78000) 176 KB 数据/堆    44 页
+ *       [0x78000, 0x7C000)  16 KB L1
+ *       [0x7C000, 0x7D000)   4 KB L2 粗表（段 0..3）
+ *
+ * 虚拟：常驻同上，窗口 [0x3C000, 0x3BC000) 3.5 MB，数据区
+ *       [0x3BC000, 0x3E8000)。页表仍按 identity 访问，而它们的虚拟地址
+ *       落在窗口里，所以那几页在窗口内被固定映射（窗口第 60..67 页保留）。
+ */
+
+#  define STMP3770_PAGED_VBASE     0x0003c000u
+#  define STMP3770_PAGED_VEND      0x003bc000u
+#  define STMP3770_PAGED_NPAGES    \
+  ((STMP3770_PAGED_VEND - STMP3770_PAGED_VBASE) >> 12)
+#  define STMP3770_FRAME_PBASE     0x0003c000u
+#  define STMP3770_NFRAMES         16u
+#  define STMP3770_DATA_VBASE      0x003bc000u
+#  define STMP3770_DATA_PBASE      0x0004c000u
+#  define STMP3770_DATA_NPAGES     44u
+#  define STMP3770_LOCKED_NPAGES   60u
+#  define STMP3770_PGTABLE_VBASE   0x00078000u
+
+#  define PGTABLE_BASE_PADDR       STMP3770_PGTABLE_VBASE
+#  define PGTABLE_BASE_VADDR       STMP3770_PGTABLE_VBASE
+#  define PGTABLE_L2_COARSE_OFFSET 0x00004000
+#  define PGTABLE_L2_COARSE_PBASE  (PGTABLE_BASE_PADDR + PGTABLE_L2_COARSE_OFFSET)
+#  define PGTABLE_L2_FINE_OFFSET   0x00004000
+#  define PGTABLE_L2_FINE_PBASE    (PGTABLE_BASE_PADDR + PGTABLE_L2_FINE_OFFSET)
+#  define STMP3770_HEAP_VEND       PGTABLE_BASE_PADDR
+
+#else
+
+#  define PGTABLE_BASE_PADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#  define PGTABLE_BASE_VADDR      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+#  define STMP3770_HEAP_VEND      (STMP3770_SRAM_END - STMP3770_PGTABLE_SIZE)
+
+#endif
 #define NUTTX_START_VADDR       STMP3770_SRAM_BASE
 
 /* 中断控制器 ICOLL
diff --git a/arch/arm/src/stmp3770/stmp3770_pager.c b/arch/arm/src/stmp3770/stmp3770_pager.c
new file mode 100644
index 00000000..037875a7
--- /dev/null
+++ b/arch/arm/src/stmp3770/stmp3770_pager.c
@@ -0,0 +1,142 @@
+/****************************************************************************
+ * arch/arm/src/stmp3770/stmp3770_pager.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Synchronous text pager.  The paged window is a coarse-page region whose
+ * entries start out invalid; the first access to a page takes a translation
+ * fault, and the abort handlers call stmp3770_pagefault() to map a frame and
+ * read that page in from NAND before returning, so the instruction or load
+ * that faulted is simply retried.
+ *
+ * There is no task switch and no worker thread: in a flat build with a polled
+ * NAND driver there is nothing to wait for, and the legacy pager in sched/
+ * paging does a context switch from inside the abort handler that this port
+ * has never survived.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <errno.h>
+
+#include <nuttx/mtd/mtd.h>
+#include <nuttx/debug.h>
+
+#include "arm_internal.h"
+#include "arm.h"
+#include "chip.h"
+
+#ifdef CONFIG_STMP3770_PAGING
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+/* The paged blob lives on NAND blocks 5..32: 896 x 4 KB, one record per
+ * window page.  Blocks 5..32 sit in the area the stock firmware used, so take
+ * a nanddump before enabling this on a real unit.
+ */
+
+#define PAGER_BLOB_BLOCK   5
+#define PAGER_PAGES_PBLK   64          /* erase block = 64 x 2 KB */
+
+#define PAGER_PTESIZE      4096u
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static FAR struct mtd_dev_s *g_pager_mtd;
+static uint32_t               g_next_frame;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline void pager_tlb_invalidate(uint32_t va)
+{
+  __asm volatile ("mcr p15, 0, %0, c8, c7, 1" :: "r" (va) : "memory");
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+void stmp3770_pager_setmtd(FAR struct mtd_dev_s *mtd)
+{
+  g_pager_mtd = mtd;
+}
+
+/****************************************************************************
+ * Name: stmp3770_pagefault
+ *
+ * Description:
+ *   Handle a fault at 'far'.  Returns true if the address belongs to the
+ *   paged window and the page is now mapped and filled, false otherwise
+ *   (the caller then takes its normal fault path).
+ *
+ ****************************************************************************/
+
+bool stmp3770_pagefault(uint32_t far)
+{
+  uint32_t *l1;
+  uint32_t *l2;
+  uint32_t  va;
+  uint32_t  ndx;
+  uint32_t  frame;
+  off_t     offset;
+  ssize_t   nread;
+
+  if (far < STMP3770_PAGED_VBASE || far >= STMP3770_PAGED_VEND)
+    {
+      return false;
+    }
+
+  if (g_pager_mtd == NULL)
+    {
+      return false;
+    }
+
+  va    = far & ~(PAGER_PTESIZE - 1);
+  frame = g_next_frame++ % STMP3770_NFRAMES;
+
+  l1  = (uint32_t *)PGTABLE_BASE_VADDR;
+  l2  = (uint32_t *)(l1[va >> 20] & 0xfffffc00);
+  ndx = (va & 0x000fffff) >> 12;
+
+  /* Map first: the frame is only reachable through the window, and nothing
+   * else can look at it while we are in the fault handler.
+   */
+
+  l2[ndx] = (STMP3770_FRAME_PBASE + frame * PAGER_PTESIZE) |
+            (PTE_TYPE_SMALL | PTE_SMALL_AP_UNO_SRW |
+             PTE_CACHEABLE | PTE_BUFFERABLE);
+  pager_tlb_invalidate(va);
+  __asm volatile ("mcr p15, 0, %0, c7, c10, 4" :: "r" (0) : "memory");
+
+  offset = (off_t)PAGER_BLOB_BLOCK * PAGER_PAGES_PBLK * 2048 +
+           (off_t)((va - STMP3770_PAGED_VBASE) >> 12) * PAGER_PTESIZE;
+
+  nread = MTD_READ(g_pager_mtd, offset, PAGER_PTESIZE, (FAR uint8_t *)va);
+  if (nread != PAGER_PTESIZE)
+    {
+      /* Leave the page unmapped so the fault repeats (and the kernel panics
+       * with a usable address) instead of silently executing garbage.
+       */
+
+      l2[ndx] = 0;
+      pager_tlb_invalidate(va);
+      return false;
+    }
+
+  return true;
+}
+
+#endif /* CONFIG_STMP3770_PAGING */
