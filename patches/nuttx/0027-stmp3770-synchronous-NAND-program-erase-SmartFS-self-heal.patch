           mtd->read(mtd, dst, n, rbuf) != (ssize_t)n ||
           memcmp(fbuf, rbuf, n) != 0)
         {
@@ -584,7 +669,7 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
   if (same)
     {
       nand_put("khicas app OK");
-      return;
+      return OK;
     }
 
   /* Stage the file into the raw area the pager reads. */
@@ -599,7 +684,7 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
   if (fd < 0)
     {
       nand_put("khicas app OPEN FAILED");
-      return;
+      return -EIO;
     }
 
   for (off = 0; (uint32_t)off < size; off += HP39GII_NAND_PAGE_SIZE)
@@ -610,22 +695,73 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
                    HP39GII_NAND_PAGES_PBLK + (off / HP39GII_NAND_PAGE_SIZE);
 
       memset(fbuf, 0xff, HP39GII_NAND_PAGE_SIZE);
-      if (read(fd, fbuf, n) != (ssize_t)n ||
-          mtd->bwrite(mtd, dst, 1, fbuf) != 1)
+      if (!fs_read_all(fd, fbuf, n) || mtd->bwrite(mtd, dst, 1, fbuf) != 1)
         {
           close(fd);
           nand_put("khicas app STAGE FAILED");
-          return;
+          nand_print_num("at ", (uint32_t)off);
+          return -EIO;
         }
     }
 
   close(fd);
   nand_put("khicas app staged");
+  return OK;
 #else
   (void)mtd;
+  return OK;
 #endif
 }
 
+/* Return true if the mounted volume can be written and the data survives a
+ * remount.
+ *
+ * A volume can mount and still drop every write: a format from a firmware
+ * whose partition started at a different block leaves the root directory
+ * sector where this build cannot see it, so the mount succeeds and every
+ * file operation fails afterwards.  Probing for a real write, with a remount
+ * to defeat the caches, is what tells the two apart.
+ */
+
+static bool hp39gii_fs_probe(void)
+{
+  static const char probe[] = "probe\n";
+  char buf[8];
+  int fd;
+    bool ok = false;
+
+  fd = open("/mnt/.probe", O_WRONLY | O_CREAT | O_TRUNC);
+  if (fd < 0)
+    {
+      return false;
+    }
+
+  ok = fs_write_all(fd, (FAR const uint8_t *)probe, sizeof(probe) - 1);
+  close(fd);
+
+  if (!ok)
+    {
+      return false;
+    }
+
+  umount("/mnt");
+  if (mount("/dev/smart0", "/mnt", "smartfs", 0, NULL) < 0)
+    {
+      return false;
+    }
+
+  fd = open("/mnt/.probe", O_RDONLY);
+  if (fd >= 0)
+    {
+      ok = fs_read_all(fd, (FAR uint8_t *)buf, sizeof(probe) - 1) &&
+           memcmp(buf, probe, sizeof(probe) - 1) == 0;
+      close(fd);
+      unlink("/mnt/.probe");
+    }
+
+  return ok;
+}
+
 static int hp39gii_nand_thread(int argc, char **argv)
 {
   FAR struct mtd_dev_s *mtd;
@@ -745,9 +881,21 @@ static int hp39gii_nand_thread(int argc, char **argv)
 
   mkdir("/mnt", 0777);
   ret = mount("/dev/smart0", "/mnt", "smartfs", 0, NULL);
+
+  /* Mounted but not writable means a leftover volume from another layout or
+   * an interrupted format; either way the answer is to start over.
+   */
+
+  if (ret >= 0 && !hp39gii_fs_probe())
+    {
+      nand_put("fs not writable, reformatting");
+      umount("/mnt");
+      ret = -1;
+    }
+
   if (ret < 0)
     {
-      /* First boot after a flash: the volume has never been formatted.
+      /* First boot after a flash, or a volume that had to be thrown away.
        * Format it here instead of asking the user to type mksmartfs.
        */
 
@@ -769,14 +917,39 @@ static int hp39gii_nand_thread(int argc, char **argv)
           return 0;
         }
 
-      nand_put("formatted, mounted /mnt");
+      /* Confirm the new volume really takes writes before going on. */
+
+      if (hp39gii_fs_probe())
+        {
+          nand_put("formatted, mounted /mnt");
+        }
+      else
+        {
+          nand_put("formatted, WRITE PROBE FAILED");
+        }
     }
   else
     {
       nand_put("mounted /mnt");
     }
 
-  nand_install_khicas(mtd);
+  ret = nand_install_khicas(mtd);
+  if (ret < 0)
+    {
+      /* The engine file, or the directory it lives in, is damaged beyond
+       * repair.  The volume only holds the app and a boot counter, so
+       * starting it over is cheaper than trying to patch it.
+       */
+
+      nand_put("fs repair: reformat");
+      umount("/mnt");
+
+      if (mksmartfs("/dev/smart0", 0) == OK &&
+          mount("/dev/smart0", "/mnt", "smartfs", 0, NULL) == OK)
+        {
+          nand_install_khicas(mtd);
+        }
+    }
 
   ret = nand_fs_test();
   if (ret > 0)
