+   */
+
+  if (stat("/mnt/khicas.bin", &st) == 0 && (uint32_t)st.st_size != size)
+    {
+      unlink("/mnt/khicas.bin");
     }
 
-  if (stat("/mnt/khicas.bin", &st) != 0 ||
