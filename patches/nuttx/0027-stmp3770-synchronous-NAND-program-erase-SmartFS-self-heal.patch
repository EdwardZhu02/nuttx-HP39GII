+/* SmartFS returns short reads and writes at sector boundaries, so every
+ * transfer has to be looped.
+ */
+
+static bool fs_write_all(int fd, FAR const uint8_t *buf, size_t n)
+{
+  size_t done = 0;
+
+  while (done < n)
+    {
+      ssize_t w = write(fd, buf + done, n - done);
+
+      if (w <= 0)
+        {
+          return false;
+        }
+
+      done += (size_t)w;
+    }
+
+  return true;
+}
+
+static bool fs_read_all(int fd, FAR uint8_t *buf, size_t n)
+{
+  size_t done = 0;
+
+  while (done < n)
+    {
+      ssize_t r = read(fd, buf + done, n - done);
+
+      if (r <= 0)
+        {
+          return false;
+        }
+
+      done += (size_t)r;
+    }
+
+  return true;
+}
+
+
 /* 原厂在 0 号块和 4 号块各存了一份 NCB（NAND 控制块），两份内容逐字节
  * 相同。4 号块那份一旦被抹掉，就从 0 号块复制回去（数据 + 19 字节元数据），
  * 并读回复核。返回 0=本来就正常，1=已修复，负值=修复失败。
@@ -287,13 +330,29 @@ FAR struct mtd_dev_s *hp39gii_nand_mtd(void)
 
 #ifdef CONFIG_STMP3770_KHICAS
 static sem_t g_khicas_done;
+static bool  g_khicas_notified;
+
+/* Waking NSH from the tail of the application itself, not from the thread
+ * trampoline, removes one return path from the sequence: the console only
+ * comes back when this runs, and the engine is not a place to leave anything
+ * to a return address.
+ */
+
+void hp39gii_khicas_notify(void)
+{
+  if (!g_khicas_notified)
+    {
+      g_khicas_notified = true;
+      nxsem_post(&g_khicas_done);
+    }
+}
 
 static int khicas_thread(int argc, FAR char **argv)
 {
   extern int khicas_main(int argc, char **argv);
 
   khicas_main(argc, argv);
-  nxsem_post(&g_khicas_done);
+  hp39gii_khicas_notify();
   return 0;
 }
 
@@ -302,6 +361,7 @@ int hp39gii_khicas_run(int argc, FAR char **argv)
   int pid;
 
   nxsem_init(&g_khicas_done, 0, 0);
+  g_khicas_notified = false;
   pid = kthread_create("khicas", SCHED_PRIORITY_DEFAULT, 16384,
                        khicas_thread, NULL);
   if (pid < 0)
@@ -441,7 +501,7 @@ static int nand_fs_test(void)
     }
 
   len = snprintf(buf, sizeof(buf), "%d\n", val);
-  n = write(fd, buf, len);
+  n = fs_write_all(fd, (FAR const uint8_t *)buf, len) ? len : -1;
   close(fd);
   if (n != len)
     {
@@ -486,7 +546,7 @@ static int nand_fs_test(void)
  * and erases the staging copy, after which the file is the master.
  */
 
-static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
+static int nand_install_khicas(FAR struct mtd_dev_s *mtd)
 {
 #ifdef CONFIG_STMP3770_KHICAS
   extern char _spgtext[];
@@ -502,20 +562,28 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
 
   if (size == 0)
     {
-      return;
+      return OK;
+    }
+
+  /* A file of the wrong size is a copy that never finished.  Remove it
