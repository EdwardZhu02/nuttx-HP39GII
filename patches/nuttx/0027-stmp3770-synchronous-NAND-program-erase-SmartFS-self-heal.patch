@@ -570,7 +655,7 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
       off_t  dst = (off_t)HP39GII_NAND_BLOB_FIRST *
                    HP39GII_NAND_PAGES_PBLK * HP39GII_NAND_PAGE_SIZE + off;
 
-      if (read(fd, fbuf, n) != (ssize_t)n ||
