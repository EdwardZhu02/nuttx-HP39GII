       if (hp39gii_nand_blob_state(HP39GII_NAND_BLOB_FIRST) != 1)
         {
           nand_put("khicas app MISSING");
-          return;
+          return -ENOENT;
         }
 
       nand_put("installing khicas...");
@@ -525,7 +593,7 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
         {
           nand_put("khicas app OPEN FAILED");
           nand_print_num("errno ", (uint32_t)errno);
-          return;
+          return -EIO;
         }
 
       for (off = 0; (uint32_t)off < size; off += sizeof(rbuf))
@@ -535,31 +603,48 @@ static void nand_install_khicas(FAR struct mtd_dev_s *mtd)
           off_t  src = (off_t)HP39GII_NAND_BLOB_FIRST *
                        HP39GII_NAND_PAGES_PBLK * HP39GII_NAND_PAGE_SIZE + off;
 
+          if (((uint32_t)off % 262144) == 0)
+            {
+              stmp3770_lcdcon_puts(".");
+            }
+
           if (mtd->read(mtd, src, n, rbuf) != (ssize_t)n ||
-              write(fd, rbuf, n) != (ssize_t)n)
+              !fs_write_all(fd, rbuf, n))
             {
               close(fd);
-              nand_put("khicas app COPY FAILED");
-              return;
+
+              /* The engine is still in the raw staging area, and that is
+               * what the pager reads; the file is only a copy the user can
+               * see and replace.  Do not let a failed copy take the file
+               * system down with it -- drop the partial file and run from
+               * the staging area.
+               */
+
+              unlink("/mnt/khicas.bin");
+              nand_print_num("khicas file copy at ", (uint32_t)off);
+              nand_print_num("errno ", (uint32_t)errno);
+              nand_put("khicas: raw staging");
+              return OK;
             }
         }
 
       close(fd);
       nand_put("khicas app installed");
-      return;
+      return OK;
     }
 
   /* The file exists and has the right size.  The pager cannot read through
-   * the file system from inside an abort handler (the VFS is not reentrant
-   * that way), so keep the staging copy in sync with the file and page from
-   * there.  A unit that never touches the file pays one memcmp per boot.
+   * the file system from inside an abort handler, so keep the staging copy
+   * in sync with the file and page from there.  A unit that never touches
+   * the file pays one compare per boot.
    */
 
   fd = open("/mnt/khicas.bin", O_RDONLY);
   if (fd < 0)
     {
       nand_put("khicas app OPEN FAILED");
-      return;
