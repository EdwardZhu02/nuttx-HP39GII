     BW_APBH_CHn_SEMA_INCREMENT_SEMA(NAND_DMA_Channel, 1); 
 
     if(block){
+        uint32_t _s = 0;
         while ((HW_APBH_CHn_SEMA(NAND_DMA_Channel).B.INCREMENT_SEMA) && !ECC_FIN)
-            ;
+            { if (++_s > 5000000u) break; }
     }
 
     LastEraseTime = HW_DIGCTL_MICROSECONDS_RD();
@@ -1305,8 +1306,9 @@ static inline void    GPMI_WritePage(uint32_t ColumnAddress, uint32_t RowAddress
     LastProgTime = HW_DIGCTL_MICROSECONDS_RD();
 
     if(block){
+        uint32_t _s = 0;
         while ((HW_APBH_CHn_SEMA(NAND_DMA_Channel).B.INCREMENT_SEMA))
-            ;
+            { if (++_s > 5000000u) break; }
     }
 
     LastEraseTime = HW_DIGCTL_MICROSECONDS_RD();
@@ -1622,6 +1624,19 @@ FAR const uint8_t *stmp3770_nand_id(void)
     return (FAR const uint8_t *)FlashRecCommandBuffer;
 }
 
+/* Programming is synchronous.
+ *
+ * GPMI_WritePage() returns as soon as the command chain has been handed to
+ * the APBH engine; the engine then programs the page and waits for the
+ * device to become ready again (the WAIT_FOR_READY stage in the chain).
+ * Returning early lets the caller -- the file system writes a sector and
+ * immediately reads it back -- issue a command while the device is busy,
+ * which aborts the program: the write is lost and the page stays erased.
+ *
+ * So ask the chain to block until it has finished, and bound the wait so a
+ * stuck device shows up as a failed write instead of a hang.
+ */
+
 void portMTDReadPage(uint32_t page, uint8_t *buf)
 {
     /*
@@ -1646,14 +1661,14 @@ void portMTDWritePage(uint32_t page, uint8_t *buf)
 {
     //NFO("WR:%d\n", page);
     GPMI_WritePage(0, page, (uint32_t *)stmp3770_va2pa((uint32_t)buf),
-                   NULL, false);
+                   NULL, true);
 }
 
 void portMTDWritePageMeta(uint32_t page, uint8_t *buf, uint8_t *metaBuf)
 {
     //INFO("WRM:%d\n", page);
     GPMI_WritePage(0, page, (uint32_t *)stmp3770_va2pa((uint32_t)buf),
-                   (uint32_t *)(metaBuf ? stmp3770_va2pa((uint32_t)metaBuf) : 0), false);
+                   (uint32_t *)(metaBuf ? stmp3770_va2pa((uint32_t)metaBuf) : 0), true);
 }
 
 uint8_t *portMTDGetMetaData()
@@ -1664,7 +1679,13 @@ uint8_t *portMTDGetMetaData()
 
 void portMTDEraseBlock(uint32_t block)
 {
-    GPMI_EraseBlock(block, false);
+    /* Blocking for the same reason writes are: the file system erases a
+     * block and immediately programs the first sector in it.  With the
+     * erase still running, the program is dropped -- which shows up as a
+     * write failure exactly when the previous block fills up.
+     */
+
+    GPMI_EraseBlock(block, true);
 }
 
 void portMTDCopyPage(uint32_t src, uint32_t dst)
