From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: edwardzhu02 <explodingtnt@foxmail.com>
Date: Sun, 1 Nov 2026 22:21:46 +0800
Subject: [PATCH] stmp3770: mux the GPMI pins and enable the GPMI clock before
 touching it

The NAND never answered on hardware: the ID read returned 0x00 and the
page buffer was never written.  ExistOS sets the GPMI pin mux in
portBoardInit()->GPMI_Init() and our port never did, so the NAND bus was
still wired to whatever the BootROM left:

  bank0 pin0..7   -> D0..D7 (function 0)
  bank0 pin16,17  -> A0, A1
  bank0 pin19     -> RB0
  bank0 pin22     -> RSTn
  bank0 pin23     -> IRQ (function 3)
  bank0 pin24,25  -> WRn, RDn
  bank2 pin15     -> CE0N (function 1)
  plus 12 mA drive strength on those pads.

Also open the GPMI/IO clock gates before the GPMI_CTRL0 reset handshake,
matching ExistOS order; our previous sequence touched the block while
its clock was still gated.
---
 arch/arm/src/stmp3770/stmp3770_gpmi.c | 89 +++++++++++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/arch/arm/src/stmp3770/stmp3770_gpmi.c b/arch/arm/src/stmp3770/stmp3770_gpmi.c
index 4148f571..6313f68c 100644
--- a/arch/arm/src/stmp3770/stmp3770_gpmi.c
+++ b/arch/arm/src/stmp3770/stmp3770_gpmi.c
@@ -897,7 +897,94 @@ static void GPMI_PowerUp(void)
   BF_CLR(ECC8_CTRL, AHBM_SFTRST);
 }
 
+/* GPMI 引脚复用。ExistOS 在 portBoardInit()->GPMI_Init() 里做这套设置，
+ * 我们的移植一直漏掉了：引脚没切到 GPMI 功能，NAND 根本收不到命令，
+ * 读 ID 全是 0x00。
+ *
+ *   bank0 pin0..7      -> D0..D7        (功能 0)
+ *   bank0 pin16,17     -> A0, A1
+ *   bank0 pin19        -> RB0
+ *   bank0 pin22        -> RSTn
+ *   bank0 pin23        -> IRQ           (功能 3)
+ *   bank0 pin24,25     -> WRn, RDn
+ *   bank2 pin15        -> CE0N          (功能 1)
+ */
+
+static void GPMI_PinsInit(void)
+{
+  static const uint8_t ctrl_pins[6] = { 16, 17, 19, 22, 24, 25 };
+  static const uint8_t data_pins[5] = { 16, 17, 19, 22, 23 };
+  volatile uint32_t *muxsel0 = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x100);
+  volatile uint32_t *muxsel1 = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x110);
+  volatile uint32_t *muxsel4 = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x140);
+  volatile uint32_t *drive0  = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x200);
+  volatile uint32_t *drive2  = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x220);
+  volatile uint32_t *drive3  = (volatile uint32_t *)(REGS_PINCTRL_BASE + 0x230);
+  uint32_t reg;
+  int i;
+
+  /* bank0 pin0..7 -> GPMI 数据线，功能 0 */
+
+  reg = *muxsel0;
+  for (i = 0; i < 8; i++)
+    {
+      reg &= ~(3u << (i * 2));
+    }
+  *muxsel0 = reg;
+
+  /* bank0 控制线，功能 0；pin23 用功能 3 */
+
+  reg = *muxsel1;
+  for (i = 0; i < 6; i++)
+    {
+      reg &= ~(3u << ((ctrl_pins[i] - 16) * 2));
+    }
+  reg &= ~(3u << ((23 - 16) * 2));
+  reg |=  (3u << ((23 - 16) * 2));
+  *muxsel1 = reg;
+
+  /* bank2 pin15 -> CE0N，功能 1 */
+
+  reg = *muxsel4;
+  reg &= ~(3u << (15 * 2));
+  reg |=  (1u << (15 * 2));
+  *muxsel4 = reg;
+
+  /* 驱动强度：数据线 12mA */
+
+  reg = *drive0;
+  for (i = 0; i < 8; i++)
+    {
+      reg = (reg & ~(3u << (i * 4))) | (2u << (i * 4));
+    }
+  *drive0 = reg;
+
+  reg = *drive2;
+  for (i = 0; i < 5; i++)
+    {
+      reg = (reg & ~(3u << ((data_pins[i] - 16) * 4))) |
+            (2u << ((data_pins[i] - 16) * 4));
+    }
+  *drive2 = reg;
+
+  reg = *drive3;
+  for (i = 24; i <= 25; i++)
+    {
+      reg = (reg & ~(3u << ((i - 24) * 4))) | (2u << ((i - 24) * 4));
+    }
+  *drive3 = reg;
+}
+
+/* 先开 GPMI/IO 时钟门再碰 GPMI 寄存器 —— ExistOS portBoardInit 的顺序。 */
+
+static void GPMI_ClockEnable(void)
+{
+  BF_CLR(CLKCTRL_GPMI, CLKGATE);
+  BF_CLR(CLKCTRL_FRAC, CLKGATEIO);
+}
+
 void GPMIConfigure()
+
 {
     GPMI_ClockConfigure();
     GPMI_EnableDMAChannel(true);
@@ -1456,7 +1543,9 @@ void portMTDInterfaceInit()
     irq_attach(HW_IRQ_GPMI_DMA, stmp3770_gpmi_dma_irq, NULL);
     irq_attach(HW_IRQ_ECC8_IRQ, stmp3770_ecc8_irq, NULL);
 
+    GPMI_ClockEnable();
     GPMI_PowerUp();
+    GPMI_PinsInit();
     GPMIConfigure();
     ECC_FIN = true;
     
