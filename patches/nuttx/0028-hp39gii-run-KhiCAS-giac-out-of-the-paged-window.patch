 {
   uint32_t  l1flags = PMD_TYPE_COARSE | PMD_BIT4;
-  uint32_t  l2flags = PTE_TYPE_SMALL | PTE_SMALL_AP_UNO_SRW |
-                      PTE_CACHEABLE | PTE_BUFFERABLE;
   uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
-  uint32_t *l2 = (uint32_t *)PGTABLE_L2_COARSE_PBASE;
+  uint32_t *l2 = (uint32_t *)STMP3770_L2_PBASE;
   uint32_t  i;
 
+  /* L2 tables for the four sections the window lives in.  They start out
+   * invalid: the first access to a page takes a translation fault that
+   * stmp3770_pagefault() fills from NAND.
+   */
+
   for (i = 0; i < 4 * 256; i++)
     {
       l2[i] = 0;
     }
 
-  /* Locked region: image, bss, idle stacks */
-
-  for (i = 0; i < STMP3770_LOCKED_NPAGES; i++)
-    {
-      l2[i] = (i << 12) | l2flags;
-    }
-
-  /* Page tables: pinned where they are */
-
-  for (i = 0; i < 8; i++)
-    {
-      uint32_t va = STMP3770_PGTABLE_VBASE + i * 4096;
-
-      l2[(va & 0x000fffff) >> 12] = va | l2flags;
-    }
-
-  /* Data region: virtual STMP3770_DATA_VBASE -> physical STMP3770_DATA_PBASE */
-
-  for (i = 0; i < STMP3770_DATA_NPAGES; i++)
-    {
-      uint32_t va = STMP3770_DATA_VBASE + i * 4096;
-
-      l2[((va >> 20) * 256) + ((va & 0x000fffff) >> 12)] =
-          (STMP3770_DATA_PBASE + i * 4096) | l2flags;
-    }
-
   for (i = 0; i < 4; i++)
     {
-      l1[i] = (PGTABLE_L2_COARSE_PBASE + i * 1024) | l1flags;
+      l1[(STMP3770_PAGED_VBASE >> 20) + i] =
+          (STMP3770_L2_PBASE + i * 1024) | l1flags;
     }
 }
 
@@ -153,11 +131,11 @@ static void stmp3770_mmuinit(void)
       l1[i] = 0;
     }
 
-#ifdef CONFIG_STMP3770_PAGING
-  stmp3770_map_paged();
-#else
   l1[STMP3770_SRAM_BASE >> 20] =
       (STMP3770_SRAM_BASE & 0xfff00000) | MMU_MEMFLAGS;
+
+#ifdef CONFIG_STMP3770_PAGING
+  stmp3770_map_paged();
 #endif
   l1[STMP3770_REGS_BASE >> 20] =
       (STMP3770_REGS_BASE & 0xfff00000) | MMU_IOFLAGS;
@@ -207,8 +185,26 @@ static void stmp3770_mmuinit(void)
 uint32_t stmp3770_va2pa(uint32_t va)
 {
 #ifdef CONFIG_STMP3770_PAGING
-  uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
-  uint32_t  d1 = l1[va >> 20];
+  uint32_t *l1;
+  uint32_t  d1;
+  uint32_t  cr;
+
+  /* Only the MMU can make a virtual address differ from its physical one.
+   * The LCD is brought up before stmp3770_mmuinit(), and both the LCDIF and
+   * the GPMI hand these pointers to the APBH engine, so this gets called
+   * with the MMU off and a page table that is still whatever the boot menu
+   * left at 0x7C000 -- which on hardware is not zero, and reads back as
+   * plausible descriptors.  Return the address unchanged in that case.
+   */
+
+  __asm volatile ("mrc p15, 0, %0, c1, c0, 0" : "=r" (cr));
+  if ((cr & 1) == 0)
+    {
+      return va;
+    }
+
+  l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+  d1 = l1[va >> 20];
 
   if ((d1 & 3) == PMD_TYPE_COARSE)
     {
@@ -365,6 +361,20 @@ static void stmp3770_lcd_fill_bottom_black(void)
 
 void arm_boot(void)
 {
+  /* The boot menu ran from this SRAM and left its heap behind; the page
+   * table lives in that footprint and nothing has cleared it yet.
+   */
+
+  {
+    uint32_t *l1 = (uint32_t *)PGTABLE_BASE_VADDR;
+    int i;
+
+    for (i = 0; i < (int)(PGTABLE_SIZE / sizeof(uint32_t)); i++)
+      {
+        l1[i] = 0;
+      }
+  }
+
   stmp3770_setupmappings();
 
   /* 早期点亮面板（BootROM 时钟下，真机唯一可见反馈）。marker 会置
diff --git a/arch/arm/src/stmp3770/stmp3770_gpmi.c b/arch/arm/src/stmp3770/stmp3770_gpmi.c
index 89c7e413..a624dca3 100644
--- a/arch/arm/src/stmp3770/stmp3770_gpmi.c
+++ b/arch/arm/src/stmp3770/stmp3770_gpmi.c
@@ -1100,6 +1100,36 @@ static inline void    GPMI_sendCommand(uint32_t *cmd, uint32_t *para, uint16_t p
 
 }
 
+/* Polled completion.
+ *
+ * The pager fills pages from the abort handler, which runs with interrupts
+ * masked, so none of the three GPMI ISRs ever get to run.  The completion
+ * latches they normally clear (APBH CH4 CMDCMPLT, ECC8 COMPLETE) are sticky:
+ * leave them set and the next chain never starts -- it just consumes the
+ * semaphore and times out, handing back the previous page.  Clear them here
+ * after a polled wait, and fold in what the ECC ISR would have recorded.
+ */
+
+static inline void GPMI_PolledComplete(bool complete)
+{
+    BF_CLR(APBH_CTRL1, CH4_CMDCMPLT_IRQ);
+    BF_CLR(APBH_CTRL1, CH4_AHB_ERROR_IRQ);
+
+    if (complete && !ECC_FIN)
+    {
+        ECCResult = BF_RD(ECC8_STATUS1, STATUS_PAYLOAD0)            |
+                    (BF_RD(ECC8_STATUS1, STATUS_PAYLOAD1) << 8)     |
+                    (BF_RD(ECC8_STATUS1, STATUS_PAYLOAD2) << 16)    |
+                    (BF_RD(ECC8_STATUS1, STATUS_PAYLOAD3) << 24)    ;
+
+        BF_CLR(ECC8_CTRL, COMPLETE_IRQ);
+        BF_CLR(ECC8_CTRL, BM_ERROR_IRQ);
+
+        ECC_FIN = true;
+        MTD_upOpaFin(ECCResult);
+    }
+}
+
 static inline void   GPMI_ReadPage(uint32_t ColumnAddress, uint32_t RowAddress, uint32_t *data, uint32_t *auxData, bool block)
 {
     volatile uint8_t *probe;
@@ -1180,6 +1210,9 @@ static inline void   GPMI_ReadPage(uint32_t ColumnAddress, uint32_t RowAddress,
                 if (++spin > 5000000u)
                     break;
             }
+
+            GPMI_PolledComplete(spin <= 5000000u);
+
         }
 }
 
