  * Name: stmp3770_pagefault
  *
@@ -104,6 +125,18 @@ bool stmp3770_pagefault(uint32_t far)
       return false;
     }
 
+  if (!g_frames_init)
+    {
+      uint32_t i;
+
+      for (i = 0; i < STMP3770_NFRAMES; i++)
