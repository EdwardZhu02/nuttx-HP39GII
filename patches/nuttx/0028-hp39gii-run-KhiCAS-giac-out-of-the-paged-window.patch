+ * NuttX only runs .init_array when CONFIG_HAVE_CXXINITIALIZE is set, and
+ * that option also pulls in the NuttX C++ runtime, which is ABI-incompatible
+ * with the newlib-based libstdc++ the giac archives were built against.  So
+ * the firmware is a C build and the constructors of the C++ objects that the
+ * engine uses are run here, once, before giac is touched.
+ * ------------------------------------------------------------------------- */
+
+extern "C" void (*_sinit[])(void);
+extern "C" void (*_einit[])(void);
+
+static void khicas_cxx_init(void)
+{
+  static bool inited;
+  void (**p)(void);
+
+  if (inited)
+    {
+      return;
+    }
+
+  inited = true;
+
+  for (p = _sinit; p < _einit; p++)
+    {
+      if (*p != NULL)
+        {
+          (*p)();
+        }
+    }
+}
+
+/* -------------------------------------------------------------------------
+ * Entry point: the NSH command "khicas" calls this.
+ * ------------------------------------------------------------------------- */
+
+extern "C" int khicas_main(int argc, char **argv)
+{
+  giac::context *ctx;
+  std::string line;
+  int fd;
+
+  (void)argc;
+  (void)argv;
+
+  outln("");
+  outln("KhiCAS - giac on NuttX");
+
+  /* The engine is a file on the NAND file system (/mnt/khicas.bin).  It is
+   * too big to run from RAM, so the loader reads it page by page out of the
+   * raw staging area that boot fills from that file (see
+   * nand_install_khicas()).
+   */
+
+  if (khicas_blob_state() != 1)
+    {
+      outln("paged engine missing:");
+      outln("no " KHICAS_BLOB_FILE);
+      return 1;
+    }
+
+  stmp3770_pager_setblob(KHICAS_BLOB_BLOCK);
+
+  khicas_cxx_init();
+
+  outln("starting engine...");
+
+  ctx = new giac::context;
+  if (ctx == NULL)
+    {
+      outln("out of memory");
+      return 1;
+    }
+
+  fd = open("/dev/lcdcon", O_RDONLY);
+  if (fd < 0)
+    {
+      outln("no console");
+      delete ctx;
+      return 1;
+    }
+
+  outln("type quit to leave");
+  outln("");
+
+  for (; ; )
+    {
+      giac::gen parsed;
+      giac::gen result;
+      std::string printed;
+
+      out("CAS> ");
+
+      if (khicas_readline(fd, line) < 0)
+        {
+          break;
+        }
+
+      if (line.empty())
+        {
+          continue;
+        }
+
+      if (line == "quit" || line == "exit")
+        {
+          break;
+        }
+
+      parsed = giac::gen(line.c_str(), ctx);
+      result = giac::eval(parsed, ctx);
+      printed = result.print(ctx);
+
+      out(printed.c_str());
+      out("\r\n");
+    }
+
+  close(fd);
+  delete ctx;
+  outln("bye");
+  return 0;
+}
