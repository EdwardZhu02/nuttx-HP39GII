 arch/arm/src/stmp3770/Make.defs               |  18 +
 arch/arm/src/stmp3770/stmp3770_allocateheap.c |   9 +-
 arch/arm/src/stmp3770/stmp3770_boot.c         |  80 ++--
 arch/arm/src/stmp3770/stmp3770_gpmi.c         |  33 ++
 arch/arm/src/stmp3770/stmp3770_memorymap.h    |  51 ++-
 arch/arm/src/stmp3770/stmp3770_pager.c        |  51 ++-
 .../stmp3770/hp39gii/configs/nsh/defconfig    |   2 +
