 .../arm/stmp3770/hp39gii/src/hp39gii_boot.c   | 249 +++++++++++-
 .../stmp3770/hp39gii/src/hp39gii_pagetest.c   |  28 +-
 .../hp39gii/src/khicas/khicas_app.cpp         | 383 ++++++++++++++++++
 .../hp39gii/src/khicas/khicas_compat.c        | 104 +++++
