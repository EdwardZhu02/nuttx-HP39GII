diff --git a/arch/arm/src/stmp3770/Kconfig b/arch/arm/src/stmp3770/Kconfig
index 5929d9b3..2e575a83 100644
--- a/arch/arm/src/stmp3770/Kconfig
+++ b/arch/arm/src/stmp3770/Kconfig
@@ -89,6 +89,15 @@ config STMP3770_PAGETEST
 		boot, which is fine on a scratch unit and destructive on a stock one
 		-- keep a nanddump first.
 
+config STMP3770_KHICAS
+	bool "KhiCAS (giac) as a paged app"
+	default n
+	depends on STMP3770_PAGING && STMP3770_NAND && STMP3770_LCD
+	---help---
+		Link the giac engine into the paged window and start it from the NSH
+		command "khicas".  The engine's text is demand-paged from a blob at
+		NAND blocks 800.. and the ~3 MB it needs never has to be resident.
+
 config STMP3770_KBD
 	bool "Keyboard matrix"
 	default n
diff --git a/arch/arm/src/stmp3770/Make.defs b/arch/arm/src/stmp3770/Make.defs
index 6b744754..9e90dae1 100644
--- a/arch/arm/src/stmp3770/Make.defs
+++ b/arch/arm/src/stmp3770/Make.defs
@@ -37,3 +37,21 @@ endif
 ifeq ($(CONFIG_STMP3770_NAND),y)
 CHIP_CSRCS += stmp3770_gpmi.c stmp3770_mtd.c
 endif
+
+ifeq ($(CONFIG_STMP3770_KHICAS),y)
+# The KhiCAS app: resident half from libkhicas.a, giac engine from the
+# prebuilt ExistOS archives (its .text lands in .pgtext, see ld.script).
+KHICAS_TOP ?= $(TOPDIR)/../existos
+EXTRA_LIBS += $(TOPDIR)/arch/arm/src/board/khicas/libkhicas.a
+# Use -l: so the archives appear to the linker by their plain names; the
+# linker script matches them as "libcas.libcpp:*(...)".
+EXTRA_LIBS += -L$(KHICAS_TOP)/Libs -l:libcas.libcpp -l:libtommath.libcpp
+# The C++ runtime: absolute paths, because NuttX links with $(LD) directly
+# and there are no default library search paths.  The top-level arm-none-eabi
+# libstdc++ is the ARMv4T/Thumb-1 build, which is safe on this core (the
+# arm/v5te/softfp multilib would emit VFP instructions).
+KHICAS_CXXLIBS = $(shell $(CROSSDEV)gcc -mcpu=arm926ej-s -mfloat-abi=soft -marm -print-file-name=libstdc++.a) \
+                 $(shell $(CROSSDEV)gcc -mcpu=arm926ej-s -mfloat-abi=soft -marm -print-file-name=libsupc++.a) \
+                 $(shell $(CROSSDEV)gcc -mcpu=arm926ej-s -mfloat-abi=soft -marm -print-file-name=libgcc.a)
+EXTRA_LIBS += $(KHICAS_CXXLIBS)
+endif
