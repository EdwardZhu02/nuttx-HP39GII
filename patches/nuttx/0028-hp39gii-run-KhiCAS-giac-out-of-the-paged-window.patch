+/* -------------------------------------------------------------------------
+ * One line of input from the LCD console.  /dev/lcdcon echoes printable
+ * characters itself; we only have to erase on backspace.
+ * ------------------------------------------------------------------------- */
+
+static int khicas_readline(int fd, std::string &line)
+{
+  line.clear();
+
+  for (; ; )
+    {
+      char ch;
+      ssize_t n = read(fd, &ch, 1);
+
+      if (n <= 0)
+        {
+          return -1;
+        }
+
+      if (ch == '\n')
+        {
+          return 0;
+        }
+
+      if (ch == 0x08 || ch == 0x7f)
+        {
+          if (!line.empty())
+            {
+              line.erase(line.size() - 1);
+              stmp3770_lcdcon_puts("\b \b");
+            }
+
+          continue;
+        }
+
+      if (ch >= 0x20 && ch < 0x7f)
+        {
+          line.push_back(ch);
+        }
+    }
+}
