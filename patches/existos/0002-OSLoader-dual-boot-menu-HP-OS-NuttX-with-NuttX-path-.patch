+static void boot_nuttx(void) __attribute__((noreturn));
+static void boot_nuttx(void)
+{
+    uint8_t hdr[16];
+    uint32_t size;
+
+
+    rd_seek(NUTTX_BLOCK * PAGES_PER_BLOCK);
+    rd_bytes(hdr, 16);
+
+    if (memcmp(hdr, HDR_MAGIC_NX, 4) != 0) {
+        draw_menu(1, (char *)"nuttx: bad header");
+        for (;;)
+            vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+
+    size = rd32(hdr + 4);
+
+    /* 尺寸护栏：镜像必须能整段放进 0x0..0x30000（菜单自己住在 0x30000，
+     * NuttX 的页表在 0x7C000）。头损坏时宁可报错，也不要把菜单自己冲掉。 */
+    if (size < sizeof(uint32_t) * 16u || size > 0x0002f000u) {
+        draw_menu(1, (char *)"nuttx: bad size");
+        for (;;)
+            vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+    draw_menu(1, (char *)"loading nuttx...");
+
+    /* 关键：**不能**在中断还开着的时候把 0x0 处的向量表换成 NuttX 的。
+     * 菜单自己的异常向量就在 0x0，而 GPMI 读 DMA 的完成依赖中断；
+     * 一旦向量表先被覆盖，菜单随后的任何一个节拍中断都会跳进还没初始化的
+     * NuttX 异常入口（g_irqvector 还是垃圾），真机上表现为「选了 NuttX
+     * 就复位回菜单」。所以：除镜像最前面的 64 字节（8 条向量 + 8 个字面量）
+     * 之外全部先搬过去，向量留到关中断之后再写。
+     */
+    static uint8_t vec[64] __attribute__((aligned(32)));
+    rd_seek(NUTTX_BLOCK * PAGES_PER_BLOCK);
+    rd_bytes(NULL, 16);                 /* 跳过 "NXB1" 头 */
+    rd_bytes(vec, sizeof(vec));         /* 镜像前 64 字节：向量表 */
+    rd_bytes((uint8_t *)0x00000040u, size - sizeof(vec));
+    draw_menu(1, (char *)"jumping to nuttx");
+    vTaskDelay(pdMS_TO_TICKS(200));
+
+    /* 停表/停 DMA 之后 vTaskDelay 就不工作了，所以整段清理必须放在最后 */
+    park_peripherals();
+
+    irq_off();
+
+    /* 关中断后的最后一步：把 NuttX 的向量表写到 0x0，然后跳进去。 */
+    for (int i = 0; i < (int)(sizeof(vec) / 4); i++) {
+        ((volatile uint32_t *)0x00000000u)[i] = ((const uint32_t *)vec)[i];
+    }
+    ((void (*)(void))0x00000000u)();
+    for (;;)
+        ;
+}
