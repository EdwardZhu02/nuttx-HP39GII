+static void draw_menu(int sel, char *status)
+{
+    DisplayClean();
+    DisplayPutStr(16, 2,  (char *)"HP 39gII  BOOT MENU", 0, 255, 16);
+    DisplayPutStr(8, 24,  sel == 0 ? (char *)"> 1. HP OS (unavail)"
+                                   : (char *)"  1. HP OS (unavail)", 0, 255, 16);
+    DisplayPutStr(8, 42,  sel == 1 ? (char *)"> 2. NuttX"
+                                   : (char *)"  2. NuttX", 0, 255, 16);
+    DisplayPutStr(8, 70,  (char *)"UP/DN select", 0, 255, 16);
+    DisplayPutStr(8, 88,  (char *)"ENTER boot", 0, 255, 16);
+    if (status != NULL)
+        DisplayPutStr(8, 108, status, 0, 255, 16);
+}
