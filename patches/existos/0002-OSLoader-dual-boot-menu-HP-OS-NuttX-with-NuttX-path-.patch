+/* 把块 8/12 的 LDLB 指向 start_page，然后复位 —— 让 ROM 用和 SDP 完全
+ * 一样的方式去加载目标镜像。原 LDLB2（page1）读写过程中原样保留。 */
+static void write_ldlb(uint32_t start_page, uint32_t npages)
+{
+    static const uint32_t blks[2] = { 8, 12 };
+    static const uint8_t ldlb_meta[MS_SIZE] = {
+        0xff, 0xff, 'B', 'C', 'B', ' ', 0xff, 0xff, 0xff, 0xff,
+        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+    /* 必须静态：菜单任务栈只有几 KB，4KB 的局部数组会直接把栈冲爆
+     * （症状就是光标停在 "writing LDLB..." 不动）。 */
+    static uint8_t p0[PAGE_SIZE] __attribute__((aligned(32)));
+    static uint8_t p1[PAGE_SIZE] __attribute__((aligned(32)));
+    static uint8_t m0[MS_SIZE] __attribute__((aligned(32)));
+    static uint8_t m1[MS_SIZE] __attribute__((aligned(32)));
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        uint32_t b = blks[i];
+
+        memcpy(p0, stock_ldlb_page, PAGE_SIZE);
+        memcpy(p1, stock_ldlb2_page, PAGE_SIZE);
+        memcpy(m0, ldlb_meta, MS_SIZE);
+        memcpy(m1, ldlb_meta, MS_SIZE);
+
+        draw_menu(1, (char *)"ldlb: read ok");
+        portMTDEraseBlock(b);
+        draw_menu(1, (char *)"ldlb: erase ok");
+        portMTDWritePageMeta(b * PAGES_PER_BLOCK, p0, m0);
+        portMTDWritePageMeta(b * PAGES_PER_BLOCK + 1, p1, m1);
+        draw_menu(1, (char *)"ldlb: write ok");
+    }
+}
