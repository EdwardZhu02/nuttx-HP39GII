+++ b/OSLoader/bootmenu.c
@@ -0,0 +1,805 @@
+/*
+ * HP 39gII (STMP3770) 双启动菜单
+ *
+ * 由 BootROM 通过 LDLB 载入到 0x30000 执行（见 Script/build_menu.bd）。
+ * 菜单只读 NAND，不改任何 flash 内容；两个选项：
+ *
+ *   HP OS  —— 执行原厂引导流（由主机工具离线解密后放在 241 号块，
+ *             16 字节头 "HPB1"+长度，后面是原厂 SB 引导段的 18 条指令：
+ *             LOAD/FILL/CALL 0x175/JUMP 0xE89FC）。
+ *   NuttX  —— 把 243 号块的 nuttx.bin（"NXB1"+长度）搬到 0x0 并跳进去。
+ *
+ * 内存布局（512 KB SRAM，地址只译 19 位）：
+ *   0x00000..0x2F80D  原厂引导段的 LOAD 目标
+ *   0x30000..~0x48000 本菜单（不会被两边的 LOAD 覆盖）
+ *   0x68000..0x78300  原厂引导段后半段的 LOAD 目标（0xE8000 别名）
+ * 所以真正跑引导流之前要把栈切到 0x67F00 以下的安全区。
+ */
+#ifdef BOOTMENU
+
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "FreeRTOS.h"
+#include "task.h"
+
+#include "board_up.h"
+#include "display_up.h"
+#include "keyboard_up.h"
+#include "mtd_up.h"
+
+#include "regsclkctrl.h"
+#include "regsicoll.h"
+#include "regstimrot.h"
+#include "regslcdif.h"
+#include "regsapbh.h"
+#include "regsgpmi.h"
+#include "regsecc8.h"
+#include "regspower.h"
+
+#define PAGE_SIZE        2048u
+#define PAGES_PER_BLOCK  64u
+
+/* NAND 布局 —— 必须与 host-tools/install_menu.py 一致 */
+#define HP_SCRIPT_BLOCK  241u
+#define NUTTX_BLOCK      243u
+
+#define HDR_MAGIC_HP     "HPB1"
+#define HDR_MAGIC_NX     "NXB1"
+
+#define SAFE_STACK_TOP   0x00067F00u
+#define MS_SIZE          19u
+
+static void draw_menu(int sel, char *status);
+
+static uint8_t  g_rd[PAGE_SIZE] __attribute__((aligned(32)));
+static uint32_t g_page;
+static uint32_t g_off;
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void rd_seek(uint32_t page)
+{
+    g_page = page;
+    g_off  = PAGE_SIZE;       /* 让下一次读强制加载新页 */
+}
+
+static void rd_bytes(uint8_t *dst, uint32_t n)
+{
+    while (n > 0) {
+        if (g_off >= PAGE_SIZE) {
+            portMTDReadPage(g_page, g_rd);
+            g_page++;
+            g_off = 0;
+        }
+
+        uint32_t k = PAGE_SIZE - g_off;
+        if (k > n)
+            k = n;
+
+        if (dst != NULL) {
+            memcpy(dst, g_rd + g_off, k);
+            dst += k;
+        }
+
+        g_off += k;
+        n     -= k;
+    }
+}
+
+#ifdef BOOTMENU_HP
+static void do_fill(uint32_t addr, uint32_t len, uint32_t arg, uint16_t flags)
+{
+    uint32_t i;
+
+    switch (flags & 3u) {
+    case 0:
+        memset((void *)addr, (int)(arg & 0xffu), len);
+        break;
+    case 1:
+        for (i = 0; i + 2 <= len; i += 2)
+            *(volatile uint16_t *)(addr + i) = (uint16_t)arg;
+        break;
+    default:
+        for (i = 0; i + 4 <= len; i += 4)
+            *(volatile uint32_t *)(addr + i) = arg;
+        break;
+    }
+}
+
+#endif /* BOOTMENU_HP */
+
+/* 关中断、换到安全栈，然后进入 fn —— 不返回 */
+/* 换到安全栈后执行 fn。注意：这里**不能**关中断 —— GPMI 读 DMA 的完成
+ * 依赖中断，关了中断第一次读页就会卡死。关中断只在真正跳进目标镜像前做。 */
+#ifdef BOOTMENU_HP
+static void enter_lowlevel(void (*fn)(void)) __attribute__((naked, noreturn));
+static void enter_lowlevel(void (*fn)(void))
+{
+    __asm volatile(
+        "ldr     sp, =0x00067F00 \n\t"
+        "bx      r0              \n\t");
+}
+#endif /* BOOTMENU_HP */
+
+static inline void irq_off(void)
+{
+    __asm volatile(
+        "mrs     r0, cpsr        \n\t"
+        "orr     r0, r0, #0xc0   \n\t"
+        "msr     cpsr_c, r0      \n\t"
+        ::: "r0", "memory");
+}
+
+static inline void irq_on(void)
+{
+    __asm volatile(
+        "mrs     r0, cpsr        \n\t"
+        "bic     r0, r0, #0xc0   \n\t"
+        "msr     cpsr_c, r0      \n\t"
+        ::: "r0", "memory");
+}
+
+static inline uint32_t irq_save(void)
+{
+    uint32_t c;
+
+    __asm volatile("mrs %0, cpsr" : "=r" (c));
+    __asm volatile("msr cpsr_c, %0" :: "r" (c | 0xc0u) : "memory");
+    return c;
+}
+
+static inline void irq_restore(uint32_t c)
+{
+    __asm volatile("msr cpsr_c, %0" :: "r" (c) : "memory");
+}
+
+static void park_peripherals(void);
+
+#ifdef BOOTMENU_HP
+/* 0x0..0x40 是异常向量区，原厂引导流会**两次**覆盖它：
+ *
+ *   1) CALL 0x175 之前的第一条 LOAD（Thumb 代码块 0..0x5491）——
+ *      host0 自己的小工具函数就在 0x0 起，执行 CALL 期间必须真写进去，
+ *      否则 host0 里的 `bl 0x0` 会跳进菜单的 ARM 向量字，直接 Undefined。
+ *   2) CALL 返回之后的 LOAD 1024@0x0 —— 原厂系统真正的 ARM 镜像头
+ *      （`b +0x20` + ldr pc 向量表），这一份要留到最后 JUMP 时再落盘。
+ *
+ * 所以：覆盖向量区的 LOAD 一律立即写入内存（host0 要用），同时把内容
+ * 记进 g_vec；CALL 返回后先把菜单自己的向量恢复回去（菜单的节拍中断
+ * 还要再跑一会儿），JUMP 前再写回 g_vec 里最后一份。
+ */
+static uint8_t g_vec[64] __attribute__((aligned(32)));
+static int     g_vec_valid;
+static uint8_t g_menu_vec[64] __attribute__((aligned(32)));
+
+static void load_defer_vectors(uint32_t addr, uint32_t len)
+{
+    if (addr < sizeof(g_vec)) {
+        uint32_t n = sizeof(g_vec) - addr;
+
+        if (n > len)
+            n = len;
+        rd_bytes(g_vec + addr, n);      /* 只记下来，不写 0x0（菜单还要用向量） */
+        g_vec_valid = 1;
+        addr += n;
+        len  -= n;
+    }
+
+    if (len != 0)
+        rd_bytes((uint8_t *)addr, len);
+}
+
+static void write_vec_to_zero(void)
+{
+    for (uint32_t i = 0; i < sizeof(g_vec) / 4; i++)
+        ((volatile uint32_t *)0x00000000u)[i] = ((const uint32_t *)g_vec)[i];
+}
+
+/* 把菜单自己的异常向量写回 0x0（CALL 返回后调用） */
+static void restore_menu_vectors(void)
+{
+    for (uint32_t i = 0; i < sizeof(g_menu_vec) / 4; i++)
+        ((volatile uint32_t *)0x00000000u)[i] = ((const uint32_t *)g_menu_vec)[i];
+}
+
+static void park_peripherals(void);
+static void restore_rom_clocks(void);
+
+static void boot_hp(void) __attribute__((noreturn));
+static void boot_hp(void)
+{
+    uint8_t hdr[16];
+    uint8_t inst[16];
+           (unsigned long)c1, (unsigned long)c2, (unsigned long)c3);
+
+    rd_seek(HP_SCRIPT_BLOCK * PAGES_PER_BLOCK);
+    rd_bytes(hdr, 16);
+
+    /* 先把菜单自己的向量抄一份：原厂流会覆盖 0x0，CALL 返回后要还回来 */
+    for (uint32_t i = 0; i < sizeof(g_menu_vec) / 4; i++)
+        ((uint32_t *)g_menu_vec)[i] = ((const volatile uint32_t *)0x00000000u)[i];
+
+    for (;;) {
+        uint8_t  op;
+        uint16_t fl;
+        uint32_t addr;
+        uint32_t len;
+        uint32_t arg;
+
+        rd_bytes(inst, 16);
+
+        op   = inst[1];
+        fl   = (uint16_t)(inst[2] | (inst[3] << 8));
+        addr = rd32(inst + 4);
+        len  = rd32(inst + 8);
+        arg  = rd32(inst + 12);
+
+        switch (op) {
+        case 2:                                  /* LOAD */
+            load_defer_vectors(addr, len);
+            {
+                uint32_t pad = (len + 15u) & ~15u;
+                if (pad > len)
+                    rd_bytes(NULL, pad - len);
+            }
+            break;
+
+        case 3:                                  /* FILL */
+            do_fill(addr, len, arg, fl);
+            break;
+
+        case 5:                                  /* CALL */
+            /* 原厂流里的 CALL 0x175 是 HP 的第一阶段引导（host0）：
+             * 从反汇编看它配置 RTC/POWER、做板级检测、延时，是 JUMP 之前的
+             * 必需准备（跳过它原厂系统起不来）。addr 是 Thumb 地址（奇数）。
+             * 调用期间关中断：菜单的 FreeRTOS 节拍会打进正在执行的厂家代码。 */
+            {
+                /* host0 自己的工具函数就在 0x0 起（它内部会 bl 0x0），
+                 * 所以调用前必须把这 64 字节真的写到 0x0 —— 但只能在
+                 * **关中断之后**做：之前的 NAND 读还要靠菜单的向量接收
+                 * GPMI 完成中断。返回后立刻把菜单向量还回去，再开中断。 */
+                irq_off();
+                if (g_vec_valid)
+                    write_vec_to_zero();
+                ((uint32_t (*)(void))(addr | 1u))();
+                restore_menu_vectors();
+                irq_on();
+            }
+            break;
+
+        case 4:                                  /* JUMP */
+            /* 同 boot_nuttx：把菜单留下的节拍/DMA 中断源全部停掉并复位，
+             * 再把暂存的向量区写回 0x0，最后跳进原厂系统。 */
+            /* 实验：不清外设、不回写时钟，尽量保持原厂启动流会看到的
+             * 运行状态（原厂自己会初始化 TIMROT/GPMI/ICOLL/LCDIF）。
+             * 只关中断，避免节拍打进原厂代码。 */
+            irq_off();
+            if (g_vec_valid)
+                write_vec_to_zero();
+            ((void (*)(void))addr)();
+            break;
+
+        default:                                 /* NOP / TAG 等 */
+            break;
+        }
+    }
+}
+
+static const uint8_t stock_ldlb_page[PAGE_SIZE] = {
