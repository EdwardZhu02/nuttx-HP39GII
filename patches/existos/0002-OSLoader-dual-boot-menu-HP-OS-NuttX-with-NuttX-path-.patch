+        return memcmp(hdr, HDR_MAGIC_HP, 4) == 0;      /* "HPB1" + 长度 */
+
+    /* NuttX 段是菜单自己加载的裸镜像：页首是 "NXB1" + 长度 */
+    return memcmp(hdr, HDR_MAGIC_NX, 4) == 0;
+}
+
+void vBootMenuTask(void *pvParameters)
+{
+    mtdInfo_t info;
+    int sel = 0;
+    char status[33];
+
+    (void)pvParameters;
+
+    /* 面板 reset→display-on 约 820ms，显示服务也在初始化：先等足够久，
+     * 之后在循环里周期性重画，避免早期丢帧导致黑屏。 */
+    vTaskDelay(pdMS_TO_TICKS(2000));
+
+    portKeyboardGPIOInit();
+
+    memset(&info, 0, sizeof(info));
+    portMTDDeviceInit(&info);
+
+    snprintf(status, sizeof(status), "nand %lu blk x %lu pg",
+             (unsigned long)info.Blocks, (unsigned long)info.PagesPerBlock);
+
+    draw_menu(sel, status);
+
+#ifdef BOOTMENU_AUTO
+    boot_nuttx();
+#endif
+
+    for (;;) {
+        Keys_t k;
+        static int tick = 0;
+
+        if ((tick++ % 25) == 0)
+            draw_menu(sel, status);
+
+        portKeyScan();
+        k = portGetChangedKey();
+
+        if (k != (Keys_t)255 && portIsKeyDown(k)) {
+            if (k == KEY_UP && sel != 0) {
+                sel = 0;
+                draw_menu(sel, status);
+            } else if (k == KEY_DOWN && sel != 1) {
+                sel = 1;
+                draw_menu(sel, status);
+            } else if (k == KEY_ENTER) {
+                if (sel == 0) {
+                    /* HP OS 暂不支持。原厂启动流依赖 ROM/高向量环境，从菜单
+                     * 直接执行会在早期黑屏（详见 reports/ 的双启动记录）。
+                     * 代码保留在 BOOTMENU_HP 下，留给以后。 */
+                    draw_menu(sel, (char *)"HP OS: not supported yet");
+                } else if (image_ok(1)) {
+                    boot_nuttx();
+                } else {
+                    draw_menu(sel, (char *)"NuttX: image missing / bad magic");
+                }
+            }
+        }
+
+        vTaskDelay(pdMS_TO_TICKS(40));
+    }
+}
+
+#endif /* BOOTMENU */
diff --git a/OSLoader/probe.c b/OSLoader/probe.c
new file mode 100644
index 0000000..22f3187
--- /dev/null
+++ b/OSLoader/probe.c
@@ -0,0 +1,226 @@
+/*
+ * HP 39gII (STMP3770) Phase-0 只读探测固件
+ *
+ * 由 SDP (066f:3770 HID) 上传到 SRAM 执行，完全不访问 NAND。
+ * 结果绘制到 256x127 LCD，分 4 页轮播。
+ *
+ * 显示路径沿用在真机上已验证可出图的 vDispSvc + DisplayPutStr。
+ *
+ * v2 修正（v1 的缺陷）：
+ *  - 数据异常处理器没有保存 r0-r3/r12，第一次异常后状态全乱，
+ *    导致 CHIPID/ICOLL/TIMROT 等必然存在的寄存器都读出 ABORT。现已完整保存。
+ *  - 已知存在的片内外设改为直接读，不经过异常保护。
+ *  - 每采集完一页立刻显示，避免后面的探测把前面的结果抹掉。
+ *  - 增加 DABCNT/DFAR/DFSR，便于判断异常到底是不是真的。
+ */
+#ifdef PROBE_ONLY
+
+#include <stdarg.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdint.h>
+
+#include "SystemConfig.h"
+#include "FreeRTOS.h"
+#include "task.h"
+#include "display_up.h"
+
+#define PROBE_PAGES 4
+#define PROBE_LINES 7
+#define PROBE_COLS  32
+#define LINE_H      17
+
+#define RD(a) (*(volatile uint32_t *)(a))
+
+static char g_page[PROBE_LINES][PROBE_COLS + 1];
+static char g_pages[PROBE_PAGES][PROBE_LINES][PROBE_COLS + 1];
+
+extern QueueHandle_t DisplayOpaQueue;
+
+/* ---- 数据异常恢复 ---- */
+
+volatile uint32_t g_dab_far;
+volatile uint32_t g_dab_fsr;
+volatile uint32_t g_dab_hit;
+volatile uint32_t g_dab_cnt;
+
+void __attribute__((naked)) probe_dab_vec(void)
+{
+    __asm volatile(
+        "stmdb  sp!, {r0-r3, r12}\n\t"
+        "mrc    p15, 0, r0, c6, c0, 0\n\t"   /* DFAR */
+        "ldr    r12, =g_dab_far\n\t"
+        "str    r0, [r12]\n\t"
+        "mrc    p15, 0, r0, c5, c0, 0\n\t"   /* DFSR */
+        "ldr    r12, =g_dab_fsr\n\t"
+        "str    r0, [r12]\n\t"
+        "mov    r0, #1\n\t"
+        "ldr    r12, =g_dab_hit\n\t"
+        "str    r0, [r12]\n\t"
+        "ldr    r12, =g_dab_cnt\n\t"
+        "ldr    r0, [r12]\n\t"
+        "add    r0, r0, #1\n\t"
+        "str    r0, [r12]\n\t"
+        "mrs    r2, spsr\n\t"
+        "tst    r2, #0x20\n\t"               /* T bit */
+        "ldmia  sp!, {r0-r3, r12}\n\t"       /* ldmia 不改标志位 */
+        "beq    1f\n\t"
+        "movs   pc, lr\n\t"                  /* Thumb: 跳过故障指令 */
+        "1:\n\t"
+        "subs   pc, lr, #4\n\t");            /* ARM: 跳过故障指令 */
+}
+
+static uint32_t safe_rd(uint32_t addr, uint32_t *faulted)
+{
+    uint32_t v;
+
+    g_dab_hit = 0;
+    __asm volatile("" ::: "memory");
+    v = *(volatile uint32_t *)addr;
+    __asm volatile("" ::: "memory");
+
+    if (faulted)
+        *faulted = g_dab_hit;
+    return v;
+}
+
+/* ---- 文本 ---- */
+
+static void setline(int n, const char *fmt, ...)
+{
+    va_list ap;
+
+    if (n < 0 || n >= PROBE_LINES)
+        return;
+    va_start(ap, fmt);
+    vsnprintf(g_page[n], PROBE_COLS + 1, fmt, ap);
+    va_end(ap);
+}
+
+static void clear_page(void)
+{
+    memset(g_page, 0, sizeof(g_page));
+}
+
+/* 直接读：已知存在的片内外设 */
+static void reg_direct(int n, const char *name, uint32_t addr)
+{
+    setline(n, "%-10s %08lX=%08lX", name,
+            (unsigned long)addr, (unsigned long)RD(addr));
+}
+
+static void reg_safe(int n, const char *name, uint32_t addr)
+{
+    uint32_t bad = 0;
+    uint32_t v = safe_rd(addr, &bad);
+
+    if (bad)
+        setline(n, "%-10s %08lX=ABORT", name, (unsigned long)addr);
+    else
+        setline(n, "%-10s %08lX=%08lX", name,
+                (unsigned long)addr, (unsigned long)v);
+}
+
+static void mem_line(int n, const char *name, uint32_t addr)
+{
+    uint32_t bad = 0;
+    uint32_t v = safe_rd(addr, &bad);
+
+    if (bad)
+        setline(n, "%s %08lX=ABORT", name, (unsigned long)addr);
+    else
+        setline(n, "%s %08lX=%08lX", name,
+                (unsigned long)addr, (unsigned long)v);
+}
+
+static void show_page(int p)
+{
+    DisplayClean();
+    vTaskDelay(pdMS_TO_TICKS(150));
+    for (int n = 0; n < PROBE_LINES; n++) {
+        if (g_page[n][0])
+            DisplayPutStr(0, (uint32_t)(n * LINE_H), g_page[n], 255, 0, 16);
+    }
+    /* 存一份，供后面轮播 */
+    for (int n = 0; n < PROBE_LINES; n++)
+        memcpy(g_pages[p][n], g_page[n], PROBE_COLS + 1);
+}
+
+static void show_saved(int p)
+{
+    DisplayClean();
+    vTaskDelay(pdMS_TO_TICKS(150));
+    for (int n = 0; n < PROBE_LINES; n++) {
+        if (g_pages[p][n][0])
+            DisplayPutStr(0, (uint32_t)(n * LINE_H), g_pages[p][n], 255, 0, 16);
+    }
+}
+
+void vProbeTask(void *pvParameters)
+{
+    uint32_t v;
+
+    (void)pvParameters;
+
+    while (DisplayOpaQueue == NULL)
+        vTaskDelay(pdMS_TO_TICKS(20));
+    vTaskDelay(pdMS_TO_TICKS(300));
+
+    /* ---- 页 0：芯片身份 + EMI（DRAM 开关）—— 只用最确定存在的寄存器 ---- */
+    clear_page();
+    reg_direct(0, "CHIPID", 0x8001C310u);
+    v = RD(0x80020010u); /* HW_EMI_STAT */
+    setline(1, "EMI_STAT 80020010=%08lX", (unsigned long)v);
+    setline(2, " P31=%d L29=%d H1=%d",
+            (int)((v >> 31) & 1), (int)((v >> 29) & 1), (int)((v >> 1) & 1));
+    reg_direct(4, "EMI_CTRL", 0x80020000u);
+    reg_direct(5, "CLKCTRL", 0x80040000u);
+    reg_direct(6, "PINCTRL", 0x80018000u);
+    show_page(0);
+    vTaskDelay(pdMS_TO_TICKS(4500));
+
+    /* ---- 页 1：中断控制器 + 定时器 ---- */
+    clear_page();
+    reg_direct(0, "ICOLL_STAT", 0x80000030u);
+    reg_direct(1, "ICOLL_70", 0x80000070u);
+    reg_direct(2, "ICOLL_CTRL", 0x80000020u);
+    reg_direct(3, "ICOLL_PR10", 0x80000060u);
+    reg_direct(4, "TIMROT_VER", 0x800680A0u);
+    reg_direct(5, "TIMCTRL3", 0x80068080u);
+    reg_direct(6, "ROTCOUNT", 0x80068010u);
+    show_page(1);
+    vTaskDelay(pdMS_TO_TICKS(4500));
+
+    /* ---- 页 2：串口 + DRI（DRI 可能不存在，放最后） ---- */
+    clear_page();
+    reg_direct(0, "UARTDBG_CR", 0x80070030u);
+    reg_direct(1, "UARTDBG_FR", 0x80070018u);
+    reg_direct(2, "UARTDBG_ID", 0x80070FE0u);
+    reg_direct(3, "UARTAPP_VER", 0x8006C090u);
+    reg_direct(4, "UARTAPP_STAT", 0x8006C070u);
+    reg_direct(5, "DRI_CTRL", 0x80074000u);
+    reg_direct(6, "DRI_STAT", 0x80074020u);
+    show_page(2);
+    vTaskDelay(pdMS_TO_TICKS(4500));
+
+    /* ---- 页 3：地址空间走线（可能触发异常） ---- */
+    clear_page();
+    mem_line(0, "M1 0080", 0x00800000u);
+    mem_line(1, "M2 4000", 0x40000000u);
+    mem_line(2, "M3 0010", 0x00100000u);
+    mem_line(3, "M4 0000", 0x00000000u);
+    setline(4, "DABCNT=%lu", (unsigned long)g_dab_cnt);
+    setline(5, "DFAR=%08lX", (unsigned long)g_dab_far);
+    setline(6, "DFSR=%08lX", (unsigned long)g_dab_fsr);
+    show_page(3);
+    vTaskDelay(pdMS_TO_TICKS(4500));
+
+    for (;;) {
+        for (int p = 0; p < PROBE_PAGES; p++) {
+            show_saved(p);
+            vTaskDelay(pdMS_TO_TICKS(3800));
+        }
+    }
+}
+
+#endif /* PROBE_ONLY */
diff --git a/OSLoader/start.c b/OSLoader/start.c
index dc78fcd..57fc470 100644
--- a/OSLoader/start.c
+++ b/OSLoader/start.c
@@ -1012,8 +1012,62 @@ extern void vDumpTask(void *pvParameters);
 extern void vRestoreTask(void *pvParameters);
 #endif
 
+/* BOOTMENU_VARIANT */
+#ifdef BOOTMENU
+extern void vBootMenuTask(void *pvParameters);
+#endif
+
+#if defined(BOOTMENU) && defined(BOOTMENU_HP)
+/* BootROM 交棒时的时钟寄存器快照。boardInit() 里的 CLKCtrlInit 会把它们
+ * 改成 ExistOS 的 392MHz 配置；跑原厂系统（HP OS）前要还回 ROM 的状态，
+ * 因为原厂的时钟/面板时序是按 ROM 交棒状态写的。
+ * 由 bootmenu.c 的 boot_hp() 在 JUMP 前调用 restore_rom_clocks()。 */
+uint32_t g_rom_clk[8];
+uint32_t g_rom_clkseq;
+uint32_t g_rom_pwr[10];
+#endif
+
 volatile void _startup() {
 
+#ifdef BOOTMENU
+#ifdef BOOTMENU_HP
+    /* 先抓 ROM 的时钟状态（这时 boardInit 还没跑）。 */
+    g_rom_clk[0] = HW_CLKCTRL_PLLCTRL0_RD();
+    g_rom_clk[1] = HW_CLKCTRL_CPU_RD();
+    g_rom_clk[2] = HW_CLKCTRL_HBUS_RD();
+    g_rom_clk[3] = HW_CLKCTRL_XTAL_RD();
+    g_rom_clk[4] = HW_CLKCTRL_PIX_RD();
+    g_rom_clk[5] = HW_CLKCTRL_SSP_RD();
+    g_rom_clk[6] = HW_CLKCTRL_GPMI_RD();
+    g_rom_clk[7] = HW_CLKCTRL_FRAC_RD();
+    g_rom_clkseq  = HW_CLKCTRL_CLKSEQ_RD();
+
+    g_rom_pwr[0] = HW_POWER_CTRL_RD();
+    g_rom_pwr[1] = HW_POWER_5VCTRL_RD();
+    g_rom_pwr[2] = HW_POWER_CHARGE_RD();
+    g_rom_pwr[3] = HW_POWER_VDDDCTRL_RD();
+    g_rom_pwr[4] = HW_POWER_VDDACTRL_RD();
+    g_rom_pwr[5] = HW_POWER_VDDIOCTRL_RD();
+    g_rom_pwr[6] = HW_POWER_DCFUNCV_RD();
+    g_rom_pwr[7] = HW_POWER_DCLIMITS_RD();
+    g_rom_pwr[8] = HW_POWER_LOOPCTRL_RD();
+    g_rom_pwr[9] = HW_POWER_BATTMONITOR_RD();
+#endif /* BOOTMENU_HP */
+
+    /* 菜单固件链接在 0x30000，但 ARM926 的异常向量固定在 0x0：
+     * 这里（栈已就绪）先把镜像开头的 8 条向量指令拷到 0x0。
+     * 原厂引导流之后会覆盖 0x0，那时我们已经不再依赖异常。 */
+    {
+        /* 必须连字面量池一起拷：前 8 条是 ldr pc,.Lxxx，它们指向的字面量
+         * 在偏移 32..63。只拷 8 个字的话，跳到 0x0 的那几条 ldr 会去
+         * 0x20..0x3C 读垃圾，第一次中断就飞。 */
+        volatile uint32_t *src = (volatile uint32_t *)0x00030000;
+        volatile uint32_t *dst = (volatile uint32_t *)0x00000000;
+        for (int i = 0; i < 16; i++)
+            dst[i] = src[i];
+    }
+#endif
+
     printf("OSLoader starting...\nreboot count: %d\n", bootTimes);
 
     // get_cpu_info();
@@ -1044,6 +1098,17 @@ volatile void _startup() {
 #endif
 
 
+#ifdef BOOTMENU
+    /* 菜单模式：显示服务 + 菜单任务，只用 MTD 读，不碰 FTL/USB */
+    xTaskCreate(vDispSvc, "Display Svc", configMINIMAL_STACK_SIZE, NULL,
