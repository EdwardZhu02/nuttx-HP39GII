+/* 把菜单用过、并且会向 ICOLL 拉中断的外设放回**上电复位态**。
+ *
+ * 为什么必须做：NuttX 的 arm_boot 先初始化面板，之后 up_irqinitialize()
+ * 才打开中断；这中间菜单留下的任何挂起中断都会在开中断的一瞬间经 ICOLL
+ * 送到 CPU，而那时 NuttX 的 ISR 还没挂上 → irq_unexpected_isr panic。
+ * QEMU 实测：先吃到 IRQ 28（TIMER0 = FreeRTOS 节拍），修掉后又是
+ * IRQ 45（LCDIF_DMA = 菜单刷屏留下的挂起位）。
+ *
+ * NuttX 的每个外设驱动都以「清 SFTRST/CLKGATE」开头，所以把模块停在
+ * SFTRST=1 的复位态正是它期望的入口状态（与 BootROM 交棒时一致）。
+ */
+static void park_peripherals(void)
+{
+    int i;
+
+    HW_TIMROT_ROTCTRL_SET(BM_TIMROT_ROTCTRL_SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (HW_TIMROT_ROTCTRL_RD() & BM_TIMROT_ROTCTRL_CLKGATE)
+            break;
+
+    BF_SET(LCDIF_CTRL, SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (BF_RD(LCDIF_CTRL, CLKGATE))
+            break;
+    BF_SET(APBH_CTRL0, SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (BF_RD(APBH_CTRL0, CLKGATE))
+            break;
+
+    BF_SET(GPMI_CTRL0, SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (BF_RD(GPMI_CTRL0, CLKGATE))
+            break;
+    BF_SET(ECC8_CTRL, SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (BF_RD(ECC8_CTRL, CLKGATE))
+            break;
+
+    HW_ICOLL_CTRL_SET(BM_ICOLL_CTRL_SFTRST);
+    for (i = 0; i < 100000; i++)
+        if (HW_ICOLL_CTRL_RD() & BM_ICOLL_CTRL_CLKGATE)
+            break;
+}
