+/* BootROM 交棒时的时钟快照（start.c 的 _startup 里抓的）。
+ *
+ * 菜单跑起来后 CLKCtrlInit 已经把 CPU/HCLK/PIX/GPMI 改成 ExistOS 的配置
+ * （CPU frac=22 → 392MHz）。原厂系统的时钟/面板时序是按 ROM 交棒状态写的，
+ * 所以进原厂系统前先还回去。改分频时先切到 XTAL 旁路，改完再恢复 CLKSEQ。 */
+extern uint32_t g_rom_clk[8];
+extern uint32_t g_rom_clkseq;
+extern uint32_t g_rom_pwr[10];
+
+static void restore_rom_clocks(void)
+{
+
+    BF_SET(CLKCTRL_CLKSEQ, BYPASS_CPU);
+
+    HW_CLKCTRL_FRAC_WR(g_rom_clk[7]);
+    HW_CLKCTRL_CPU_WR(g_rom_clk[1]);
+    HW_CLKCTRL_HBUS_WR(g_rom_clk[2]);
+    HW_CLKCTRL_PLLCTRL0_WR(g_rom_clk[0]);
+    HW_CLKCTRL_XTAL_WR(g_rom_clk[3]);
+    HW_CLKCTRL_PIX_WR(g_rom_clk[4]);
+    HW_CLKCTRL_SSP_WR(g_rom_clk[5]);
+    HW_CLKCTRL_GPMI_WR(g_rom_clk[6]);
+    HW_CLKCTRL_CLKSEQ_WR(g_rom_clkseq);
+
+}
