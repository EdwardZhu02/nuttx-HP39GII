+
 #ifdef PROBE_ONLY
     /* 探测模式：只起显示服务 + 探测任务，不碰 NAND / FTL / USB */
     xTaskCreate(vDispSvc, "Display Svc", configMINIMAL_STACK_SIZE, NULL,
