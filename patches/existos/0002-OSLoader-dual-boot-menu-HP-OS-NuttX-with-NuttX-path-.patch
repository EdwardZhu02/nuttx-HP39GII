diff --git a/Script/ldr_ld_30000.script b/Script/ldr_ld_30000.script
new file mode 100644
index 0000000..ae927ce
--- /dev/null
+++ b/Script/ldr_ld_30000.script
@@ -0,0 +1,49 @@
+OUTPUT_ARCH(arm)
+
+ENTRY(_init)
+
+SECTIONS
+{
+	. = 0x00030000;
+
+	.init.text : AT(0x00030000)
+	{
+		*(.init)
+	}
+	.init.data :
+	{
+		*(.init.data)
+	}
+
+	.text :	{
+		*(.text)
+	}
+
+	__data_start__ = .;
+
+	.data :
+	{
+		*(.data)
+	}
+
+	__data_end__ = .;
+
+	.rodata :
+	{
+		*(.rodata)
+	}
+
+  .bss  ALIGN(4) :
+  {
+	__bss_start = .;
+   *(.dynbss)
+   *(.bss .bss.* .gnu.linkonce.b.*)
+   *(COMMON)
+   . = ALIGN(32 / 8);
+   __bss_end = .;
+  }
+  . = ALIGN(32 / 8);
+
+	__HEAP_START = .;
+
+}
